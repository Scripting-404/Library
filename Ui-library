		-- Toggle -----------------------------------------------------------------
		function Tab:AddToggle(o)
			o = o or {}
			local state = o.Default or false
			local f = Base(36)
			local btn = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(f, o.Name or "Toggle", 1)
			local sw = F({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(38, 20), Parent = f }, nil, { Corner(10), Stk(0.3, 1) })
			local knob = F({ AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(14, 14), Parent = sw }, nil, { Corner(7) })
			local obj = {}
			local function render(animate)
				local pos = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
				local col = state and theme.Accent or theme.Stroke
				local kcol = state and Contrast(theme.Accent) or Color3.new(1, 1, 1)
				if animate then
					Tween(knob, 0.25, { Position = pos, BackgroundColor3 = kcol }, Enum.EasingStyle.Back)
					Tween(sw, 0.25, { BackgroundColor3 = col })
				else
					knob.Position, knob.BackgroundColor3, sw.BackgroundColor3 = pos, kcol, col
				end
			end
			function obj:Set(v, silent)
				state = v and true or false
				render(true)
				if o.Flag then Window.Flags[o.Flag] = state end
				if not silent then fire(o.Callback, state) end
			end
			function obj:Get() return state end
			render(false)
			table.insert(hooks, function() render(false) end)
			Hover(f, btn)
			btn.MouseButton1Click:Connect(function() obj:Set(not state) end)
			Register(o.Flag, function(v) obj:Set(v) end, function() return state end)
			if state then fire(o.Callback, state) end
			return obj
		end

		-- Slider -------------------------------------------------------------------
		function Tab:AddSlider(o)
			o = o or {}
			local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
			local value = math.clamp(o.Default or min, min, max)
			local f = Base(50)
			L({ Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -90, 0, 16), Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Text = o.Name or "Slider", Parent = f })
			local valLabel = L({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(70, 16), Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = f }, "SubText")
			local bar = F({ Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6), Parent = f }, "Stroke", { Corner(3) })
			local fill = F({ Size = UDim2.fromScale(0, 1), Parent = bar }, "Accent", { Corner(3) })
			local knob = F({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar }, nil, { Corner(6) })
			local hit = Create("TextButton", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", Parent = f })
			local obj = {}
			local function fmt(v) return tostring(math.floor(v * 1000 + 0.5) / 1000) .. (o.Suffix or "") end
			function obj:Set(v, silent)
				v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
				value = v
				local rel = (max == min) and 0 or (v - min) / (max - min)
				Tween(fill, 0.1, { Size = UDim2.fromScale(rel, 1) })
				Tween(knob, 0.1, { Position = UDim2.fromScale(rel, 0.5) })
				valLabel.Text = fmt(v)
				if o.Flag then Window.Flags[o.Flag] = v end
				if not silent then fire(o.Callback, v) end
			end
			function obj:Get() return value end
			local dragging = false
			local function fromX(x)
				local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				obj:Set(min + (max - min) * rel)
			end
			hit.InputBegan:Connect(function(input)
				if IsPointer(input) then
					dragging = true
					Tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
					fromX(input.Position.X)
				end
			end)
			track(UserInputService.InputChanged:Connect(function(input)
				if dragging and IsMove(input) then fromX(input.Position.X) end
			end))
			track(UserInputService.InputEnded:Connect(function(input)
				if dragging and IsPointer(input) then
					dragging = false
					Tween(knob, 0.15, { Size = UDim2.fromOffset(12, 12) })
				end
			end))
			obj:Set(value, true)
			Register(o.Flag, function(v) obj:Set(v) end, function() return value end)
			return obj
		end

		-- Dropdown (single / Multi) -----------------------------------------------
		function Tab:AddDropdown(o)
			o = o or {}
			local options = o.Options or {}
			local multi = o.Multi
			local selected, sel = nil, {}
			if multi then
				if type(o.Default) == "table" then for _, v in ipairs(o.Default) do sel[v] = true end end
			else
				selected = o.Default
			end
			local open = false
			local f = Base(36)
			f.ClipsDescendants = true
			local header = Create("TextButton", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(header, o.Name or "Dropdown", 0.5)
			local valLabel = L({
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -32, 0, 0), Size = UDim2.new(0.5, -20, 1, 0), Font = Enum.Font.Gotham,
				TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header,
			}, "SubText")
			local arrow = Img({ Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -20, 0, 18), Parent = header }, "SubText", "chevron-down")
			local list = Create("ScrollingFrame", {
				Position = UDim2.fromOffset(6, 42), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
				AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = f,
			}, { Create("UIListLayout", { Padding = UDim.new(0, 3) }) })
			local obj = {}

			local function getValue()
				if multi then
					local t = {}
					for _, op in ipairs(options) do if sel[op] then t[#t + 1] = op end end
					return t
				end
				return selected
			end
			local function display()
				if multi then
					local t = {}
					for _, op in ipairs(getValue()) do t[#t + 1] = tostring(op) end
					return #t > 0 and table.concat(t, ", ") or "Select..."
				end
				return selected ~= nil and tostring(selected) or "Select..."
			end
			local function listHeight() return math.min(#options, 5) * 29 end
			local function resize()
				list.Size = UDim2.new(1, -12, 0, listHeight())
				Tween(f, 0.28, { Size = UDim2.new(1, 0, 0, open and (42 + listHeight() + 6) or 36) })
				Tween(arrow, 0.28, { Rotation = open and 180 or 0 })
			end
			local function commit(silent)
				valLabel.Text = display()
				if o.Flag then Window.Flags[o.Flag] = getValue() end
				if not silent then fire(o.Callback, getValue()) end
			end
			local build
			build = function()
				for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
				for _, opt in ipairs(options) do
					local isSel = multi and sel[opt] or (not multi and opt == selected)
					local b = Create("TextButton", {
						Size = UDim2.new(1, -4, 0, 26), BackgroundColor3 = theme.Panel, BackgroundTransparency = 0.3, AutoButtonColor = false,
						Font = isSel and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize = 12,
						TextColor3 = isSel and theme.Accent or theme.SubText, Text = tostring(opt), Parent = list,
					}, { Corner(5) })
					b.MouseEnter:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0 }) end)
					b.MouseLeave:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0.3 }) end)
					b.MouseButton1Click:Connect(function()
						if multi then
							sel[opt] = (not sel[opt]) or nil
							build()
							commit()
						else
							selected = opt
							build()
							commit()
							open = false
							resize()
						end
					end)
				end
			end
			function obj:Set(v, silent)
				if multi then
					sel = {}
					for _, x in ipairs(type(v) == "table" and v or {}) do sel[x] = true end
				else
					selected = v
				end
				build()
				commit(silent)
			end
			function obj:Get() return getValue() end
			function obj:Refresh(newOptions)
				options = newOptions or {}
				build()
				if open then resize() end
			end
			build()
			valLabel.Text = display()
			if o.Flag then Window.Flags[o.Flag] = getValue() end
			Hover(f, header)
			header.MouseButton1Click:Connect(function() open = not open resize() end)
			Register(o.Flag, function(v) obj:Set(v) end, getValue)
			return obj
		end

