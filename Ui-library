	ElementHover = Color3.fromRGB(45, 45, 51),
	Stroke = Color3.fromRGB(62, 62, 68),
	Text = Color3.fromRGB(245, 245, 248),
	SubText = Color3.fromRGB(152, 152, 160),
	Accent = Color3.fromRGB(220, 220, 228),
	Danger = Color3.fromRGB(225, 75, 75),
}

local TypeColors = {
	info = Color3.fromRGB(150, 170, 200),
	success = Color3.fromRGB(110, 190, 140),
	warning = Color3.fromRGB(225, 175, 80),
	error = Color3.fromRGB(225, 80, 80),
}
local TypeIcons = { info = "info", success = "circle-check", warning = "triangle-alert", error = "circle-x" }

local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function Corner(r) return Create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Pad(l, r, t, b)
	return Create("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r), PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b) })
end

local function Tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Contrast(c)
	local l = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return l > 0.55 and Color3.fromRGB(18, 18, 20) or Color3.new(1, 1, 1)
end

local function GetGuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	ok, ui = pcall(function() return game:GetService("CoreGui") end)
	if ok and ui then
		local t = Instance.new("Folder")
		local s = pcall(function() t.Parent = ui end)
		if s and t.Parent then t:Destroy() return ui end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local glyphs = "01{}[]<>/\\=+*#$%&;:|~"
local function randChar()
	local i = math.random(1, #glyphs)
	return glyphs:sub(i, i)
end

