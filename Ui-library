	local function JumpTo(e)
		searchBox.Text = ""
		SelectTab(e.tab)
		if e.group then e.group:Expand() end
		if e.frame then
			task.delay(0.45, function()
				if Window.Destroyed then return end
				local page = e.tab.Page
				local y = Unscale(e.frame.AbsolutePosition.Y - page.AbsolutePosition.Y) + page.CanvasPosition.Y
				Tween(page, 0.3, { CanvasPosition = Vector2.new(0, math.max(0, y - 10)) })
				Flash(e.frame)
			end)
		end
	end

	local function score(e, q)
		local n = e.name:lower()
		if n == q then return 100 end
		if n:sub(1, #q) == q then return 80 end
		if n:find(q, 1, true) then return 60 end
		if e.kw ~= "" and e.kw:find(q, 1, true) then return 40 end
		if e.kind:lower():find(q, 1, true) then return 20 end
		if e.tab and e.tab.Name:lower():find(q, 1, true) then return 10 end
		return 0
	end

	local function RunSearch(text)
		local q = (text or ""):lower():match("^%s*(.-)%s*$")
		searchClear.Visible = (text or "") ~= ""
		if q == "" then ClearSearchUI() return end
		for _, c in ipairs(searchPage:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		if not searching then
			searching = true
			if currentTab then currentTab.Page.Visible = false end
			searchPage.Visible = true
		end
		local results = {}
		for _, e in ipairs(Window.Index) do
			local s = score(e, q)
			if s > 0 then table.insert(results, { e = e, s = s }) end
		end
		table.sort(results, function(a, b) if a.s ~= b.s then return a.s > b.s end return a.e.name < b.e.name end)

		L({ Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Text = #results .. " HASIL", LayoutOrder = 0, Parent = searchPage }, "SubText")
		if #results == 0 then
			L({ Size = UDim2.new(1, 0, 0, 40), Font = Enum.Font.Gotham, TextSize = 12, Text = "Tidak ada fitur yang cocok.", LayoutOrder = 1, Parent = searchPage }, "SubText")
			return
		end
		for i = 1, math.min(#results, 40) do
			local e = results[i].e
			local row = F({ Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 0.3, LayoutOrder = i, Parent = searchPage }, "Element", { Corner(6), Stk(0.5, 1) })
			local hit = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = row })
			L({ Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -90, 0, 16), Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = e.name, Parent = row })
			L({ Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -90, 0, 14), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = (e.kind == "Tab") and "Tab" or ("Tab: " .. e.tab.Name), Parent = row }, "SubText")
			local chip = F({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 18), BackgroundTransparency = 0.2, Parent = row }, "Panel", { Corner(9), Pad(8, 8, 0, 0) })
			L({ AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 18), Font = Enum.Font.GothamMedium, TextSize = 10, Text = e.kind, Parent = chip }, "SubText")
			hit.MouseEnter:Connect(function() Tween(row, 0.15, { BackgroundColor3 = theme.ElementHover }) end)
			hit.MouseLeave:Connect(function() Tween(row, 0.15, { BackgroundColor3 = theme.Element }) end)
			hit.MouseButton1Click:Connect(function() JumpTo(e) end)
		end
	end
