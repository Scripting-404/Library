					ss = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
					vv = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				elseif mode == "hue" then
					hh = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
				end
				update(true)
			end
			sv.InputBegan:Connect(function(input) if IsPointer(input) then mode = "sv" apply(input.Position) end end)
			hue.InputBegan:Connect(function(input) if IsPointer(input) then mode = "hue" apply(input.Position) end end)
			track(UserInputService.InputChanged:Connect(function(input) if mode and IsMove(input) then apply(input.Position) end end))
			track(UserInputService.InputEnded:Connect(function(input) if mode and IsPointer(input) then mode = nil end end))

			update(false)
			Hover(f, header)
			header.MouseButton1Click:Connect(function()
				open = not open
				Tween(f, 0.28, { Size = UDim2.new(1, 0, 0, open and 162 or 36) })
			end)
