--[[
	CyberUI Library
	Tema: dark / abu-abu + animasi latar belakang kode cyber (matrix)
	Fitur:
	  - Minimize (muncul tombol toggle), Close (popup konfirmasi Close / Cancel)
	  - Resize dari pojok kanan bawah, drag dari topbar
	  - Tab + ikon (IconsV2), custom GUI di dalam tab (Tab:AddCustom)
	  - Element: Section, Label, Paragraph, Button, Toggle, Slider, Dropdown, Input, Keybind
	  - Notifikasi, Toggle key, SetAccent, Save/Load Config (Flag)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Library = {}
Library.Windows = {}

--------------------------------------------------------------------
-- Icons
--------------------------------------------------------------------
local IconsV2
do
	local ok, res = pcall(function()
		return loadstring(game:HttpGetAsync("https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"))()
	end)
	if ok and res then
		IconsV2 = res
		pcall(function() IconsV2.SetIconsType("lucide") end)
	end
end

local function SetIcon(label, name)
	if not IconsV2 or not name or name == "" then return end
	local ok, icon = pcall(function() return IconsV2.GetIcon(name) end)
	if not ok or not icon then return end
	if type(icon) == "table" then
		label.Image = icon[1] or icon.Image or ""
		local rect = icon[2] or icon
		if type(rect) == "table" and rect.ImageRectSize then
			label.ImageRectSize = rect.ImageRectSize
			label.ImageRectOffset = rect.ImageRectPosition or rect.ImageRectOffset or Vector2.zero
		end
	else
		label.Image = icon
	end
end

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local BaseTheme = {
	Background = Color3.fromRGB(14, 14, 16),
	Panel = Color3.fromRGB(24, 24, 27),
	Element = Color3.fromRGB(36, 36, 40),
	ElementHover = Color3.fromRGB(48, 48, 54),
	Stroke = Color3.fromRGB(62, 62, 70),
	Text = Color3.fromRGB(235, 235, 240),
	SubText = Color3.fromRGB(150, 150, 160),
	Accent = Color3.fromRGB(0, 230, 140),
	Danger = Color3.fromRGB(230, 70, 70),
}

local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function Corner(r) return Create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Stroke(color, transp, th)
	return Create("UIStroke", { Color = color, Transparency = transp or 0, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function Tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function GetGuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	ok, ui = pcall(function() return game:GetService("CoreGui") end)
	if ok and ui then
		local t = Instance.new("Folder")
		local s = pcall(function() t.Parent = ui end)
		if s and t.Parent then t:Destroy() return ui end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

