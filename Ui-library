	local tilt, squash = math.rad(-16), 0.38
	local lastW, lastH, bhT, flick = 0, 0, 0, 0
	local function StepBlackhole(dt)
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		local cx, cy = w * 0.5, h * 0.52
		local rIn = math.clamp(math.min(w, h) * 0.11, 24, 56)
		local rOut = w * 0.47
		if w ~= lastW or h ~= lastH then
			lastW, lastH = w, h
			local pos = UDim2.fromOffset(cx, cy)
			hole.Position, glow1.Position, glow2.Position = pos, pos, pos
			hole.Size = UDim2.fromOffset(rIn * 2, rIn * 2)
			glow1.Size = UDim2.fromOffset(rIn * 2.6, rIn * 2.6)
			glow2.Size = UDim2.fromOffset(rIn * 3.4, rIn * 3.4)
		end
		bhT += dt
		flick += dt
		local ct, st = math.cos(tilt), math.sin(tilt)
		local rStart = rIn * 1.15
		for _, p in ipairs(parts) do
			local lb = p.label
			if p.halo then
				p.a += 0.5 * dt
				local rh = rIn * 1.22
				lb.Position = UDim2.fromOffset(cx + math.cos(p.a) * rh, cy + math.sin(p.a) * rh)
				lb.TextTransparency = 0.4 + 0.25 * math.sin(p.a * 3 + bhT * 2)
			else
				local r = rStart + p.k * (rOut - rStart)
				p.a += 2.4 * (rIn / r) ^ 1.5 * dt
				p.k -= (0.015 + 0.05 * (1 - p.k)) * dt
				if p.k <= 0 then
					p.k = 0.85 + 0.15 * math.random()
					p.a = math.random() * math.pi * 2
					lb.Text = randChar()
				end
				local x, y = math.cos(p.a) * r, math.sin(p.a) * r * squash
				local rx, ry = x * ct - y * st, x * st + y * ct
				lb.Position = UDim2.fromOffset(cx + rx, cy + ry)
				local front = math.sin(p.a) > 0
				lb.ZIndex = front and 4 or 1
				lb.TextSize = math.floor(9 + (1 - p.k) * 6) + (front and 1 or 0)
				local base = 0.2 + 0.7 * p.k
				local edge = math.min(p.k / 0.08, (1 - p.k) / 0.08, 1)
				lb.TextTransparency = 1 - (1 - base) * edge
			end
		end
		if flick > 0.1 then
			flick = 0
			for _ = 1, 6 do parts[math.random(1, #parts)].label.Text = randChar() end
		end
	end

