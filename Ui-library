				if cb then fire(o.Callback, color) end
			end
			function obj:Set(c, silent)
				if typeof(c) == "string" then c = Color3.fromHex(c) end
				hh, ss, vv = c:ToHSV()
				update(not silent)
			end
			function obj:Get() return color end
