		local dismissed = false
		local function dismiss()
			if dismissed then return end
			dismissed = true
			pcall(function()
				Tween(card, 0.35, { Position = UDim2.new(0, startX, 0, startY), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				task.delay(0.25, function()
					pcall(function() Tween(wrap, 0.3, { Size = UDim2.new(1, 0, 0, 0) }) end)
					task.delay(0.35, function() pcall(function() wrap:Destroy() end) end)
				end)
			end)
		end
