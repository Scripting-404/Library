	local function Attach(target, host, Tab, Group)
		local function Idx(frame, name, kind, keywords)
			if name == nil or tostring(name) == "" then return end
			table.insert(Window.Index, {
				name = tostring(name), kind = kind, tab = Tab, group = Group, frame = frame,
				kw = keywords and tostring(keywords):lower() or "",
			})
		end
		local function Base(height)
			return F({ Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 0.25, Parent = host }, "Element", { Corner(6), Stk(0.5, 1) })
		end
		local function AutoBase(minHeight)
			local f = Base(minHeight)
			f.AutomaticSize = Enum.AutomaticSize.Y
			return f
		end

		function target:GetPage() return host end

		-- Group (collapsible card) ----------------------------------
		if not Group then
			function target:AddGroup(titleText, opts)
				opts = opts or {}
				local G = {}
				local card = F({ Size = UDim2.new(1, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.35, ClipsDescendants = true, Parent = host }, "Panel", { Corner(8), Stk(0.5, 1) })
				local header = Create("TextButton", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Text = "", Parent = card })
				local ix = 12
				if opts.Icon then
					Img({ Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 12, 0.5, -8), Parent = header }, "Accent", opts.Icon)
					ix = 36
				end
				local gTitle = L({ Position = UDim2.fromOffset(ix, 0), Size = UDim2.new(1, -ix - 36, 1, 0), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = titleText or "Group", Parent = header })
				local chev = Img({ Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Parent = header }, "SubText", "chevron-down")
				local body = Create("Frame", {
					Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card,
				}, {
					Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
					Pad(8, 8, 2, 10),
				})
				local layout = body:FindFirstChildOfClass("UIListLayout")
				local expanded = not opts.Collapsed
				if expanded then
					chev.Rotation = 180
				else
					body.Visible = false
					card.AutomaticSize = Enum.AutomaticSize.None
					card.Size = UDim2.new(1, 0, 0, 40)
				end
				local function setState(state)
					if state == expanded then return end
					expanded = state
					Tween(chev, 0.25, { Rotation = expanded and 180 or 0 })
					task.spawn(function()
						if expanded then
							body.Visible = true
							card.AutomaticSize = Enum.AutomaticSize.None
							card.Size = UDim2.new(1, 0, 0, 40)
							RunService.Heartbeat:Wait()
							local h = 40 + Unscale(layout.AbsoluteContentSize.Y) + 12
							Tween(card, 0.3, { Size = UDim2.new(1, 0, 0, h) }).Completed:Wait()
							if expanded then
								card.AutomaticSize = Enum.AutomaticSize.Y
								card.Size = UDim2.new(1, 0, 0, 40)
							end
						else
							local h = Unscale(card.AbsoluteSize.Y)
							card.AutomaticSize = Enum.AutomaticSize.None
							card.Size = UDim2.new(1, 0, 0, h)
							Tween(card, 0.3, { Size = UDim2.new(1, 0, 0, 40) }).Completed:Wait()
							if not expanded then body.Visible = false end
						end
					end)
				end
				function G:Expand() setState(true) end
				function G:Collapse() setState(false) end
				function G:Toggle() setState(not expanded) end
				function G:SetTitle(t) gTitle.Text = t end
				header.MouseButton1Click:Connect(function() setState(not expanded) end)
				Attach(G, body, Tab, G)
				Idx(card, titleText, "Group")
				return G
			end
		end

