		Tab.Indicator = F({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(3, 4), BackgroundTransparency = 1, Parent = Tab.Button }, "Accent", { Corner(2) })
		Tab.Icon = Img({ Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, 12, 0.5, -9), Parent = Tab.Button }, "SubText", icon)
		Tab.Label = L({
			Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -42, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = name, Parent = Tab.Button,
		}, "SubText")
		Tab.Page = Create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = content,
		}, {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
			Pad(10, 12, 10, 26),
		})
		bind(Tab.Page, "ScrollBarImageColor3", "Stroke")
		tabHit.MouseEnter:Connect(function() if not Tab.Active then Tween(Tab.Button, 0.15, { BackgroundTransparency = 0.6 }) end end)
		tabHit.MouseLeave:Connect(function() if not Tab.Active then Tween(Tab.Button, 0.15, { BackgroundTransparency = 1 }) end end)
		tabHit.MouseButton1Click:Connect(function() SelectTab(Tab) end)

		-- helpers ------------------------------------------------------
		local function Base(height)
			return F({ Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 0.25, Parent = Tab.Page }, "Element", { Corner(6), Stk(0.5, 1) })
		end
		local function AutoBase(minHeight)
			local f = Base(minHeight)
			f.AutomaticSize = Enum.AutomaticSize.Y
			return f
		end
		local function Hover(f, btn)
			btn.MouseEnter:Connect(function() Tween(f, 0.15, { BackgroundColor3 = theme.ElementHover }) end)
			btn.MouseLeave:Connect(function() Tween(f, 0.15, { BackgroundColor3 = theme.Element }) end)
		end
		local function NameLabel(parent, text, w)
			return L({
				Position = UDim2.fromOffset(12, 0), Size = UDim2.new(w or 1, -24, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = text or "", Parent = parent,
