-- Icons
--------------------------------------------------------------------
local IconsV2
do
	local ok, res = pcall(function()
		return loadstring(game:HttpGetAsync("https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"))()
	end)
	if ok and res then
		IconsV2 = res
		pcall(function() IconsV2.SetIconsType("lucide") end)
	end
end

local function SetIcon(label, name)
	if not IconsV2 or not name or name == "" then return end
	local ok, icon = pcall(function() return IconsV2.GetIcon(name) end)
	if not ok or not icon then return end
	if type(icon) == "table" then
		label.Image = icon[1] or icon.Image or ""
		local rect = icon[2] or icon
		if type(rect) == "table" and rect.ImageRectSize then
			label.ImageRectSize = rect.ImageRectSize
			label.ImageRectOffset = rect.ImageRectPosition or rect.ImageRectOffset or Vector2.zero
		end
	else
		label.Image = icon
	end
end

