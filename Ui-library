-- Window
--------------------------------------------------------------------
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local theme = table.clone(BaseTheme)
	if cfg.Theme then for k, v in pairs(cfg.Theme) do theme[k] = v end end
	if cfg.Accent then theme.Accent = cfg.Accent end

	local Window = {
		Flags = {}, Setters = {}, Tabs = {}, Index = {}, Minimized = false, Destroyed = false,
		AutoSave = cfg.AutoSave ~= false,
	}
	local conns = {}
	local function track(c) table.insert(conns, c) return c end

	local minSize = cfg.MinSize or Vector2.new(320, 220)
	local maxSize = cfg.MaxSize or Vector2.new(1100, 760)
	local startSize = cfg.Size or Vector2.new(680, 440)
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	local title = cfg.Title or "Scripting404"

	local HEADER_H, PAD = 46, 8
	local SB_WIDE, SB_NARROW = 158, 52

	----------------------------------------------------------------
	-- Theme binding
	----------------------------------------------------------------
	local bound, hooks = {}, {}
	local gui -- forward
	local function bind(inst, prop, key)
		inst[prop] = theme[key]
		table.insert(bound, { inst, prop, key })
		return inst
	end
	local function ApplyTheme()
		for i = #bound, 1, -1 do
			local b = bound[i]
			if gui and not b[1]:IsDescendantOf(gui) then
				table.remove(bound, i)
			else
				pcall(function() b[1][b[2]] = theme[b[3]] end)
			end
		end
		for _, fn in ipairs(hooks) do pcall(fn) end
	end

	local function F(props, key, children)
		props.BorderSizePixel = 0
		local fr = Create("Frame", props, children)
		if key then bind(fr, "BackgroundColor3", key) end
		return fr
	end
	local function L(props, key)
		if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
		local l = Create("TextLabel", props)
		bind(l, "TextColor3", key or "Text")
		return l
	end
	local function Img(props, key, icon)
		props.BackgroundTransparency = 1
		local i = Create("ImageLabel", props)
		if key then bind(i, "ImageColor3", key) end
		if icon then SetIcon(i, icon) end
		return i
	end
	local function Stk(transp, th, key)
		local s = Create("UIStroke", { Transparency = transp or 0, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
		bind(s, "Color", key or "Stroke")
		return s
	end

	----------------------------------------------------------------
	-- Config storage (auto save / auto load)
	----------------------------------------------------------------
	local folder = cfg.ConfigFolder or "Scripting404"
	local canFS = (writefile and readfile and isfile) and true or false
	local function cfgPath(name) return folder .. "/" .. name .. ".json" end
	local saved = {}
	do
		local lastName
		if canFS then
			pcall(function() if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end end)
			pcall(function()
				if isfile(folder .. "/_last.txt") then lastName = readfile(folder .. "/_last.txt"):match("^%s*(.-)%s*$") end
			end)
		end
		Window.ConfigName = cfg.ConfigName or ((lastName and lastName ~= "") and lastName) or "default"
		if canFS and cfg.AutoLoad ~= false then
			pcall(function()
				if isfile(cfgPath(Window.ConfigName)) then
					saved = HttpService:JSONDecode(readfile(cfgPath(Window.ConfigName)))
				end
			end)
		end
	end

	local saveToken = 0
	local function Persist()
		if not (Window.AutoSave and canFS) then return end
		saveToken += 1
		local t = saveToken
		task.delay(cfg.SaveDelay or 1.2, function()
			if t == saveToken and not Window.Destroyed then Window:SaveConfig(Window.ConfigName) end
		end)
	end
	local function setFlag(flag, value)
		if not flag then return end
		Window.Flags[flag] = value
		Persist()
	end
	local function Register(flag, setter, get)
		if not flag then return end
		Window.Setters[flag] = setter
		Window.Flags[flag] = get()
		local v = saved[flag]
		if v ~= nil then pcall(setter, v) end
	end
	local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

	----------------------------------------------------------------
	-- ScreenGui + responsive scaler
	----------------------------------------------------------------
	gui = Create("ScreenGui", {
		Name = "CyberUI_" .. HttpService:GenerateGUID(false):sub(1, 6),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
		DisplayOrder = 999,
	})
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
	gui.Parent = GetGuiParent()
	Window.Gui = gui

	local scaler = Create("Frame", { Name = "Scaler", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local uiScale = Create("UIScale", { Parent = scaler })
	local userScale = cfg.Scale or 1
	local autoScale = cfg.AutoScale ~= false

	local function viewport()
		local a = gui.AbsoluteSize
		if a.X <= 0 or a.Y <= 0 then
			local cam = workspace.CurrentCamera
			return cam and cam.ViewportSize or Vector2.new(1280, 720)
		end
		return a
	end
	local function computeScale()
		local vp = viewport()
		local s = 1
		if autoScale then
			local fit = math.min(vp.X / (startSize.X + 32), vp.Y / (startSize.Y + 32))
			if fit < 1 then s = math.max(fit, 0.5) else s = math.min(1 + (fit - 1) * 0.1, 1.15) end
		end
		return s * userScale
	end
	local function applyScale()
		local s = math.max(computeScale(), 0.3)
		uiScale.Scale = s
		scaler.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	local function localVP() return viewport() / uiScale.Scale end
	applyScale()

	----------------------------------------------------------------
	-- Main window
	----------------------------------------------------------------
	local function allowedMax()
		local vp = localVP()
		return Vector2.new(math.min(maxSize.X, vp.X - 16), math.min(maxSize.Y, vp.Y - 16))
	end
	local function clampSize(w, h)
		local mx = allowedMax()
		local mnx, mny = math.min(minSize.X, mx.X), math.min(minSize.Y, mx.Y)
		return math.clamp(w, mnx, mx.X), math.clamp(h, mny, mx.Y)
	end

	local iw, ih = clampSize(startSize.X, startSize.Y)
	local vp0 = localVP()
	local main = F({
		Name = "Main", Size = UDim2.fromOffset(iw, ih),
		Position = UDim2.fromOffset((vp0.X - iw) / 2, (vp0.Y - ih) / 2),
		ClipsDescendants = true, Parent = scaler,
	}, "Background", { Corner(14), Stk(0.2, 1) })
	local mainScale = Create("UIScale", { Scale = 0, Parent = main })
	Window.Main = main

	local function Unscale(px) return px / (uiScale.Scale * math.max(mainScale.Scale, 0.01)) end

	local function SetAnchor(frame, ax, ay)
		local sz = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
		local old = frame.AnchorPoint
		frame.Position = frame.Position + UDim2.fromOffset((ax - old.X) * sz.X, (ay - old.Y) * sz.Y)
		frame.AnchorPoint = Vector2.new(ax, ay)
	end

	local function FitToScreen()
		if main.AnchorPoint ~= Vector2.new(0, 0) then return end
		local vp = localVP()
		local w, h = clampSize(main.Size.X.Offset, main.Size.Y.Offset)
		main.Size = UDim2.fromOffset(w, h)
		local x = math.clamp(main.Position.X.Offset, 0, math.max(0, vp.X - w))
		local y = math.clamp(main.Position.Y.Offset, 0, math.max(0, vp.Y - h))
		main.Position = UDim2.fromOffset(x, y)
	end

	-- Hard viewport boundary: the window can never remain outside the screen.
	local function ClampWindowToViewport()
		if not main or not main.Parent or main.AnchorPoint ~= Vector2.new(0, 0) then return end
		local vp = localVP()
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		local x = math.clamp(main.Position.X.Offset, 0, math.max(0, vp.X - w))
		local y = math.clamp(main.Position.Y.Offset, 0, math.max(0, vp.Y - h))
		if x ~= main.Position.X.Offset or y ~= main.Position.Y.Offset then
			main.Position = UDim2.fromOffset(x, y)
		end
	end

	----------------------------------------------------------------
	-- Blackhole background
	----------------------------------------------------------------
	local bh = Create("Frame", { Name = "Blackhole", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main })
	local function Circle(z, transp)
		local c = F({ AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = transp, ZIndex = z, Parent = bh }, "Accent")
		Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = c })
		return c
	end
	local glow2 = Circle(2, 0.96)
	local glow1 = Circle(2, 0.92)
	local hole = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 3, Parent = bh,
	}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	bind(Create("UIStroke", { Thickness = 2, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = hole }), "Color", "Accent")

	local parts = {}
	local function Glyph(z)
		local g = Create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1,
			Font = Enum.Font.Code, TextSize = 12, Text = randChar(), ZIndex = z, Parent = bh,
		})
		bind(g, "TextColor3", "Accent")
		return g
	end
	for _ = 1, cfg.BackgroundParticles or 110 do
		table.insert(parts, { label = Glyph(1), a = math.random() * math.pi * 2, k = math.random() ^ 0.8 })
	end
	local haloN = 26
	for i = 1, haloN do
		table.insert(parts, { label = Glyph(4), a = i / haloN * math.pi * 2, halo = true })
	end

	local tilt, squash = math.rad(-16), 0.38
	local lastW, lastH, bhT, flick = 0, 0, 0, 0
	local function StepBlackhole(dt)
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		local cx, cy = w * 0.5, h * 0.52
		local rIn = math.clamp(math.min(w, h) * 0.11, 24, 56)
		local rOut = w * 0.47
		if w ~= lastW or h ~= lastH then
			lastW, lastH = w, h
			local pos = UDim2.fromOffset(cx, cy)
			hole.Position, glow1.Position, glow2.Position = pos, pos, pos
			hole.Size = UDim2.fromOffset(rIn * 2, rIn * 2)
			glow1.Size = UDim2.fromOffset(rIn * 2.6, rIn * 2.6)
			glow2.Size = UDim2.fromOffset(rIn * 3.4, rIn * 3.4)
		end
		bhT += dt
		flick += dt
		local ct, st = math.cos(tilt), math.sin(tilt)
		local rStart = rIn * 1.15
		for _, p in ipairs(parts) do
			local lb = p.label
			if p.halo then
				p.a += 0.5 * dt
				local rh = rIn * 1.22
				lb.Position = UDim2.fromOffset(cx + math.cos(p.a) * rh, cy + math.sin(p.a) * rh)
				lb.TextTransparency = 0.4 + 0.25 * math.sin(p.a * 3 + bhT * 2)
			else
				local r = rStart + p.k * (rOut - rStart)
				p.a += 2.4 * (rIn / r) ^ 1.5 * dt
				p.k -= (0.015 + 0.05 * (1 - p.k)) * dt
				if p.k <= 0 then
					p.k = 0.85 + 0.15 * math.random()
					p.a = math.random() * math.pi * 2
					lb.Text = randChar()
				end
				local x, y = math.cos(p.a) * r, math.sin(p.a) * r * squash
				local rx, ry = x * ct - y * st, x * st + y * ct
				lb.Position = UDim2.fromOffset(cx + rx, cy + ry)
				local front = math.sin(p.a) > 0
				lb.ZIndex = front and 4 or 1
				lb.TextSize = math.floor(9 + (1 - p.k) * 6) + (front and 1 or 0)
				local base = 0.2 + 0.7 * p.k
				local edge = math.min(p.k / 0.08, (1 - p.k) / 0.08, 1)
				lb.TextTransparency = 1 - (1 - base) * edge
			end
		end
		if flick > 0.1 then
			flick = 0
			for _ = 1, 6 do parts[math.random(1, #parts)].label.Text = randChar() end
		end
	end

	----------------------------------------------------------------
	-- Rain (notifikasi)
	----------------------------------------------------------------
	local rains, rainAcc = {}, 0
	local function NewRain(parent, w, h, color)
		local rain = { cols = {}, parent = parent, h = h }
		for i = 1, math.floor(w / 13) do
			local lines = math.random(3, 6)
			local chars = {}
			for j = 1, lines do chars[j] = randChar() end
			local col = { x = (i - 1) * 13 + 3, y = -math.random(0, h), speed = math.random(25, 75), height = lines * 11, chars = chars }
			col.label = Create("TextLabel", {
				BackgroundTransparency = 1, Size = UDim2.fromOffset(12, col.height), Position = UDim2.fromOffset(col.x, col.y),
				Font = Enum.Font.Code, TextSize = 11, TextColor3 = color, TextTransparency = 0.7,
				TextYAlignment = Enum.TextYAlignment.Top, Text = table.concat(chars, "\n"), Parent = parent,
			}, {
				Create("UIGradient", {
					Rotation = 90,
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
				}),
			})
			rain.cols[i] = col
		end
		table.insert(rains, rain)
	end
	local function StepRains(dt)
		rainAcc += dt
		local refresh = rainAcc > 0.14
		if refresh then rainAcc = 0 end
		for i = #rains, 1, -1 do
			local r = rains[i]
			if not r.parent.Parent then
				table.remove(rains, i)
			else
				for _, c in ipairs(r.cols) do
					c.y += c.speed * dt
					if c.y > r.h then c.y = -c.height c.speed = math.random(25, 75) end
					c.label.Position = UDim2.fromOffset(c.x, c.y)
					if refresh and math.random() < 0.35 then
						table.insert(c.chars, 1, randChar())
						table.remove(c.chars)
						c.label.Text = table.concat(c.chars, "\n")
					end
				end
			end
		end
	end

	----------------------------------------------------------------
	-- Drag helper
	----------------------------------------------------------------
	local function MakeDraggable(handle, target, opts)
		opts = opts or {}
		local dragging, dragStart, startPos, moved = false, nil, nil, false
		track(handle.InputBegan:Connect(function(input)
			if IsPointer(input) then
				moved = false
				if opts.Enabled and not opts.Enabled() then return end
				dragging = true
				dragStart, startPos = input.Position, target.Position
				local c
				c = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						c:Disconnect()
					end
				end)
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and IsMove(input) then
				local d = input.Position - dragStart
				if d.Magnitude > 4 then moved = true end
				local s = uiScale.Scale
				local x, y = startPos.X.Offset + d.X / s, startPos.Y.Offset + d.Y / s
				if opts.Clamp then x, y = opts.Clamp(x, y) end
				target.Position = UDim2.new(startPos.X.Scale, x, startPos.Y.Scale, y)
			end
		end))
		return function() return moved end
	end

	----------------------------------------------------------------
	-- Header
	----------------------------------------------------------------
	local topbar = Create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1, Active = true, Parent = main })

	local function IconButton(parent, iconName, props, hoverKey)
		props.BackgroundTransparency = 1
		props.Parent = parent
		local b = F(props, "Element", { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local hit = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = b })
		local ic = Img({ Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = b }, "SubText", iconName)
		hit.MouseEnter:Connect(function()
			Tween(b, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = theme[hoverKey or "ElementHover"] })
			Tween(ic, 0.15, { ImageColor3 = Color3.new(1, 1, 1) })
		end)
		hit.MouseLeave:Connect(function()
			Tween(b, 0.15, { BackgroundTransparency = 1 })
			Tween(ic, 0.15, { ImageColor3 = theme.SubText })
		end)
		return hit, b, ic
	end

	local titleRow = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = topbar }, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8) }),
		Create("UIPadding", { PaddingLeft = UDim.new(0, 10) }),
	})
	local collapseHit = IconButton(titleRow, "panel-left", { Size = UDim2.fromOffset(28, 28) })
	local winIcon = Img({ Size = UDim2.fromOffset(20, 20), Parent = titleRow }, nil, cfg.Icon or "terminal")
	do
		local isAsset = ResolveAsset(cfg.Icon) ~= nil
		if isAsset then winIcon.ImageColor3 = Color3.new(1, 1, 1) else bind(winIcon, "ImageColor3", "Accent") end
	end
	local titleLabel = L({
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), Font = Enum.Font.GothamBold, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Text = title, Parent = titleRow,
	})
