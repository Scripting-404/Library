	local toggleScale = Create("UIScale", { Scale = 0, Parent = toggleBtn })
	local toggleHit = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 20, Parent = toggleBtn })
	local tbJan, tbAnim, tbT, faceScale = {}, nil, 0, nil
	local tbL = { State = {}, Hover = {}, Click = {} }
	local BuildToggleButton

	local function ClampToggle()
		local vp = localVP()
		local hs = toggleBtn.Size.X.Offset / 2
		local p = toggleBtn.Position
		local x = p.X.Scale * vp.X + p.X.Offset
		local y = p.Y.Scale * vp.Y + p.Y.Offset
		toggleBtn.Position = UDim2.fromOffset(math.clamp(x, hs, math.max(hs, vp.X - hs)), math.clamp(y, hs, math.max(hs, vp.Y - hs)))
	end

	local function ClearToggle()
		for _, c in ipairs(tbJan) do pcall(function() c:Disconnect() end) end
		table.clear(tbJan)
		for _, ch in ipairs(toggleBtn:GetChildren()) do
			if ch:GetAttribute("TB") then ch:Destroy() end
		end
		for _, t in pairs(tbL) do table.clear(t) end
		tbAnim, faceScale = nil, nil
	end

	BuildToggleButton = function(opts)
		ClearToggle()
		opts = opts or {}
		tbOpts = opts
		local size = opts.Size or 46
		toggleBtn.Size = UDim2.fromOffset(size, size)
		if opts.Position then toggleBtn.Position = opts.Position end

		local transparent = opts.Transparent == true
		local hasBg = (not transparent) and opts.Background ~= false
		local hasStroke = (not transparent) and opts.Stroke ~= false and (hasBg or opts.Stroke == true)
		local shape = opts.Shape or "Rounded"
		local radius = shape == "Circle" and UDim.new(1, 0) or (shape == "Square" and UDim.new(0, 0) or UDim.new(0, 12))
		local anim = type(opts.Animation) == "string" and opts.Animation:lower() or nil

		local ring, ringStroke
		if anim == "pulse" then
			ring = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = toggleBtn }, {
				Create("UICorner", { CornerRadius = radius }),
			})
			ring:SetAttribute("TB", true)
			ringStroke = Create("UIStroke", { Thickness = 2, Transparency = 1, Parent = ring })
			bind(ringStroke, "Color", "Accent")
		end

		local face = F({
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = hasBg and (opts.BackgroundTransparency or 0) or 1, Parent = toggleBtn,
		}, "Panel", { Create("UICorner", { CornerRadius = radius }) })
		face:SetAttribute("TB", true)
		if opts.BackgroundColor then face.BackgroundColor3 = opts.BackgroundColor end
		faceScale = Create("UIScale", { Parent = face })
		local stroke
		if hasStroke then
			stroke = Stk(0.2, 1.5, "Accent")
			stroke.Parent = face
			if opts.StrokeColor then stroke.Color = opts.StrokeColor end
		end

		local icon
		local iconSpec = opts.Icon
		if iconSpec == nil then iconSpec = opts.Image end
		if iconSpec == nil and not opts.Custom then iconSpec = cfg.Icon or "terminal" end
		local isize = opts.IconSize or math.floor(size * (hasBg and 0.52 or 0.9))
		if iconSpec ~= nil and iconSpec ~= false then
			icon = Create("ImageLabel", {
				BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(isize, isize), ZIndex = 3, Parent = toggleBtn,
			})
			icon:SetAttribute("TB", true)
			local isAsset, okI = SetIcon(icon, iconSpec)
			if opts.IconColor then icon.ImageColor3 = opts.IconColor
			elseif isAsset then icon.ImageColor3 = Color3.new(1, 1, 1)
			else bind(icon, "ImageColor3", "Accent") end
			if not okI then
				local g = Create("TextLabel", {
					BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextScaled = true,
					Text = GlyphFor(iconSpec), Parent = icon,
				})
				bind(g, "TextColor3", "Accent")
			end
		end

		if opts.Custom then
			local holder = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, ClipsDescendants = opts.ClipCustom == true, Parent = toggleBtn })
			holder:SetAttribute("TB", true)
			local api = {
				Theme = theme, Tween = Tween, Window = Window, Button = toggleBtn, Face = face, Icon = icon, Size = size,
				SetIcon = SetIcon, Create = Create,
				OnState = function(fn) table.insert(tbL.State, fn) end,
				OnHover = function(fn) table.insert(tbL.Hover, fn) end,
				OnClick = function(fn) table.insert(tbL.Click, fn) end,
				Track = function(c) table.insert(tbJan, c) return c end,
			}
			task.spawn(function()
				local ok, err = pcall(opts.Custom, holder, api)
				if not ok then warn("[Scripting404] ToggleButton.Custom error: " .. tostring(err)) end
			end)
		end

		if anim == "pulse" then
			tbAnim = function(t)
				local k = (t * 0.8) % 1
				ring.Size = UDim2.fromScale(1 + k * 0.6, 1 + k * 0.6)
				ringStroke.Transparency = k
			end
		elseif anim == "float" then
			tbAnim = function(t)
				local y = math.sin(t * 2) * 3
				face.Position = UDim2.new(0.5, 0, 0.5, y)
				if icon then icon.Position = UDim2.new(0.5, 0, 0.5, y) end
			end
		elseif anim == "spin" then
			tbAnim = function(t) if icon then icon.Rotation = (t * 90) % 360 end end
		elseif anim == "glow" then
			tbAnim = function(t)
				local v = 0.5 + 0.45 * math.sin(t * 3)
				if stroke then stroke.Transparency = v elseif icon then icon.ImageTransparency = v * 0.6 end
			end
		elseif anim == "breathe" then
			tbAnim = function(t)
				if icon then
					local k = 1 + 0.1 * math.sin(t * 2.5)
					icon.Size = UDim2.fromOffset(isize * k, isize * k)
				end
			end
		end

		ClampToggle()
		if opts.AlwaysVisible then
			toggleBtn.Visible = true
			Tween(toggleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			toggleBtn.Visible = Window.Minimized
			if Window.Minimized then toggleScale.Scale = 1 end
		end
	end

