	-- Tabs & elements
	----------------------------------------------------------------
	function Window:CreateTab(name, icon)
		local Tab = { Name = name, Active = false }
		tabOrder += 1
		Tab.Button = F({ Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = tabOrder, Parent = tabList }, "Element", { Corner(6) })
