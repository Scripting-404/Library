				local c = F({ AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22), BackgroundTransparency = 0.1, LayoutOrder = order, Parent = f }, "Panel", { Corner(11), Pad(10, 10, 0, 0) })
				local st = Stk(0.3, 1)
