			track(UserInputService.InputBegan:Connect(function(input, gpe)
				if listening then
					if input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						obj:Set(input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode)
						Tween(kb, 0.15, { TextColor3 = theme.Text })
					end
				elseif not gpe and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
					fire(o.Callback, key)
				end
			end))
			Register(o.Flag, function(v) obj:Set(v) end, function() return key.Name end)
			return obj
		end

		-- ColorPicker --------------------------------------------------------------------------
		function Tab:AddColorPicker(o)
			o = o or {}
			local color = o.Default or Color3.new(1, 1, 1)
			local hh, ss, vv = color:ToHSV()
			local open = false
			local f = Base(36)
			f.ClipsDescendants = true
			local header = Create("TextButton", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(header, o.Name or "Color", 0.6)
			local swatch = Create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(34, 18),
				BackgroundColor3 = color, BorderSizePixel = 0, Parent = header,
			}, { Corner(5), Create("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.7, Thickness = 1 }) })
			local pick = Create("Frame", { Position = UDim2.fromOffset(10, 44), Size = UDim2.new(1, -20, 0, 110), BackgroundTransparency = 1, Parent = f })
			local sv = Create("Frame", { Size = UDim2.new(1, -26, 1, 0), BackgroundColor3 = Color3.fromHSV(hh, 1, 1), BorderSizePixel = 0, ClipsDescendants = true, Parent = pick }, { Corner(5) })
			Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sv }, {
				Create("UIGradient", { Transparency = NumberSequence.new(0, 1) }),
			})
			Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sv }, {
				Create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }),
			})
			local cursor = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 3, Parent = sv,
			}, { Corner(5), Create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }) })
			local hueKeys = {}
			for i = 0, 6 do hueKeys[#hueKeys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 1), 1, 1)) end
			local hue = Create("Frame", {
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 16, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = pick,
			}, { Corner(5), Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(hueKeys) }) })
			local hueCursor = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3, Parent = hue,
			}, { Corner(2), Create("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.4, Thickness = 1 }) })

			local obj = {}
			local function update(cb)
				color = Color3.fromHSV(hh, ss, vv)
				swatch.BackgroundColor3 = color
				sv.BackgroundColor3 = Color3.fromHSV(hh, 1, 1)
				cursor.Position = UDim2.fromScale(ss, 1 - vv)
				hueCursor.Position = UDim2.new(0.5, 0, hh, 0)
				if o.Flag then Window.Flags[o.Flag] = color:ToHex() end
				if cb then fire(o.Callback, color) end
			end
			function obj:Set(c, silent)
				if typeof(c) == "string" then c = Color3.fromHex(c) end
				hh, ss, vv = c:ToHSV()
				update(not silent)
			end
			function obj:Get() return color end

			local mode
			local function apply(pos)
				if mode == "sv" then
					ss = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
					vv = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				elseif mode == "hue" then
					hh = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
				end
				update(true)
			end
			sv.InputBegan:Connect(function(input) if IsPointer(input) then mode = "sv" apply(input.Position) end end)
			hue.InputBegan:Connect(function(input) if IsPointer(input) then mode = "hue" apply(input.Position) end end)
			track(UserInputService.InputChanged:Connect(function(input) if mode and IsMove(input) then apply(input.Position) end end))
			track(UserInputService.InputEnded:Connect(function(input) if mode and IsPointer(input) then mode = nil end end))

			update(false)
			Hover(f, header)
			header.MouseButton1Click:Connect(function()
				open = not open
				Tween(f, 0.28, { Size = UDim2.new(1, 0, 0, open and 162 or 36) })
			end)
			Register(o.Flag, function(v) obj:Set(v) end, function() return color:ToHex() end)
			return obj
		end

		-- Custom GUI --------------------------------------------------------------------------------
		function Tab:AddCustom(height, builder)
			local f = Base(height or 100)
			f.ClipsDescendants = true
			if builder then task.spawn(builder, f, theme) end
			return f
		end

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then SelectTab(Tab) end
		return Tab
	end

	----------------------------------------------------------------
	-- Notifications (di atas, bertumpuk ke bawah, hujan kode)
	----------------------------------------------------------------
	local NOTIF_W = 310
	local notifHolder = Create("Frame", {
		Name = "Notifications", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(NOTIF_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 50, Parent = gui,
	}, { Create("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }) })

	local notifOrder = 0
	function Window:Notify(o)
		o = o or {}
		local dur = o.Duration or 4
		local kind = o.Type
		local col = TypeColors[kind] or theme.Accent
		local icon = o.Icon or TypeIcons[kind]
		local textX = icon and 44 or 14
		local bodyH = 0
		if o.Content and o.Content ~= "" then
			local ok, sz = pcall(function() return TextService:GetTextSize(o.Content, 12, Enum.Font.Gotham, Vector2.new(NOTIF_W - textX - 14, 1000)) end)
			bodyH = ok and sz.Y or 14
		end
		local H = math.max(58, 12 + 18 + 4 + bodyH + 14)

		notifOrder += 1
		local wrap = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, LayoutOrder = notifOrder, Parent = notifHolder })
		local card = Create("CanvasGroup", {
			Size = UDim2.new(1, 0, 0, H), Position = UDim2.new(0, 0, 0, -H - 20), GroupTransparency = 1,
			BackgroundColor3 = theme.Panel, BorderSizePixel = 0, Parent = wrap,
		}, { Corner(10), Create("UIStroke", { Color = theme.Stroke, Transparency = 0.2, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })

		NewRain(card, NOTIF_W, H, col)

		if icon then
			local ic = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(14, 12), ImageColor3 = col, Parent = card })
			SetIcon(ic, icon)
		end
		Create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(textX, 10), Size = UDim2.new(1, -textX - 14, 0, 18), Font = Enum.Font.GothamBold,
			TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Text = o.Title or "Notification", Parent = card,
		})
		Create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(textX, 30), Size = UDim2.new(1, -textX - 14, 0, bodyH), Font = Enum.Font.Gotham,
			TextSize = 12, TextColor3 = theme.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, Text = o.Content or "", Parent = card,
		})
		local bar = Create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, BackgroundColor3 = col, Parent = card })
		local hit = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = card })

		local dismissed = false
		local function dismiss()
			if dismissed then return end
			dismissed = true
			pcall(function()
				Tween(card, 0.35, { Position = UDim2.new(0, 0, 0, -H - 20), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				task.delay(0.25, function()
					pcall(function() Tween(wrap, 0.3, { Size = UDim2.new(1, 0, 0, 0) }) end)
					task.delay(0.35, function() pcall(function() wrap:Destroy() end) end)
				end)
			end)
		end
		hit.MouseButton1Click:Connect(dismiss)

		Tween(wrap, 0.35, { Size = UDim2.new(1, 0, 0, H + 8) })
		Tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)
		Tween(bar, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
		task.delay(dur, dismiss)
		return { Dismiss = dismiss }
	end

	----------------------------------------------------------------
	-- Resize handle (pojok kanan bawah)
	----------------------------------------------------------------
	local handle = Create("TextButton", {
		Name = "ResizeHandle", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1, Text = "", Parent = main,
	})
	local handleIcon = Img({ Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4), ImageTransparency = 0.3, Parent = handle }, "SubText", "move-diagonal-2")
	handle.MouseEnter:Connect(function() Tween(handleIcon, 0.15, { ImageColor3 = theme.Accent, ImageTransparency = 0 }) end)
	handle.MouseLeave:Connect(function() Tween(handleIcon, 0.15, { ImageColor3 = theme.SubText, ImageTransparency = 0.3 }) end)

	local resizing, rStart, rSize = false, nil, nil
	track(handle.InputBegan:Connect(function(input)
		if IsPointer(input) then
			resizing, rStart = true, input.Position
			rSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					c:Disconnect()
				end
			end)
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if resizing and IsMove(input) then
			local d = input.Position - rStart
			local w = math.clamp(rSize.X + d.X / math.max(mainScale.Scale, 0.01), minSize.X, maxSize.X)
			local h = math.clamp(rSize.Y + d.Y / math.max(mainScale.Scale, 0.01), minSize.Y, maxSize.Y)
			main.Size = UDim2.fromOffset(w, h)
		end
	end))

	----------------------------------------------------------------
	-- Show / hide / minimize / restore
	----------------------------------------------------------------
	local animating = false
	local function PopIn()
		animating = true
		main.Visible = true
		SetAnchor(main, 0.5, 0.5)
		mainScale.Scale = 0
		Tween(mainScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back).Completed:Once(function()
			SetAnchor(main, 0, 0)
			animating = false
		end)
	end
	local function PopOut(cb)
		animating = true
		SetAnchor(main, 0.5, 0.5)
		Tween(mainScale, 0.28, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			main.Visible = false
			animating = false
			if cb then cb() end
		end)
	end

	local toggleBtn = F({
		Name = "ToggleButton", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 90), Size = UDim2.fromOffset(46, 46),
		Visible = false, Parent = gui,
	}, "Panel", { Corner(12), Stk(0.2, 1.5, "Accent") })
	local toggleScale = Create("UIScale", { Scale = 0, Parent = toggleBtn })
	Img({ Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = toggleBtn }, "Accent", cfg.Icon or "terminal")
	local toggleHit = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = toggleBtn })
	local toggleMoved = MakeDraggable(toggleHit, toggleBtn)
	toggleHit.MouseEnter:Connect(function() Tween(toggleBtn, 0.15, { BackgroundColor3 = theme.ElementHover }) end)
	toggleHit.MouseLeave:Connect(function() Tween(toggleBtn, 0.15, { BackgroundColor3 = theme.Panel }) end)

	function Window:Minimize()
		if animating or Window.Minimized or Window.Destroyed then return end
		Window.Minimized = true
		PopOut(function()
			toggleBtn.Visible = true
			toggleScale.Scale = 0
			Tween(toggleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	function Window:Restore()
		if animating or not Window.Minimized or Window.Destroyed then return end
		Window.Minimized = false
		Tween(toggleScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			toggleBtn.Visible = false
		end)
		PopIn()
	end
	function Window:Toggle()
		if Window.Minimized then Window:Restore() else Window:Minimize() end
	end
	toggleHit.Activated:Connect(function()
		if not toggleMoved() then Window:Restore() end
	end)
	minBtn.MouseButton1Click:Connect(function() Window:Minimize() end)
	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if not gpe and input.KeyCode == toggleKey then Window:Toggle() end
	end))

	----------------------------------------------------------------
	-- Dialog (dipakai konfirmasi close, bisa dipanggil sendiri)
	----------------------------------------------------------------
	local overlay = Create("TextButton", {
		Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, Visible = false, Active = true, Parent = main,
	})
	local dialog = F({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(290, 150), Parent = overlay,
	}, "Panel", { Corner(10), Stk(0.1, 1) })
	local dialogScale = Create("UIScale", { Scale = 0.8, Parent = dialog })

	local dialogToken = 0
	local function HideDialog()
		dialogToken += 1
		local token = dialogToken
		Tween(dialogScale, 0.2, { Scale = 0.85 })
		Tween(overlay, 0.2, { BackgroundTransparency = 1 }).Completed:Once(function()
			if token == dialogToken then overlay.Visible = false end
		end)
	end

	function Window:Dialog(o)
		o = o or {}
		dialogToken += 1
		for _, c in ipairs(dialog:GetChildren()) do
			if c:GetAttribute("Dyn") then c:Destroy() end
		end
		local textH = 0
		if o.Content and o.Content ~= "" then
			local ok, sz = pcall(function() return TextService:GetTextSize(o.Content, 12, Enum.Font.Gotham, Vector2.new(258, 1000)) end)
			textH = ok and sz.Y or 28
		end
		dialog.Size = UDim2.fromOffset(290, 108 + textH)

		local function dyn(inst) inst:SetAttribute("Dyn", true) return inst end
		dyn(Img({ Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(16, 14), ImageColor3 = o.IconColor or theme.Accent, Parent = dialog }, nil, o.Icon or "info"))
		dyn(L({ Position = UDim2.fromOffset(46, 14), Size = UDim2.new(1, -60, 0, 22), Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Text = o.Title or "Dialog", Parent = dialog }))
		dyn(L({
			Position = UDim2.fromOffset(16, 44), Size = UDim2.new(1, -32, 0, textH), Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = o.Content or "", Parent = dialog,
		}, "SubText"))

		local buttons = o.Buttons or { { Text = "OK" } }
		local n = #buttons
		local row = dyn(Create("Frame", { Position = UDim2.new(0, 16, 1, -48), Size = UDim2.new(1, -32, 0, 32), BackgroundTransparency = 1, Parent = dialog }, {
			Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
		}))
		for _, bd in ipairs(buttons) do
			local danger = bd.Style == "danger"
			local b = Create("TextButton", {
				Size = UDim2.new(1 / n, -8 * (n - 1) / n, 1, 0), BackgroundColor3 = danger and theme.Danger or theme.Element, AutoButtonColor = false,
				Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = danger and Color3.new(1, 1, 1) or theme.Text, Text = bd.Text or "OK", Parent = row,
			}, { Corner(6) })
			b.MouseEnter:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0.2 }) end)
			b.MouseLeave:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0 }) end)
			b.MouseButton1Click:Connect(function()
				HideDialog()
				if bd.Callback then task.spawn(bd.Callback) end
			end)
		end

		overlay.Visible = true
		dialogScale.Scale = 0.8
		Tween(overlay, 0.25, { BackgroundTransparency = 0.45 })
		Tween(dialogScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	function Window:Destroy()
		if Window.Destroyed then return end
		Window.Destroyed = true
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		gui:Destroy()
		if cfg.OnClose then task.spawn(cfg.OnClose) end
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Dialog({
			Title = "Close UI?",
			Content = "Apakah kamu yakin ingin menghapus UI ini? Semua tab dan pengaturan akan hilang.",
			Icon = "triangle-alert", IconColor = theme.Danger,
			Buttons = {
				{ Text = "Close", Style = "danger", Callback = function()
					toggleBtn.Visible = false
					PopOut(function() Window:Destroy() end)
				end },
				{ Text = "Cancel" },
			},
		})
	end)

	----------------------------------------------------------------
	-- Settings API
	----------------------------------------------------------------
	function Window:SetTitle(t) titleLabel.Text = t end
	function Window:SetToggleKey(k) toggleKey = k end
	function Window:SetTheme(t)
		for k, v in pairs(t or {}) do theme[k] = v end
		ApplyTheme()
	end
	function Window:SetAccent(color) Window:SetTheme({ Accent = color }) end
	function Window:SetBackground(on) bh.Visible = on and true or false end

	local folder = cfg.ConfigFolder or "CyberUI"
	function Window:SaveConfig(name)
		if not writefile then return false end
		pcall(function() if makefolder and not isfolder(folder) then makefolder(folder) end end)
		local data = {}
		for k, v in pairs(Window.Flags) do
			local t = typeof(v)
			if t == "string" or t == "number" or t == "boolean" or t == "table" then data[k] = v end
		end
		return pcall(function() writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(data)) end)
	end
	function Window:LoadConfig(name)
		if not (readfile and isfile) then return false end
		local path = folder .. "/" .. name .. ".json"
		if not isfile(path) then return false end
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
		if not ok then return false end
		for k, v in pairs(data) do
			if Window.Setters[k] then pcall(Window.Setters[k], v) end
		end
		return true
	end

	table.insert(Library.Windows, Window)
	PopIn()
	return Window
end

return Library
