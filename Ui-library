			}, { Corner(5) })
			bind(hexBox, "BackgroundColor3", "Panel")
			bind(hexBox, "TextColor3", "Text")
			bind(hexBox, "PlaceholderColor3", "SubText")

			local obj = {}
			local function update(cb)
				color = Color3.fromHSV(hh, ss, vv)
				swatch.BackgroundColor3 = color
				sv.BackgroundColor3 = Color3.fromHSV(hh, 1, 1)
				cursor.Position = UDim2.fromScale(ss, 1 - vv)
				hueCursor.Position = UDim2.new(0.5, 0, hh, 0)
				hexBox.Text = "#" .. color:ToHex():upper()
