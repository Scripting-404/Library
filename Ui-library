local function Copy(t)
	local n = {}
	for k, v in pairs(t) do n[k] = v end
	return n
end

local function HttpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	ok, res = pcall(function() return game:HttpGetAsync(url) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then return res.Body end
	end
	return nil
end

local Secure = { Enabled = false, Triggered = false }
Library.Secure = Secure

do
	local trustDepth = 0
	local probes = {}
	local watching = false

	local function cfgValue(key, default)
		local v = genv[key]
		if v == nil then return default end
		return v
	end

	local function safe(fn, ...)
		local ok, a = pcall(fn, ...)
		if ok then return a end
		return nil
	end

	local function describe(fn)
		local info = { ref = fn }
		if type(fn) ~= "function" then return info end
		if islclosure then info.lua = safe(islclosure, fn) end
		if isfunctionhooked then info.hooked = safe(isfunctionhooked, fn) end
		if is_function_hooked then info.hooked = info.hooked or safe(is_function_hooked, fn) end
		if debug and debug.info then info.src = safe(debug.info, fn, "s") end
		return info
	end

	local function resolve(path)
		local cur = genv
		for part in string.gmatch(path, "[^%.]+") do
			if type(cur) ~= "table" then return nil end
			cur = cur[part]
		end
		return cur
	end

	local function getMeta(name)
		if not getrawmetatable then return nil end
		local mt = safe(getrawmetatable, game)
		if type(mt) ~= "table" then return nil end
		local ro = safe(function() return isreadonly and isreadonly(mt) end)
		if ro and setreadonly then pcall(setreadonly, mt, false) end
		local v = rawget(mt, name)
		if ro and setreadonly then pcall(setreadonly, mt, true) end
		return v
	end

	local targets = {
		{ "loadstring", function() return resolve("loadstring") end },
		{ "request", function() return resolve("request") end },
		{ "http_request", function() return resolve("http_request") end },
		{ "syn.request", function() return resolve("syn.request") end },
		{ "http.request", function() return resolve("http.request") end },
		{ "setclipboard", function() return resolve("setclipboard") end },
		{ "toclipboard", function() return resolve("toclipboard") end },
		{ "writefile", function() return resolve("writefile") end },
		{ "appendfile", function() return resolve("appendfile") end },
		{ "decompile", function() return resolve("decompile") end },
		{ "getscriptbytecode", function() return resolve("getscriptbytecode") end },
		{ "getscriptclosure", function() return resolve("getscriptclosure") end },
		{ "getrawmetatable", function() return resolve("getrawmetatable") end },
		{ "hookfunction", function() return resolve("hookfunction") end },
		{ "hookmetamethod", function() return resolve("hookmetamethod") end },
		{ "replaceclosure", function() return resolve("replaceclosure") end },
		{ "newcclosure", function() return resolve("newcclosure") end },
		{ "debug.info", function() return debug and debug.info end },
		{ "HttpGet", function()
			return safe(function() return game.HttpGet end)
		end, true },
	}

	local strictTargets = {
		{ "__namecall", function() return getMeta("__namecall") end },
		{ "__index", function() return getMeta("__index") end },
		{ "__newindex", function() return getMeta("__newindex") end },
	}

	local function capture()
		table.clear(probes)
		local list = {}
		for _, t in ipairs(targets) do table.insert(list, t) end
		if cfgValue("SECURED_STRICT", false) then
			for _, t in ipairs(strictTargets) do table.insert(list, t) end
		end
		for _, t in ipairs(list) do
			local a = t[2]()
			if type(a) == "function" then
				local first = describe(a)
				local b = t[2]()
				local stable = (b == a) and not t[3]
				probes[t[1]] = { get = t[2], base = first, stable = stable }
			end
		end
	end

	local function check()
		for name, p in pairs(probes) do
			local cur = p.get()
			if type(cur) == "function" then
				local d = describe(cur)
				if p.stable and cur ~= p.base.ref then return name end
				if d.hooked == true and p.base.hooked ~= true then return name end
				if d.lua == true and p.base.lua == false then return name end
				if p.base.src ~= nil and d.src ~= nil and d.src ~= p.base.src then return name end
			elseif p.stable then
				return name
			end
		end
		return nil
	end

	local function serverHop()
		local TeleportService = Service("TeleportService")
		local lp = Players.LocalPlayer
		local placeId, jobId = game.PlaceId, game.JobId
		local target
		pcall(function()
			local raw = HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
			local data = raw and HttpService:JSONDecode(raw)
			if data and data.data then
				local pool = {}
				for _, s in ipairs(data.data) do
					if s.id ~= jobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
						table.insert(pool, s.id)
					end
				end
				if #pool > 0 then target = pool[math.random(1, #pool)] end
			end
		end)
		pcall(function()
			if target then
				TeleportService:TeleportToPlaceInstance(placeId, target, lp)
			else
				TeleportService:Teleport(placeId, lp)
			end
		end)
	end

	local function punish(reason)
		if Secure.Triggered then return end
		Secure.Triggered = true
		local action = tostring(cfgValue("SECURED_ACTION", "Kick")):lower()
		local message = tostring(cfgValue("SECURED_MESSAGE", "Security violation detected: unauthorized hook."))
		pcall(function() Library:DestroyAll() end)
		if type(Secure.OnViolation) == "function" then pcall(Secure.OnViolation, reason) end
		local lp = Players.LocalPlayer
		if action == "serverhop" or action == "both" then
			task.spawn(serverHop)
		end
		if action == "kick" or action == "both" then
			pcall(function() lp:Kick(message) end)
		elseif action == "serverhop" then
			task.delay(8, function() pcall(function() lp:Kick(message) end) end)
		end
	end

	function Secure:Rebaseline()
		if not Secure.Enabled then return end
		capture()
	end

	function Secure:Trust(fn, ...)
		if type(fn) ~= "function" then return end
		trustDepth += 1
		local results = table.pack(pcall(fn, ...))
		trustDepth -= 1
		if trustDepth == 0 then Secure:Rebaseline() end
		if results[1] then return table.unpack(results, 2, results.n) end
		warn("[Scripting404] Trusted scope error: " .. tostring(results[2]))
	end

	function Secure:IsEnabled()
		return Secure.Enabled
	end

	function Secure:Start()
		if watching then return end
		if not cfgValue("SECURED_MODE", false) then return end
		Secure.Enabled = true
		watching = true
		capture()
		local acc = 0
		RunService.Heartbeat:Connect(function(dt)
			if Secure.Triggered or trustDepth > 0 then return end
			acc += dt
			if acc < 0.5 then return end
			acc = 0
			local bad = check()
			if bad then punish(bad) end
		end)
	end

	Secure:Start()
end

