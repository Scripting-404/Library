	toggleHit.MouseLeave:Connect(function()
		if faceScale then Tween(faceScale, 0.15, { Scale = 1 }) end
		for _, f in ipairs(tbL.Hover) do task.spawn(f, false) end
	end)
	toggleHit.InputBegan:Connect(function(input)
		if IsPointer(input) and faceScale then Tween(faceScale, 0.1, { Scale = 0.94 }) end
	end)
	toggleHit.InputEnded:Connect(function(input)
		if IsPointer(input) and faceScale then Tween(faceScale, 0.15, { Scale = 1 }) end
	end)
	toggleHit.Activated:Connect(function()
		if toggleMoved() then return end
		for _, f in ipairs(tbL.Click) do task.spawn(f) end
		if tbOpts.AlwaysVisible then Window:Toggle() else Window:Restore() end
	end)

	local function fireState(minimized)
		for _, f in ipairs(tbL.State) do task.spawn(f, minimized) end
	end

	function Window:Minimize()
		if animating or Window.Minimized or Window.Destroyed then return end
		Window.Minimized = true
		fireState(true)
		PopOut(function()
			if not tbOpts.AlwaysVisible then
				ClampToggle()
				toggleBtn.Visible = true
				toggleScale.Scale = 0
				Tween(toggleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
	function Window:Restore()
		if animating or not Window.Minimized or Window.Destroyed then return end
		Window.Minimized = false
		fireState(false)
		if not tbOpts.AlwaysVisible then
			Done(Tween(toggleScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In), function()
				toggleBtn.Visible = false
			end)
		end
		PopIn()
	end
	function Window:Toggle()
		if Window.Minimized then Window:Restore() else Window:Minimize() end
	end
	function Window:SetToggleButton(opts) BuildToggleButton(opts) end

	minBtn.MouseButton1Click:Connect(function() Window:Minimize() end)
	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if not gpe and input.KeyCode == toggleKey then Window:Toggle() end
	end))

	local overlay = Create("TextButton", {
		Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, Visible = false, Active = true, ZIndex = 30, Parent = main,
	})
	local dialog = F({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(290, 150), ZIndex = 31, Parent = overlay,
	}, "Panel", { Corner(12), Stk(0.1, 1) })
	local dialogScale = Create("UIScale", { Scale = 0.8, Parent = dialog })

	local dialogToken = 0
	local function HideDialog()
		dialogToken += 1
		local token = dialogToken
		Tween(dialogScale, 0.2, { Scale = 0.85 })
		Done(Tween(overlay, 0.2, { BackgroundTransparency = 1 }), function()
			if token == dialogToken then overlay.Visible = false end
		end)
	end

	function Window:Dialog(o)
		o = o or {}
		dialogToken += 1
		for _, c in ipairs(dialog:GetChildren()) do
			if c:GetAttribute("Dyn") then c:Destroy() end
		end
		local dw = math.min(290, math.max(200, main.Size.X.Offset - 24))
		local textH = 0
		if o.Content and o.Content ~= "" then
			local ok, sz = pcall(function() return TextService:GetTextSize(o.Content, 12, Enum.Font.Gotham, Vector2.new(dw - 32, 1000)) end)
			textH = ok and sz.Y or 28
		end
		dialog.Size = UDim2.fromOffset(dw, 108 + textH)

		local function dyn(inst) inst:SetAttribute("Dyn", true) return inst end
		local dIcon = dyn(Img({ Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(16, 14), ZIndex = 32, Parent = dialog }, nil, nil))
		local isAsset, okI = SetIcon(dIcon, o.Icon or "info")
		dIcon.ImageColor3 = o.IconColor or (isAsset and Color3.new(1, 1, 1) or theme.Accent)
		if not okI then
			Create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextScaled = true, Text = "!", TextColor3 = dIcon.ImageColor3, Parent = dIcon })
		end
		dyn(L({ Position = UDim2.fromOffset(46, 14), Size = UDim2.new(1, -60, 0, 22), Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Text = o.Title or "Dialog", ZIndex = 32, Parent = dialog }))
		dyn(L({
			Position = UDim2.fromOffset(16, 44), Size = UDim2.new(1, -32, 0, textH), Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = o.Content or "", ZIndex = 32, Parent = dialog,
		}, "SubText"))

		local buttons = o.Buttons or { { Text = "OK" } }
		local n = #buttons
		local row = dyn(Create("Frame", { Position = UDim2.new(0, 16, 1, -48), Size = UDim2.new(1, -32, 0, 32), BackgroundTransparency = 1, ZIndex = 32, Parent = dialog }, {
			Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
		}))
		for _, bd in ipairs(buttons) do
			local danger = bd.Style == "danger"
			local b = Create("TextButton", {
				Size = UDim2.new(1 / n, -8 * (n - 1) / n, 1, 0), BackgroundColor3 = danger and theme.Danger or theme.Element, AutoButtonColor = false,
				Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = danger and Color3.new(1, 1, 1) or theme.Text, Text = bd.Text or "OK", ZIndex = 33, Parent = row,
			}, { Corner(8) })
			b.MouseEnter:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0.2 }) end)
			b.MouseLeave:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0 }) end)
			b.MouseButton1Click:Connect(function()
				HideDialog()
				if bd.Callback then task.spawn(bd.Callback) end
			end)
		end

		overlay.Visible = true
		dialogScale.Scale = 0.8
		Tween(overlay, 0.25, { BackgroundTransparency = 0.45 })
		Tween(dialogScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	function Window:Destroy()
		if Window.Destroyed then return end
		if Window.AutoSave and canFS then pcall(function() Window:SaveConfig(Window.ConfigName) end) end
		Window.Destroyed = true
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		ClearToggle()
		pcall(function() gui:Destroy() end)
		if genv.__Scripting404_Window == Window then genv.__Scripting404_Window = nil end
		if cfg.OnClose then task.spawn(cfg.OnClose) end
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Dialog({
			Title = "Close UI?",
			Content = "Are you sure you want to close this UI? All tabs and settings will be lost.",
			Icon = "triangle-alert", IconColor = theme.Danger,
			Buttons = {
				{ Text = "Close", Style = "danger", Callback = function()
					toggleBtn.Visible = false
					PopOut(function() Window:Destroy() end)
				end },
				{ Text = "Cancel" },
			},
		})
	end)

	function Window:SetTitle(t) titleLabel.Text = t end
	function Window:SetToggleKey(k) toggleKey = k end
	function Window:SetTheme(t)
		for k, v in pairs(t or {}) do theme[k] = v end
		ApplyTheme()
	end
	function Window:SetThemePreset(name)
		local p = Presets[name]
		if not p then return false end
		Window:SetTheme(p)
		local setter = Window.Setters["ui_accent"]
		if setter then pcall(setter, theme.Accent:ToHex()) end
		return true
	end
	function Window:SetAccent(color) Window:SetTheme({ Accent = color }) end
	function Window:SetBackground(on) bh.Visible = on and true or false end
	function Window:SetScale(mult)
		userScale = math.clamp(mult or 1, 0.4, 2)
		applyScale()
		FitToScreen()
		ClampToggle()
	end
	function Window:SetAutoScale(on)
		autoScale = on and true or false
		applyScale()
		FitToScreen()
		ClampToggle()
	end
	function Window:SetSidebar(mode)
		if mode == "Collapsed" then sbManual = true elseif mode == "Expanded" then sbManual = false else sbManual = nil end
		Layout(true)
	end
	function Window:SetAutoSave(on) Window.AutoSave = on and true or false end
	function Window:SetNotifyPosition(pos) applyNotifyPos(pos) end

	local function Snapshot()
		local data = {}
		for k, v in pairs(saved) do data[k] = v end
		for k, v in pairs(Window.Flags) do
			local t = typeof(v)
			if t == "string" or t == "number" or t == "boolean" or t == "table" then data[k] = v end
		end
		return data
	end
	local function ApplySaved(data)
		if Window.Setters["ui_theme"] and data["ui_theme"] ~= nil then pcall(Window.Setters["ui_theme"], data["ui_theme"]) end
		for k, v in pairs(data) do
			if k ~= "ui_theme" and Window.Setters[k] then pcall(Window.Setters[k], v) end
		end
	end

	function Window:SaveConfig(name)
		if not canFS then return false end
		name = (name and name ~= "") and name or Window.ConfigName
		pcall(function() if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end end)
		local data = Snapshot()
		local ok = pcall(function() writefile(cfgPath(name), HttpService:JSONEncode(data)) end)
		if ok then
			saved = data
			Window.ConfigName = name
			pcall(function() writefile(folder .. "/_last.txt", name) end)
		end
		return ok
	end
	function Window:LoadConfig(name)
		if not (canFS and name and name ~= "") then return false end
		if not isfile(cfgPath(name)) then return false end
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
		if not ok or type(data) ~= "table" then return false end
		saved = data
		Window.ConfigName = name
		pcall(function() writefile(folder .. "/_last.txt", name) end)
		ApplySaved(data)
		return true
	end
	function Window:DeleteConfig(name)
		if not (canFS and delfile and name) then return false end
		return pcall(function() if isfile(cfgPath(name)) then delfile(cfgPath(name)) end end)
	end
	function Window:ListConfigs()
		local out = {}
		if canFS and listfiles then
			pcall(function()
				for _, p in ipairs(listfiles(folder)) do
					local n = p:match("([^/\\]+)%.json$")
					if n then table.insert(out, n) end
				end
			end)
		end
		table.sort(out)
		return out
	end
	function Window:ExportConfig()
		local ok, str = pcall(function() return HttpService:JSONEncode(Snapshot()) end)
		return ok and str or nil
	end
	function Window:ImportConfig(str)
		local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
		if not ok or type(data) ~= "table" then return false end
		saved = data
		ApplySaved(data)
		Persist()
		return true
	end

	function Window:CreateSettingsTab(name, icon)
		local tab = Window:CreateTab(name or "Settings", icon or "settings")

		local ui = tab:AddGroup("Interface", { Icon = "monitor" })
		ui:AddDropdown({ Name = "Theme", Flag = "ui_theme", Options = PresetOrder, Default = "Dark Gray", Keywords = "theme preset color dark light", Callback = function(v)
			if v then Window:SetThemePreset(v) end
		end })
		ui:AddColorPicker({ Name = "Accent Color", Flag = "ui_accent", Default = theme.Accent, Keywords = "color theme", Callback = function(c) Window:SetAccent(c) end })
		ui:AddToggle({ Name = "Animated Background", Flag = "ui_bg", Default = cfg.Background ~= false, Keywords = "blackhole animation background", Callback = function(v) Window:SetBackground(v) end })
		ui:AddToggle({ Name = "Auto Scale (Responsive)", Flag = "ui_autoscale", Default = autoScale, Description = "Adjusts the UI size to fit the screen", Keywords = "screen size dpi", Callback = function(v) Window:SetAutoScale(v) end })
		ui:AddSlider({ Name = "UI Scale", Flag = "ui_scale", Min = 0.6, Max = 1.4, Default = userScale, Increment = 0.05, Keywords = "size bigger smaller", Callback = function(v) Window:SetScale(v) end })
		ui:AddDropdown({ Name = "Sidebar", Flag = "ui_sidebar", Options = { "Auto", "Expanded", "Collapsed" }, Default = "Auto", Callback = function(v) Window:SetSidebar(v) end })
		ui:AddDropdown({ Name = "Notification Position", Flag = "ui_notifpos", Options = { "TopLeft", "TopCenter", "TopRight", "BottomLeft", "BottomCenter", "BottomRight" }, Default = cfg.NotifyPosition or "TopLeft", Keywords = "notification position", Callback = function(v)
			if v then Window:SetNotifyPosition(v) end
		end })
		ui:AddKeybind({ Name = "Toggle UI Key", Flag = "ui_togglekey", Default = toggleKey, Keywords = "hotkey key button", Changed = function(k)
			if k ~= Enum.KeyCode.Unknown then toggleKey = k end
		end })
		ui:AddButton({ Name = "Test Notification", Icon = "info", Callback = function()
			Window:Notify({ Title = "Scripting404", Content = "Notifications are working correctly.", Type = "success", Duration = 3 })
		end })

		local cg = tab:AddGroup("Configuration", { Icon = "save" })
		if not canFS then
			cg:AddInfo({ Title = "File system unavailable", Content = "This executor does not support writefile/readfile, so auto save and configs are disabled. Clipboard export/import still works.", Type = "warning" })
		else
			local nameInput = Window.ConfigName
			local listDD
			cg:AddToggle({ Name = "Auto Save", Flag = "ui_autosave", Default = Window.AutoSave, Keywords = "auto save", Callback = function(v) Window:SetAutoSave(v) end })
			cg:AddInput({ Name = "Config Name", Default = Window.ConfigName, Callback = function(t) if t ~= "" then nameInput = t end end })
			listDD = cg:AddDropdown({ Name = "Saved Configs", Options = Window:ListConfigs(), Default = Window.ConfigName, Callback = function(v) if v then nameInput = v end end })
			local function refresh() listDD:Refresh(Window:ListConfigs()) end
			cg:AddButton({ Name = "Save Config", Icon = "save", Callback = function()
				local ok = Window:SaveConfig(nameInput)
				refresh()
				Window:Notify({ Title = "Config", Content = ok and ("Saved: " .. nameInput) or "Failed to save.", Type = ok and "success" or "error", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Load Config", Icon = "folder-open", Callback = function()
				local ok = Window:LoadConfig(nameInput)
				Window:Notify({ Title = "Config", Content = ok and ("Loaded: " .. nameInput) or "Config not found.", Type = ok and "info" or "error", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Delete Config", Icon = "trash-2", Style = "danger", Callback = function()
				Window:DeleteConfig(nameInput)
				refresh()
				Window:Notify({ Title = "Config", Content = "Deleted: " .. nameInput, Type = "warning", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Refresh List", Icon = "refresh-cw", Callback = refresh })
		end

		local importText = ""
		cg:AddButton({ Name = "Copy Config to Clipboard", Icon = "copy", Callback = function()
			local json = Window:ExportConfig()
			local ok = json and pcall(function() (setclipboard or toclipboard or set_clipboard)(json) end)
			Window:Notify({ Title = "Config", Content = ok and "Config copied to clipboard." or "Clipboard is not supported.", Type = ok and "success" or "error", Duration = 2.5 })
		end })
		cg:AddInput({ Name = "Import (paste JSON)", Placeholder = "Paste config...", Callback = function(t) importText = t end })
		cg:AddButton({ Name = "Import Config", Icon = "folder-open", Callback = function()
			local text = importText
			if (text == nil or text == "") and getclipboard then
				local ok, clip = pcall(getclipboard)
				if ok and type(clip) == "string" then text = clip end
			end
			local ok = text and text ~= "" and Window:ImportConfig(text)
			Window:Notify({ Title = "Config", Content = ok and "Config imported successfully." or "Invalid JSON.", Type = ok and "success" or "error", Duration = 2.5 })
		end })

		local about = tab:AddGroup("About", { Icon = "info", Collapsed = true })
		about:AddInfo({ Title = title, Content = "Scripting404 UI v" .. Library.Version .. ". Press " .. toggleKey.Name .. " to show/hide the UI.", Type = "info" })
		return tab
	end

	BuildToggleButton(cfg.ToggleButton)
	Layout(false)
	UpdateHeader()

	track(RunService.Heartbeat:Connect(function(dt)
		if main.Visible and bh.Visible then StepBlackhole(dt) end
		StepRains(dt)
		if tbAnim and toggleBtn.Visible then
			tbT += dt
			tbAnim(tbT)
		end
	end))

	track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyScale()
		notifHolder.Size = UDim2.fromOffset(notifWidth(), 0)
		if maximized and main.AnchorPoint == Vector2.new(0, 0) then
			local vp = localVP()
			main.Size = UDim2.fromOffset(vp.X - 16, vp.Y - 16)
			main.Position = UDim2.fromOffset(8, 8)
		end
		FitToScreen()
		ClampToggle()
	end))

	table.insert(Library.Windows, Window)
	PopIn()
	return Window
end

function Library:DestroyAll()
	for _, w in ipairs(Library.Windows) do pcall(function() w:Destroy() end) end
	table.clear(Library.Windows)
end

return Library
