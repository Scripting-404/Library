	local tbOpts = cfg.ToggleButton or {}
	local toggleBtn = Create("Frame", {
		Name = "ToggleButton", AnchorPoint = Vector2.new(0.5, 0.5), Position = tbOpts.Position or UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1, Visible = false, ZIndex = 40, Parent = scaler,
