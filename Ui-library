function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local theme = table.clone(BaseTheme)
	if cfg.Accent then theme.Accent = cfg.Accent end

	local Window = { Flags = {}, Setters = {}, Tabs = {}, Minimized = false, Destroyed = false }
	local conns = {}
	local function track(c) table.insert(conns, c) return c end

	local accentList, accentHooks = {}, {}
	local function accent(inst, prop)
		inst[prop] = theme.Accent
		table.insert(accentList, { inst, prop })
	end

	local minSize = cfg.MinSize or Vector2.new(440, 300)
	local maxSize = cfg.MaxSize or Vector2.new(950, 680)
	local startSize = cfg.Size or Vector2.new(580, 400)
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	local title = cfg.Title or "CyberUI"

	local gui = Create("ScreenGui", {
		Name = "CyberUI_" .. HttpService:GenerateGUID(false):sub(1, 6),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
	})
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
	gui.Parent = GetGuiParent()
	Window.Gui = gui

	----------------------------------------------------------------
	-- Main frame
	----------------------------------------------------------------
	local main = Create("Frame", {
		Name = "Main",
		Size = UDim2.fromOffset(startSize.X, startSize.Y),
		Position = UDim2.new(0.5, -startSize.X / 2, 0.5, -startSize.Y / 2),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = gui,
	}, { Corner(10), Stroke(theme.Stroke, 0.2, 1) })
	local mainScale = Create("UIScale", { Scale = 0, Parent = main })
	Window.Main = main

	local function SetAnchor(frame, ax, ay)
		local sz = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
		local old = frame.AnchorPoint
		frame.Position = frame.Position + UDim2.fromOffset((ax - old.X) * sz.X, (ay - old.Y) * sz.Y)
		frame.AnchorPoint = Vector2.new(ax, ay)
	end

	----------------------------------------------------------------
	-- Cyber matrix background
	----------------------------------------------------------------
	local matrix = Create("Frame", {
		Name = "Matrix", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main,
	})
	local glyphs = "01ABCDEF{}[]<>/\\=+*#$%&;:|~"
	local function randChar()
		local i = math.random(1, #glyphs)
		return glyphs:sub(i, i)
	end
	local columns = {}
	local function BuildMatrix()
		for _, c in ipairs(columns) do c.label:Destroy() end
		table.clear(columns)
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		for i = 1, math.floor(w / 18) do
			local lines = math.random(8, 16)
			local chars = {}
			for j = 1, lines do chars[j] = randChar() end
			local col = { x = (i - 1) * 18 + 1, y = -math.random(0, h), speed = math.random(40, 120), height = lines * 14, chars = chars }
			col.label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(16, col.height),
				Position = UDim2.fromOffset(col.x, col.y),
				Font = Enum.Font.Code, TextSize = 13,
				TextTransparency = 0.55,
				TextYAlignment = Enum.TextYAlignment.Top,
				Text = table.concat(chars, "\n"),
				Parent = matrix,
			}, {
				Create("UIGradient", {
					Rotation = 90,
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
				}),
			})
			accent(col.label, "TextColor3")
			table.insert(columns, col)
		end
	end
	BuildMatrix()

	local acc = 0
	track(RunService.Heartbeat:Connect(function(dt)
		if not main.Visible then return end
		acc += dt
		local refresh = acc > 0.12
		if refresh then acc = 0 end
		local h = main.Size.Y.Offset
		for _, c in ipairs(columns) do
			c.y += c.speed * dt
			if c.y > h then
				c.y = -c.height
				c.speed = math.random(40, 120)
			end
			c.label.Position = UDim2.fromOffset(c.x, c.y)
			if refresh and math.random() < 0.35 then
				table.insert(c.chars, 1, randChar())
				table.remove(c.chars)
				c.label.Text = table.concat(c.chars, "\n")
			end
		end
	end))

	----------------------------------------------------------------
	-- Topbar
	----------------------------------------------------------------
	local topbar = Create("Frame", {
		Name = "Topbar", Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = theme.Panel,
		BackgroundTransparency = 0.15, BorderSizePixel = 0, Active = true, Parent = main,
	})
	Create("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = theme.Stroke, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = topbar })
	local topIcon = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 12, 0.5, -10), Parent = topbar })
	accent(topIcon, "ImageColor3")
	SetIcon(topIcon, cfg.Icon or "terminal")
	local titleLabel = Create("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -120, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		Text = title, Parent = topbar,
	})

	local function TopButton(iconName, xOff, hoverColor)
		local b = Create("TextButton", {
			Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, xOff, 0.5, -14), BackgroundColor3 = theme.Element,
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = topbar,
		}, { Corner(6) })
		local ic = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ImageColor3 = theme.SubText, Parent = b })
		SetIcon(ic, iconName)
		b.MouseEnter:Connect(function()
			Tween(b, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = hoverColor })
			Tween(ic, 0.15, { ImageColor3 = Color3.new(1, 1, 1) })
		end)
		b.MouseLeave:Connect(function()
			Tween(b, 0.15, { BackgroundTransparency = 1 })
			Tween(ic, 0.15, { ImageColor3 = theme.SubText })
		end)
		return b
	end
	local closeBtn = TopButton("x", -36, theme.Danger)
	local minBtn = TopButton("minus", -68, theme.ElementHover)

	----------------------------------------------------------------
	-- Drag helper
	----------------------------------------------------------------
	local function MakeDraggable(handle, target)
		local dragging, dragStart, startPos, moved = false, nil, nil, false
		track(handle.InputBegan:Connect(function(input)
			if IsPointer(input) then
				dragging, moved = true, false
				dragStart, startPos = input.Position, target.Position
				local c
				c = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						c:Disconnect()
					end
				end)
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and IsMove(input) then
				local d = input.Position - dragStart
				if d.Magnitude > 4 then moved = true end
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))
		return function() return moved end
	end
	MakeDraggable(topbar, main)

	----------------------------------------------------------------
	-- Sidebar & content
	----------------------------------------------------------------
	local sidebar = Create("Frame", {
		Name = "Sidebar", Position = UDim2.fromOffset(0, 38), Size = UDim2.new(0, 150, 1, -38),
		BackgroundColor3 = theme.Panel, BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = main,
	})
	Create("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = theme.Stroke, BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = sidebar })
	local tabList = Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = sidebar,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 9), PaddingBottom = UDim.new(0, 8) }),
	})
	local content = Create("Frame", {
		Name = "Content", Position = UDim2.fromOffset(150, 38), Size = UDim2.new(1, -150, 1, -38),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = main,
	})

	----------------------------------------------------------------
	-- Tabs
	----------------------------------------------------------------
	local currentTab
	local function SelectTab(tab)
		if currentTab == tab then return end
		for _, t in ipairs(Window.Tabs) do
			local active = (t == tab)
			Tween(t.Button, 0.2, { BackgroundTransparency = active and 0.3 or 1 })
			Tween(t.Label, 0.2, { TextColor3 = active and theme.Text or theme.SubText })
			Tween(t.Indicator, 0.25, { BackgroundTransparency = active and 0 or 1, Size = UDim2.fromOffset(3, active and 16 or 4) })
			t.Icon.ImageColor3 = active and theme.Accent or theme.SubText
			t.Active = active
			if not active then t.Page.Visible = false end
		end
		currentTab = tab
		tab.Page.Position = UDim2.fromOffset(0, 14)
		tab.Page.Visible = true
		Tween(tab.Page, 0.3, { Position = UDim2.fromOffset(0, 0) })
	end

	function Window:CreateTab(name, icon)
		local Tab = { Name = name }
		Tab.Button = Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = theme.Element, BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false, LayoutOrder = #Window.Tabs, Parent = tabList,
		}, { Corner(6) })
		Tab.Indicator = Create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(3, 4),
			BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Tab.Button,
		}, { Corner(2) })
		accent(Tab.Indicator, "BackgroundColor3")
		Tab.Icon = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, 12, 0.5, -9), ImageColor3 = theme.SubText, Parent = Tab.Button })
		SetIcon(Tab.Icon, icon)
		Tab.Label = Create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -42, 1, 0),
			Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = name, Parent = Tab.Button,
		})
		Tab.Page = Create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
			ScrollBarThickness = 3, ScrollBarImageColor3 = theme.Stroke, AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(), Parent = content,
		}, {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
			Create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 26) }),
		})
		Tab.Button.MouseEnter:Connect(function()
			if not Tab.Active then Tween(Tab.Button, 0.15, { BackgroundTransparency = 0.6 }) end
		end)
		Tab.Button.MouseLeave:Connect(function()
			if not Tab.Active then Tween(Tab.Button, 0.15, { BackgroundTransparency = 1 }) end
		end)
		Tab.Button.MouseButton1Click:Connect(function() SelectTab(Tab) end)

		-- element base ------------------------------------------------
		local function Base(height)
			return Create("Frame", {
				Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = theme.Element, BackgroundTransparency = 0.25,
				BorderSizePixel = 0, Parent = Tab.Page,
			}, { Corner(6), Stroke(theme.Stroke, 0.5, 1) })
		end
		local function Hover(f, btn)
			btn.MouseEnter:Connect(function() Tween(f, 0.15, { BackgroundColor3 = theme.ElementHover }) end)
			btn.MouseLeave:Connect(function() Tween(f, 0.15, { BackgroundColor3 = theme.Element }) end)
		end
		local function NameLabel(parent, text, w)
			return Create("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(w or 1, -24, 1, 0),
				Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, Text = text or "", Parent = parent,
			})
		end
		local function Register(flag, setter, get)
			if flag then
				Window.Setters[flag] = setter
				Window.Flags[flag] = get()
			end
		end
		local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

		function Tab:GetPage() return Tab.Page end

		function Tab:AddSection(text)
			local f = Create("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Parent = Tab.Page })
			local l = Create("TextLabel", {
				BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = Enum.Font.GothamBold, TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left, Text = string.upper(text or ""), Parent = f,
			})
			accent(l, "TextColor3")
			Create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = theme.Stroke, BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = f })
			return f
		end

		function Tab:AddLabel(text)
			local f = Base(30)
			local l = NameLabel(f, text)
			l.TextColor3 = theme.SubText
			return { Set = function(_, t) l.Text = t end }
		end

		function Tab:AddParagraph(titleText, body)
			local f = Base(0)
			f.AutomaticSize = Enum.AutomaticSize.Y
			Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = f })
			Create("UIListLayout", { Padding = UDim.new(0, 3), Parent = f })
			local t = Create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = titleText or "", Parent = f })
			local b = Create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = theme.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = body or "", Parent = f })
			return { Set = function(_, tt, bb) t.Text = tt or t.Text b.Text = bb or b.Text end }
		end

		function Tab:AddButton(o)
			o = o or {}
			local f = Base(36)
			local btn = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(f, o.Name or "Button", 1)
			local ic = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -28, 0.5, -8), ImageColor3 = theme.SubText, Parent = f })
			SetIcon(ic, o.Icon or "mouse-pointer-click")
			Hover(f, btn)
			btn.MouseButton1Click:Connect(function()
				f.BackgroundColor3 = theme.Accent
				Tween(f, 0.35, { BackgroundColor3 = theme.Element })
				fire(o.Callback)
			end)
			return { Fire = function() fire(o.Callback) end }
		end

		function Tab:AddToggle(o)
			o = o or {}
			local state = o.Default or false
			local f = Base(36)
			local btn = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(f, o.Name or "Toggle", 1)
			local sw = Create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(38, 20), BackgroundColor3 = theme.Stroke, BorderSizePixel = 0, Parent = f }, { Corner(10) })
			local knob = Create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sw }, { Corner(7) })
			local obj = {}
			local function render(animate)
				local pos = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
				local col = state and theme.Accent or theme.Stroke
				if animate then
					Tween(knob, 0.25, { Position = pos }, Enum.EasingStyle.Back)
					Tween(sw, 0.25, { BackgroundColor3 = col })
				else
					knob.Position, sw.BackgroundColor3 = pos, col
				end
			end
			function obj:Set(v, silent)
				state = v and true or false
				render(true)
				if o.Flag then Window.Flags[o.Flag] = state end
				if not silent then fire(o.Callback, state) end
			end
			function obj:Get() return state end
			render(false)
			table.insert(accentHooks, function() render(false) end)
			Hover(f, btn)
			btn.MouseButton1Click:Connect(function() obj:Set(not state) end)
			Register(o.Flag, function(v) obj:Set(v) end, function() return state end)
			if state then fire(o.Callback, state) end
			return obj
		end

		function Tab:AddSlider(o)
			o = o or {}
			local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
			local value = math.clamp(o.Default or min, min, max)
			local f = Base(50)
			Create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -90, 0, 16), Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = o.Name or "Slider", Parent = f })
			local valLabel = Create("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(70, 16), Font = Enum.Font.Code, TextSize = 12, TextColor3 = theme.SubText, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
			local bar = Create("Frame", { Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = theme.Stroke, BorderSizePixel = 0, Parent = f }, { Corner(3) })
			local fill = Create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = bar }, { Corner(3) })
			accent(fill, "BackgroundColor3")
			local knob = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = bar }, { Corner(6) })
			local hit = Create("TextButton", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", Parent = f })
			local obj = {}
			local function fmt(v) return tostring(math.floor(v * 1000 + 0.5) / 1000) .. (o.Suffix or "") end
			function obj:Set(v, silent)
				v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
				value = v
				local rel = (max == min) and 0 or (v - min) / (max - min)
				Tween(fill, 0.1, { Size = UDim2.fromScale(rel, 1) })
				Tween(knob, 0.1, { Position = UDim2.fromScale(rel, 0.5) })
				valLabel.Text = fmt(v)
				if o.Flag then Window.Flags[o.Flag] = v end
				if not silent then fire(o.Callback, v) end
			end
			function obj:Get() return value end
			local dragging = false
			local function fromX(x)
				local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				obj:Set(min + (max - min) * rel)
			end
			hit.InputBegan:Connect(function(input)
				if IsPointer(input) then
					dragging = true
					Tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
					fromX(input.Position.X)
				end
			end)
			track(UserInputService.InputChanged:Connect(function(input)
				if dragging and IsMove(input) then fromX(input.Position.X) end
			end))
			track(UserInputService.InputEnded:Connect(function(input)
				if dragging and IsPointer(input) then
					dragging = false
					Tween(knob, 0.15, { Size = UDim2.fromOffset(12, 12) })
				end
			end))
			obj:Set(value, true)
			Register(o.Flag, function(v) obj:Set(v) end, function() return value end)
			return obj
		end

		function Tab:AddDropdown(o)
			o = o or {}
			local options = o.Options or {}
			local selected = o.Default
			local open = false
			local f = Base(36)
			f.ClipsDescendants = true
			local header = Create("TextButton", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Text = "", Parent = f })
			NameLabel(header, o.Name or "Dropdown", 0.5)
			local valLabel = Create("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -32, 0, 0), Size = UDim2.new(0.5, -20, 1, 0), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = theme.SubText, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Text = selected and tostring(selected) or "Select...", Parent = header })
			local arrow = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -20, 0, 18), ImageColor3 = theme.SubText, Parent = header })
			SetIcon(arrow, "chevron-down")
			local list = Create("ScrollingFrame", {
				Position = UDim2.fromOffset(6, 42), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
				AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = f,
			}, { Create("UIListLayout", { Padding = UDim.new(0, 3) }) })
			local obj = {}
			local function listHeight() return math.min(#options, 5) * 29 end
			local function resize()
				list.Size = UDim2.new(1, -12, 0, listHeight())
				Tween(f, 0.28, { Size = UDim2.new(1, 0, 0, open and (42 + listHeight() + 6) or 36) })
				Tween(arrow, 0.28, { Rotation = open and 180 or 0 })
			end
			local function build()
				for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
				for _, opt in ipairs(options) do
					local b = Create("TextButton", {
						Size = UDim2.new(1, -4, 0, 26), BackgroundColor3 = theme.Panel, BackgroundTransparency = 0.3,
						AutoButtonColor = false, Font = Enum.Font.Gotham, TextSize = 12,
						TextColor3 = (opt == selected) and theme.Accent or theme.Text, Text = tostring(opt), Parent = list,
					}, { Corner(5) })
					b.MouseEnter:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0 }) end)
					b.MouseLeave:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0.3 }) end)
					b.MouseButton1Click:Connect(function()
						obj:Set(opt)
						open = false
						resize()
					end)
				end
			end
			function obj:Set(v, silent)
				selected = v
				valLabel.Text = v ~= nil and tostring(v) or "Select..."
				if o.Flag then Window.Flags[o.Flag] = v end
				build()
				if not silent then fire(o.Callback, v) end
			end
			function obj:Get() return selected end
			function obj:Refresh(newOptions)
				options = newOptions or {}
				build()
				if open then resize() end
			end
			build()
			Hover(f, header)
			header.MouseButton1Click:Connect(function() open = not open resize() end)
			Register(o.Flag, function(v) obj:Set(v) end, function() return selected end)
			return obj
		end

		function Tab:AddInput(o)
			o = o or {}
			local text = o.Default or ""
			local f = Base(36)
			NameLabel(f, o.Name or "Input", 0.5)
			local box = Create("TextBox", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(150, 24),
				BackgroundColor3 = theme.Panel, BorderSizePixel = 0, Font = Enum.Font.Gotham, TextSize = 12,
				TextColor3 = theme.Text, PlaceholderText = o.Placeholder or "Type here...", PlaceholderColor3 = theme.SubText,
				ClearTextOnFocus = false, Text = text, Parent = f,
			}, { Corner(5), Stroke(theme.Stroke, 0.4, 1) })
			local st = box:FindFirstChildOfClass("UIStroke")
			box.Focused:Connect(function() Tween(st, 0.2, { Color = theme.Accent, Transparency = 0 }) end)
			local obj = {}
			box.FocusLost:Connect(function(enter)
				Tween(st, 0.2, { Color = theme.Stroke, Transparency = 0.4 })
				text = box.Text
				if o.Flag then Window.Flags[o.Flag] = text end
				fire(o.Callback, text, enter)
			end)
			function obj:Set(v) box.Text = tostring(v) text = box.Text if o.Flag then Window.Flags[o.Flag] = text end fire(o.Callback, text, false) end
			function obj:Get() return text end
			Register(o.Flag, function(v) obj:Set(v) end, function() return text end)
			return obj
		end

		function Tab:AddKeybind(o)
			o = o or {}
			local key = o.Default or Enum.KeyCode.Unknown
			local listening = false
			local f = Base(36)
			NameLabel(f, o.Name or "Keybind", 0.6)
			local kb = Create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(90, 24),
				BackgroundColor3 = theme.Panel, AutoButtonColor = false, Font = Enum.Font.Code, TextSize = 12,
				TextColor3 = theme.Text, Text = key.Name, Parent = f,
			}, { Corner(5), Stroke(theme.Stroke, 0.4, 1) })
			local obj = {}
			function obj:Set(k)
				if typeof(k) == "string" then k = Enum.KeyCode[k] or Enum.KeyCode.Unknown end
				key = k
				kb.Text = key.Name
				if o.Flag then Window.Flags[o.Flag] = key.Name end
			end
			function obj:Get() return key end
			kb.MouseButton1Click:Connect(function()
				listening = true
				kb.Text = "..."
				Tween(kb, 0.15, { TextColor3 = theme.Accent })
			end)
			track(UserInputService.InputBegan:Connect(function(input, gpe)
				if listening then
					if input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						obj:Set(input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode)
						Tween(kb, 0.15, { TextColor3 = theme.Text })
					end
				elseif not gpe and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
					fire(o.Callback, key)
				end
			end))
			Register(o.Flag, function(v) obj:Set(v) end, function() return key.Name end)
			return obj
		end

		-- Custom GUI: kembalikan Frame kosong yang bisa kamu isi sendiri
		function Tab:AddCustom(height, builder)
			local f = Base(height or 100)
			f.ClipsDescendants = true
			if builder then task.spawn(builder, f, theme) end
			return f
		end

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then SelectTab(Tab) end
		return Tab
	end

	function Window:SelectTab(tab) SelectTab(tab) end

	----------------------------------------------------------------
	-- Notifications
	----------------------------------------------------------------
	local notifHolder = Create("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 270, 1, -32),
		BackgroundTransparency = 1, Parent = gui,
	}, { Create("UIListLayout", { Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }) })

	function Window:Notify(o)
		o = o or {}
		local dur = o.Duration or 4
		local wrap = Create("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundTransparency = 1, ClipsDescendants = false, Parent = notifHolder })
		local card = Create("Frame", {
			Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 40, 0, 0), BackgroundColor3 = theme.Panel,
			BorderSizePixel = 0, ClipsDescendants = true, Parent = wrap,
		}, { Corner(8), Stroke(theme.Stroke, 0.3, 1) })
		Create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 16), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = o.Title or "Notification", Parent = card })
		Create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 30), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = theme.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = o.Content or "", Parent = card })
		local bar = Create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, BackgroundColor3 = theme.Accent, Parent = card })
		Tween(card, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
		Tween(bar, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
		task.delay(dur, function()
			if not card.Parent then return end
			Tween(card, 0.35, { Position = UDim2.new(1, 40, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In).Completed:Wait()
			wrap:Destroy()
		end)
	end

	----------------------------------------------------------------
	-- Resize handle (pojok kanan bawah)
	----------------------------------------------------------------
	local handle = Create("TextButton", {
		Name = "ResizeHandle", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1, Text = "", Parent = main,
	})
	local handleIcon = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4), ImageColor3 = theme.SubText, ImageTransparency = 0.3, Parent = handle })
	SetIcon(handleIcon, "move-diagonal-2")
	handle.MouseEnter:Connect(function() Tween(handleIcon, 0.15, { ImageColor3 = theme.Accent, ImageTransparency = 0 }) end)
	handle.MouseLeave:Connect(function() Tween(handleIcon, 0.15, { ImageColor3 = theme.SubText, ImageTransparency = 0.3 }) end)

	local resizing, rStart, rSize = false, nil, nil
	track(handle.InputBegan:Connect(function(input)
		if IsPointer(input) then
			resizing, rStart = true, input.Position
			rSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					c:Disconnect()
					BuildMatrix()
				end
			end)
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if resizing and IsMove(input) then
			local d = input.Position - rStart
			local w = math.clamp(rSize.X + d.X / mainScale.Scale, minSize.X, maxSize.X)
			local h = math.clamp(rSize.Y + d.Y / mainScale.Scale, minSize.Y, maxSize.Y)
			main.Size = UDim2.fromOffset(w, h)
		end
	end))

	----------------------------------------------------------------
	-- Animations: show / hide / minimize / restore
	----------------------------------------------------------------
	local animating = false
	local function PopIn()
		animating = true
		main.Visible = true
		SetAnchor(main, 0.5, 0.5)
		mainScale.Scale = 0
		Tween(mainScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back).Completed:Once(function()
			SetAnchor(main, 0, 0)
			animating = false
		end)
	end
	local function PopOut(cb)
		animating = true
		SetAnchor(main, 0.5, 0.5)
		Tween(mainScale, 0.28, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			main.Visible = false
			animating = false
			if cb then cb() end
		end)
	end

	-- toggle button (muncul saat minimize)
	local toggleBtn = Create("ImageButton", {
		Name = "ToggleButton", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 40), Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = theme.Panel, AutoButtonColor = false, Visible = false, Parent = gui,
	}, { Corner(12), Stroke(theme.Accent, 0.2, 1.5) })
	local toggleScale = Create("UIScale", { Scale = 0, Parent = toggleBtn })
	local toggleIcon = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = toggleBtn })
	accent(toggleIcon, "ImageColor3")
	SetIcon(toggleIcon, cfg.Icon or "terminal")
	local toggleMoved = MakeDraggable(toggleBtn, toggleBtn)
	toggleBtn.MouseEnter:Connect(function() Tween(toggleBtn, 0.15, { BackgroundColor3 = theme.ElementHover }) end)
	toggleBtn.MouseLeave:Connect(function() Tween(toggleBtn, 0.15, { BackgroundColor3 = theme.Panel }) end)

	function Window:Minimize()
		if animating or Window.Minimized or Window.Destroyed then return end
		Window.Minimized = true
		PopOut(function()
			toggleBtn.Visible = true
			toggleScale.Scale = 0
			Tween(toggleScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	function Window:Restore()
		if animating or not Window.Minimized or Window.Destroyed then return end
		Window.Minimized = false
		Tween(toggleScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			toggleBtn.Visible = false
		end)
		PopIn()
	end
	function Window:Toggle()
		if Window.Minimized then Window:Restore() else Window:Minimize() end
	end
	toggleBtn.Activated:Connect(function()
		if not toggleMoved() then Window:Restore() end
	end)
	minBtn.MouseButton1Click:Connect(function() Window:Minimize() end)

	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if not gpe and input.KeyCode == toggleKey then Window:Toggle() end
	end))

	----------------------------------------------------------------
	-- Confirm close popup
	----------------------------------------------------------------
	local overlay = Create("TextButton", {
		Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, Visible = false, Active = true, Parent = main,
	})
	local dialog = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(290, 142),
		BackgroundColor3 = theme.Panel, BorderSizePixel = 0, Parent = overlay,
	}, { Corner(10), Stroke(theme.Stroke, 0.1, 1) })
	local dialogScale = Create("UIScale", { Scale = 0.8, Parent = dialog })
	local warnIcon = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(16, 14), ImageColor3 = theme.Danger, Parent = dialog })
	SetIcon(warnIcon, "triangle-alert")
	Create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(46, 14), Size = UDim2.new(1, -60, 0, 22), Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = "Close UI?", Parent = dialog })
	Create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 44), Size = UDim2.new(1, -32, 0, 40), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = theme.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "Apakah kamu yakin ingin menghapus UI ini? Semua tab dan pengaturan akan hilang.", Parent = dialog })

	local function DialogButton(text, x, color, textColor)
		local b = Create("TextButton", {
			Position = UDim2.new(x, x == 0 and 16 or 4, 1, -46), Size = UDim2.new(0.5, -20, 0, 32), BackgroundColor3 = color,
			AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = textColor, Text = text, Parent = dialog,
		}, { Corner(6) })
		b.MouseEnter:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0.2 }) end)
		b.MouseLeave:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0 }) end)
		return b
	end
	local confirmBtn = DialogButton("Close", 0, theme.Danger, Color3.new(1, 1, 1))
	local cancelBtn = DialogButton("Cancel", 0.5, theme.Element, theme.Text)

	local function ShowConfirm(show)
		if show then
			overlay.Visible = true
			dialogScale.Scale = 0.8
			Tween(overlay, 0.25, { BackgroundTransparency = 0.45 })
			Tween(dialogScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			Tween(dialogScale, 0.2, { Scale = 0.8 })
			Tween(overlay, 0.2, { BackgroundTransparency = 1 }).Completed:Once(function()
				overlay.Visible = false
			end)
		end
	end
	closeBtn.MouseButton1Click:Connect(function() ShowConfirm(true) end)
	cancelBtn.MouseButton1Click:Connect(function() ShowConfirm(false) end)

	function Window:Destroy()
		if Window.Destroyed then return end
		Window.Destroyed = true
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		gui:Destroy()
		if cfg.OnClose then task.spawn(cfg.OnClose) end
	end
	confirmBtn.MouseButton1Click:Connect(function()
		ShowConfirm(false)
		toggleBtn.Visible = false
		PopOut(function() Window:Destroy() end)
	end)

	----------------------------------------------------------------
	-- Settings API
	----------------------------------------------------------------
	function Window:SetTitle(t) titleLabel.Text = t end
	function Window:SetToggleKey(k) toggleKey = k end
	function Window:SetAccent(color)
		theme.Accent = color
		for _, e in ipairs(accentList) do
			pcall(function() e[1][e[2]] = color end)
		end
		for _, fn in ipairs(accentHooks) do pcall(fn) end
		if currentTab then currentTab.Icon.ImageColor3 = color end
	end

	local folder = cfg.ConfigFolder or "CyberUI"
	function Window:SaveConfig(name)
		if not writefile then return false end
		pcall(function() if makefolder and not isfolder(folder) then makefolder(folder) end end)
		local data = {}
		for k, v in pairs(Window.Flags) do
			local t = typeof(v)
			if t == "string" or t == "number" or t == "boolean" then data[k] = v end
		end
		return pcall(function() writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(data)) end)
	end
	function Window:LoadConfig(name)
		if not (readfile and isfile) then return false end
		local path = folder .. "/" .. name .. ".json"
		if not isfile(path) then return false end
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
		if not ok then return false end
		for k, v in pairs(data) do
			if Window.Setters[k] then pcall(Window.Setters[k], v) end
		end
		return true
	end

	table.insert(Library.Windows, Window)
	PopIn()
	return Window
end

return Library
