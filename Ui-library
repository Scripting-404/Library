				local l = L({ AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22), Font = Enum.Font.GothamMedium, TextSize = 11, Text = tostring(text), Parent = c })
				if color then
					st.Color, l.TextColor3 = color, color
