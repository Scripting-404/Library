	function Window:Notify(o)
		o = o or {}
		local dur = o.Duration or 4
		local kind = o.Type
		local col = o.Color or TypeColors[kind] or theme.Accent
		local icon = o.Icon or o.Image or TypeIcons[kind]
		local W = notifWidth()
		notifHolder.Size = UDim2.fromOffset(W, 0)

