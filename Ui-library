local function ResolveAsset(icon)
	if type(icon) == "number" then return "rbxassetid://" .. icon end
	if type(icon) == "string" then
		if icon:match("^rbxassetid://") or icon:match("^rbxasset://") or icon:match("^rbxthumb://") then return icon end
		if icon:match("^%d+$") then return "rbxassetid://" .. icon end
	end
	return nil
end

local function SetIcon(label, icon)
	if icon == nil or icon == "" or icon == false then return false, false end
	local asset = ResolveAsset(icon)
	if asset then
		label.Image = asset
		label.ImageRectSize = Vector2.zero
		label.ImageRectOffset = Vector2.zero
		return true, true
	end
	if not IconsV2 or type(icon) ~= "string" then return false, false end
	local ok, res = pcall(function() return IconsV2.GetIcon(icon) end)
	if not ok or not res then return false, false end
	if type(res) == "table" then
		label.Image = res[1] or res.Image or ""
		local rect = res[2] or res
		if type(rect) == "table" and rect.ImageRectSize then
			label.ImageRectSize = rect.ImageRectSize
			label.ImageRectOffset = rect.ImageRectPosition or rect.ImageRectOffset or Vector2.zero
		end
	else
		label.Image = res
	end
	return false, label.Image ~= ""
end

