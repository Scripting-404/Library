			local danger = bd.Style == "danger"
			local b = Create("TextButton", {
				Size = UDim2.new(1 / n, -8 * (n - 1) / n, 1, 0), BackgroundColor3 = danger and theme.Danger or theme.Element, AutoButtonColor = false,
				Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = danger and Color3.new(1, 1, 1) or theme.Text, Text = bd.Text or "OK", ZIndex = 33, Parent = row,
			}, { Corner(8) })
			b.MouseEnter:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0.2 }) end)
			b.MouseLeave:Connect(function() Tween(b, 0.15, { BackgroundTransparency = 0 }) end)
			b.MouseButton1Click:Connect(function()
				HideDialog()
				if bd.Callback then task.spawn(bd.Callback) end
			end)
		end

		overlay.Visible = true
		dialogScale.Scale = 0.8
		Tween(overlay, 0.25, { BackgroundTransparency = 0.45 })
		Tween(dialogScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	function Window:Destroy()
		if Window.Destroyed then return end
		if Window.AutoSave and canFS then pcall(function() Window:SaveConfig(Window.ConfigName) end) end
		Window.Destroyed = true
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		ClearToggle()
		gui:Destroy()
		if cfg.OnClose then task.spawn(cfg.OnClose) end
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Dialog({
			Title = "Close UI?",
			Content = "Apakah kamu yakin ingin menghapus UI ini? Semua tab dan pengaturan akan hilang.",
			Icon = "triangle-alert", IconColor = theme.Danger,
			Buttons = {
				{ Text = "Close", Style = "danger", Callback = function()
					toggleBtn.Visible = false
					PopOut(function() Window:Destroy() end)
				end },
				{ Text = "Cancel" },
			},
		})
	end)

	----------------------------------------------------------------
	-- Settings API
	----------------------------------------------------------------
	function Window:SetTitle(t) titleLabel.Text = t end
	function Window:SetToggleKey(k) toggleKey = k end
	function Window:SetTheme(t)
		for k, v in pairs(t or {}) do theme[k] = v end
		ApplyTheme()
	end
	function Window:SetAccent(color) Window:SetTheme({ Accent = color }) end
	function Window:SetBackground(on) bh.Visible = on and true or false end
	function Window:SetScale(mult)
		userScale = math.clamp(mult or 1, 0.4, 2)
		applyScale()
		FitToScreen()
	end
	function Window:SetAutoScale(on)
		autoScale = on and true or false
		applyScale()
		FitToScreen()
	end
	function Window:SetSidebar(mode)
		if mode == "Collapsed" then sbManual = true elseif mode == "Expanded" then sbManual = false else sbManual = nil end
		Layout(true)
	end
	function Window:SetAutoSave(on) Window.AutoSave = on and true or false end

	function Window:SetPosition(x, y)
		if Window.Destroyed then return end
		local vp = localVP()
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		main.Position = UDim2.fromOffset(
			math.clamp(tonumber(x) or 0, 0, math.max(0, vp.X - w)),
			math.clamp(tonumber(y) or 0, 0, math.max(0, vp.Y - h))
		)
	end

	function Window:GetPosition()
		return main.Position.X.Offset, main.Position.Y.Offset
	end

	function Window:SetSize(w, h)
		if Window.Destroyed then return end
		local cw, ch = clampSize(tonumber(w) or main.Size.X.Offset, tonumber(h) or main.Size.Y.Offset)
		main.Size = UDim2.fromOffset(cw, ch)
		FitToScreen()
		ClampWindowToViewport()
	end

	function Window:GetSize()
		return main.Size.X.Offset, main.Size.Y.Offset
	end

	function Window:Center()
		local vp = localVP()
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		main.Position = UDim2.fromOffset(math.max(0, (vp.X - w) / 2), math.max(0, (vp.Y - h) / 2))
	end

	-- config ---------------------------------------------------------
	function Window:SaveConfig(name)
		if not canFS then return false end
		name = (name and name ~= "") and name or Window.ConfigName
		pcall(function() if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end end)
		local data = {}
		for k, v in pairs(saved) do data[k] = v end
		for k, v in pairs(Window.Flags) do
			local t = typeof(v)
			if t == "string" or t == "number" or t == "boolean" or t == "table" then data[k] = v end
		end
		local ok = pcall(function() writefile(cfgPath(name), HttpService:JSONEncode(data)) end)
		if ok then
			saved = data
			Window.ConfigName = name
			pcall(function() writefile(folder .. "/_last.txt", name) end)
		end
		return ok
	end
	function Window:LoadConfig(name)
		if not (canFS and name and name ~= "") then return false end
		if not isfile(cfgPath(name)) then return false end
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
		if not ok or type(data) ~= "table" then return false end
		saved = data
		Window.ConfigName = name
		pcall(function() writefile(folder .. "/_last.txt", name) end)
		for k, v in pairs(data) do
			if Window.Setters[k] then pcall(Window.Setters[k], v) end
		end
		return true
	end
	function Window:DeleteConfig(name)
		if not (canFS and delfile and name) then return false end
		return pcall(function() if isfile(cfgPath(name)) then delfile(cfgPath(name)) end end)
	end
	function Window:ListConfigs()
		local out = {}
		if canFS and listfiles then
			pcall(function()
				for _, p in ipairs(listfiles(folder)) do
					local n = p:match("([^/\\]+)%.json$")
					if n then table.insert(out, n) end
				end
			end)
		end
		table.sort(out)
		return out
	end

	-- tab pengaturan bawaan -------------------------------------------
	function Window:CreateSettingsTab(name, icon)
		local tab = Window:CreateTab(name or "Scripting404 Settings", icon or "settings")

		local ui = tab:AddGroup("Interface", { Icon = "monitor" })
		ui:AddColorPicker({ Name = "Accent Color", Flag = "ui_accent", Default = theme.Accent, Keywords = "warna tema theme", Callback = function(c) Window:SetAccent(c) end })
		ui:AddToggle({ Name = "Blackhole Background", Flag = "ui_bg", Default = true, Keywords = "animasi background", Callback = function(v) Window:SetBackground(v) end })
		ui:AddToggle({ Name = "Auto Scale (Responsive)", Flag = "ui_autoscale", Default = autoScale, Keywords = "ukuran layar dpi responsive phone tablet", Callback = function(v) Window:SetAutoScale(v) end })n layar dpi", Callback = function(v) Window:SetAutoScale(v) end })
		ui:AddSlider({ Name = "UI Scale", Flag = "ui_scale", Min = 0.6, Max = 1.4, Default = userScale, Increment = 0.05, Keywords = "ukuran besar kecil zoom", Callback = function(v) Window:SetScale(v) end })n = 0.6, Max = 1.4, Default = userScale, Increment = 0.05, Keywords = "ukuran besar kecil", Callback = function(v) Window:SetScale(v) end })
		ui:AddDropdown({ Name = "Sidebar", Flag = "ui_sidebar", Options = { "Auto", "Expanded", "Collapsed" }, Default = "Auto", Callback = function(v) Window:SetSidebar(v) end })
		ui:AddKeybind({ Name = "Toggle UI Key", Flag = "ui_togglekey", Default = toggleKey, Keywords = "hotkey tombol", Changed = function(k)
			if k ~= Enum.KeyCode.Unknown then toggleKey = k end
		end })

		local cg = tab:AddGroup("Configuration", { Icon = "save" })
		if not canFS then
			cg:AddInfo({ Title = "File system tidak tersedia", Content = "Executor ini tidak mendukung writefile/readfile, jadi auto save dan config dinonaktifkan.", Type = "warning" })
		else
			local nameInput = Window.ConfigName
			local listDD
			cg:AddToggle({ Name = "Auto Save", Flag = "ui_autosave", Default = Window.AutoSave, Keywords = "simpan otomatis", Callback = function(v) Window:SetAutoSave(v) end })
			cg:AddInput({ Name = "Config Name", Default = Window.ConfigName, Callback = function(t) if t ~= "" then nameInput = t end end })
			listDD = cg:AddDropdown({ Name = "Saved Configs", Options = Window:ListConfigs(), Default = Window.ConfigName, Callback = function(v) if v then nameInput = v end end })
			local function refresh() listDD:Refresh(Window:ListConfigs()) end
			cg:AddButton({ Name = "Save Config", Icon = "save", Callback = function()
				local ok = Window:SaveConfig(nameInput)
				refresh()
				Window:Notify({ Title = "Config", Content = ok and ("Disimpan: " .. nameInput) or "Gagal menyimpan.", Type = ok and "success" or "error", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Load Config", Icon = "folder-open", Callback = function()
				local ok = Window:LoadConfig(nameInput)
				Window:Notify({ Title = "Config", Content = ok and ("Dimuat: " .. nameInput) or "Config tidak ditemukan.", Type = ok and "info" or "error", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Delete Config", Icon = "trash-2", Callback = function()
				Window:DeleteConfig(nameInput)
				refresh()
				Window:Notify({ Title = "Config", Content = "Dihapus: " .. nameInput, Type = "warning", Duration = 2.5 })
			end })
			cg:AddButton({ Name = "Refresh List", Icon = "refresh-cw", Callback = refresh })
		end
		return tab
	end

	----------------------------------------------------------------
	-- Init
	----------------------------------------------------------------
	BuildToggleButton(cfg.ToggleButton)
	Layout(false)
	UpdateHeader()

	local boundaryTick = 0
	track(RunService.Heartbeat:Connect(function(dt)
		if main.Visible and bh.Visible then StepBlackhole(dt) end
		StepRains(dt)
		if tbAnim and toggleBtn.Visible then
			tbT += dt
			tbAnim(tbT)
		end

		boundaryTick += dt
		if boundaryTick >= 0.12 then
			boundaryTick = 0
			if main.Visible then ClampWindowToViewport() end
			if toggleBtn.Visible then ClampToggleButton() end
		end
	end))

	track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyScale()
		notifHolder.Size = UDim2.fromOffset(notifWidth(), 0)
		FitToScreen()
		ClampWindowToViewport()
		ClampToggleButton()
	end))

	table.insert(Library.Windows, Window)
	PopIn()
	return Window
end

return Library
