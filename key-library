		setStatus("Access granted", "success")
		fadeOutAndDestroy(function()
			runCallback(key)
		end)
	end

	local function onFail(msg)
		busy = false
		spinning = false
		verifyBtn.Text = "Verify"
		tween(fill, 0.3, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad)
		setStatus(msg, "error")
		if inputStroke then
			inputStroke.Color = C.error
			inputStroke.Transparency = 0
			task.delay(1.4, function()
				if inputStroke.Parent then
					tween(inputStroke, 0.4, { Color = C.secondary, Transparency = 0.4 }, Enum.EasingStyle.Sine)
				end
			end)
		end
	end

	local function attempt(rawKey, isSaved)
		if not ready or busy or finished then
			return
		end
		local key = trim(rawKey)
		if key == "" then
			setStatus("Enter your key first", "error")
			return
		end
		if #key > 256 then
			setStatus("That key looks too long", "error")
			return
		end
		busy = true
		spinning = true
		verifyBtn.Text = "Checking..."
		setStatus("Verifying key...", "loading")
		tween(fill, 3.2, { Size = UDim2.fromScale(0.88, 1) }, Enum.EasingStyle.Quad)

		task.spawn(function()
			local started = os.clock()
			local ok, valid, reason = pcall(validateKey, key)
			local remain = (isSaved and 0.3 or 1) - (os.clock() - started)
			if remain > 0 then
				task.wait(remain)
			end
			if ok and valid == true then
				onSuccess(key)
			else
				if not ok then
					onFail("Something went wrong, try again.")
				else
					if reason and tostring(reason):lower():find("expir") then
						stats.expired += 1
						saveStats()
					end
					onFail(reason and tostring(reason):sub(1, 80) or "Invalid or expired key")
				end
			end
		end)
	end

