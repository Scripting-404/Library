                    stroke.Transparency = 0.35
                end
                nameLabel.TextTransparency = 0
                descLabel.TextTransparency = 0.2
                shapeScale.Scale = 1
                hub.Position = BASE
                return
            end
            local t = 0.6
            tween(shape, t, { BackgroundTransparency = FILL_ALPHA }, Ease.Quint)
            tween(iconLabel, t, { ImageTransparency = 0 }, Ease.Quint)
            if initials then
                tween(initials, t, { TextTransparency = 0 }, Ease.Quint)
            end
            if stroke then
                tween(stroke, t, { Transparency = 0.35 }, Ease.Quint)
            end
            tween(nameLabel, t, { TextTransparency = 0 }, Ease.Quint)
            tween(descLabel, t, { TextTransparency = 0.2 }, Ease.Quint)
            if HUB_ENTER == "pop" then
                tween(shapeScale, 0.5, { Scale = 1 }, Ease.Back, Dir.Out)
            elseif HUB_ENTER == "slide" then
                tween(hub, 0.5, { Position = BASE }, Ease.Quint)
            end
        end

        local function startAnimation()
            local s = HUB_SPEED
            if type(HUB_ANIM) == "function" then
                local api = {
                    root = hub,
                    holder = holder,
                    shape = shape,
                    stroke = stroke,
                    icon = iconLabel,
                    initials = initials,
                    name = nameLabel,
                    desc = descLabel,
                    scale = shapeScale,
                    speed = s,
                    accent = Config.Accent,
                    secondary = Config.Secondary,
                    tween = tween,
                    loop = loopTween,
                    baseRotation = shape.Rotation,
                    basePosition = BASE,
                }
                task.spawn(function()
                    local ok, err = pcall(HUB_ANIM, api)
                    if not ok then
                        warn("[HubProfile] custom animation error: " .. tostring(err))
                    end
                end)
            elseif HUB_ANIM == "float" then
                loopTween(hub, 1.6 / s, { Position = BASE + UDim2.fromOffset(0, -5) }, Ease.Sine, true)
            elseif HUB_ANIM == "pulse" then
                loopTween(shapeScale, 1.1 / s, { Scale = 1.07 }, Ease.Sine, true)
            elseif HUB_ANIM == "spin" then
                loopTween(shape, 6 / s, { Rotation = shape.Rotation + 360 }, Ease.Linear, false)
            elseif HUB_ANIM == "glow" then
                if stroke then
                    loopTween(stroke, 1.4 / s, { Transparency = 0.9 }, Ease.Sine, true)
                end
            elseif HUB_ANIM == "rainbow" then
                if stroke then
                    local hue = 0
                    local conn
                    conn = RunService.RenderStepped:Connect(function(dt)
                        hue = (hue + dt * 0.3 * s) % 1
                        stroke.Color = Color3.fromHSV(hue, 0.7, 1)
                    end)
                    Gui.Destroying:Connect(function()
                        conn:Disconnect()
                    end)
                end
            end
        end

        setHiddenState()
        Ui.hubReveal = function()
            playEntrance()
            task.delay(0.6, startAnimation)
        end
    end

    end

    local savedKey = loadSavedKey()
    if savedKey then
        KeyBox.Text = savedKey
    end

    local function revealKeyUI()
        phase = "key"
        tween(Fill, 0.4, {Size = UDim2.fromScale(0, 1)}, Ease.Quad, Dir.Out)
        PercentLabel.Text = ""
        if libState == "ready" then
            setStatus(savedKey and "Saved key found. Checking it now" or "Enter your key to continue", "info")
        elseif libState == "failed" then
            setStatus("Key service unavailable", "error")
        else
            setStatus("Connecting to key service...", "loading")
        end
        showGroup(InputFrame, 0.5)
        task.wait(0.12)
        if hasGetKey() then
            showGroup(GetKey.button, 0.5)
        end
        task.wait(0.1)
        showGroup(Verify.button, 0.5)
        task.wait(0.1)
        showGroup(CloseButton, 0.5)
        if Ui.clButton then
            showGroup(Ui.clButton, 0.5)
        end
        if Ui.hubReveal then
            Ui.hubReveal()
        end
        task.wait(0.5)
        loopTween(GetKeyGradient, 3, {Rotation = 360}, Ease.Linear, false)
        loopTween(VerifyGradient, 2.2, {Offset = Vector2.new(1, 0)}, Ease.Sine, false)
        loopTween(Verify.stroke, 1.2, {Thickness = 3.2, Transparency = 0.7}, Ease.Sine, true)
        task.spawn(shineLoop, GetKey.button, 0.4)
        task.spawn(shineLoop, Verify.button, 1.6)
        if libState == "loading" then
            task.spawn(function()
                while libState == "loading" do
                    task.wait(0.1)
                end
                if busy or outcome ~= nil then
                    return
                end
                if libState == "ready" then
                    setStatus(savedKey and "Saved key found. Checking it now" or "Enter your key to continue", "info")
                else
                    setStatus("Key service unavailable", "error")
                end
            end)
        end
        if savedKey then
            task.wait(0.6)
            attempt(savedKey)
        end
    end

    local function logoLoop()
        local shapeBag, phraseBag = {}, {}
        local lastShape, lastPhrase = nil, nil

        -- Random draw from a shuffled bag; never repeats the previous pick
        local function draw(bag, source, last)
            if #bag == 0 then
                for _, item in ipairs(shuffled(source)) do
                    bag[#bag + 1] = item
                end
                if #bag > 1 and bag[#bag] == last then
                    bag[#bag], bag[1] = bag[1], bag[#bag]
                end
            end
            return table.remove(bag)
        end

        local i = 0
        local state = nil
        while running and outcome == nil do
            i = i + 1
            if state then
                setSpeed(6, 1.6, 1.0)
                dissolve(state)
                task.wait(0.15)
            end
            local shape = draw(shapeBag, ShapeNames, lastShape)
            lastShape = shape
            local phrase
            local own = LogoPhrases[shape]
            if own and math.random() < 0.6 then
                phrase = own[math.random(1, #own)]
            else
                phrase = draw(phraseBag, Phrases, lastPhrase)
            end
            lastPhrase = phrase
            state = buildLogo(shape)
            task.wait(FORM_TIME)
            flash()
            scan()
            if i == 1 then
                task.spawn(revealProfile, math.max(INTRO_TOTAL - 0.3 - FORM_TIME - 0.45, 2))
            end
            task.spawn(scramble, GreetingLabel, expand(phrase), 0.6)
            task.wait(phase == "intro" and Config.LogoHold or 2.6)
        end
        if state then
            dissolve(state)
        end
    end

    local function fadeOut()
        for _, d in ipairs(Content:GetDescendants()) do
            if not d:IsDescendantOf(LogoHolder) then
                local props = {}
                if d:IsA("GuiObject") then
                    props.BackgroundTransparency = 1
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    props.TextTransparency = 1
                end
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    props.ImageTransparency = 1
                end
                if d:IsA("UIStroke") then
                    props.Transparency = 1
                end
                if next(props) then
                    tween(d, 0.5, props, Ease.Sine)
                end
            end
        end
        tween(TagIcon, 0.5, {ImageTransparency = 1}, Ease.Sine)
        tween(TagLabel, 0.5, {TextTransparency = 1}, Ease.Sine)
        for _, l in ipairs(lines) do
            tween(l.frame, 0.6, {BackgroundTransparency = 1}, Ease.Sine)
        end
        for _, r in ipairs(rain) do
            tween(r.label, 0.6, {TextTransparency = 1}, Ease.Sine)
        end
    end

    -- Close animation: a glowing line sweeps from left to right and wipes the whole GUI clean behind it
    local function sweepOut()
        exiting = true
        local size = viewport()
        local W, H = size.X, size.Y
        local T = 0.85
        local linear = Enum.EasingStyle.Linear

        -- Everything (dim, effects, card, glow) goes into a clipped layer that shrinks from the left,
        -- while the inner layer moves the opposite way so the content itself stays put on screen.
        local Clip = new("Frame", {
            Name = "WipeClip",
            Size = UDim2.fromOffset(W, H),
            BackgroundTransparency = 1,
            ClipsDescendants = true,
            ZIndex = 2,
        }, Gui)
        local Inner = new("Frame", {
            Name = "WipeInner",
            Size = UDim2.fromOffset(W, H),
            BackgroundTransparency = 1,
        }, Clip)
        for _, child in ipairs(Gui:GetChildren()) do
            if child ~= Blocker and child ~= Clip and child:IsA("GuiObject") then
                child.Parent = Inner
            end
        end

        -- The sweeping line: a soft trail behind a thin rainbow core
        local glowW = math.max(48, math.floor(ViewMin * 0.35))
        local Sweep = new("Frame", {
            Name = "Sweep",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(0, glowW, 1, 0),
            BackgroundTransparency = 1,
            ZIndex = 50,
        }, Gui)
        local Trail = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(200, 130, 255),
            BorderSizePixel = 0,
            ZIndex = 50,
        }, Sweep)
        new("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.6, 0.8),
                NumberSequenceKeypoint.new(1, 0.3),
            }),
        }, Trail)
        local coreColors = {}
        for _, stop in ipairs(EdgeStops) do
            coreColors[#coreColors + 1] = ColorSequenceKeypoint.new(stop[1], stop[2])
        end
        local Core = new("Frame", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.fromScale(1, 0),
            Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            ZIndex = 51,
        }, Sweep)
        new("UIGradient", {Color = ColorSequence.new(coreColors), Rotation = 90}, Core)

        setSpeed(10, 2.2, 1.2)
        local info = TweenInfo.new(T, linear, Enum.EasingDirection.Out)
        TweenService:Create(Clip, info, {Position = UDim2.fromOffset(W, 0), Size = UDim2.fromOffset(0, H)}):Play()
        TweenService:Create(Inner, info, {Position = UDim2.fromOffset(-W, 0)}):Play()
        TweenService:Create(Sweep, info, {Position = UDim2.fromOffset(W, 0)}):Play()
        tween(Blur, T, {Size = 0}, linear)
        task.wait(T)
        tween(Sweep, 0.25, {Position = UDim2.fromOffset(W + glowW, 0)}, linear)
        task.wait(0.3)
    end

    setSpeed(8, 1.6, 1.6)
    tween(EdgeValue, 1.6, {Value = 1}, Ease.Sine)
    task.wait(0.3)
    task.spawn(logoLoop)
    task.delay(INTRO_TOTAL - 0.3, revealKeyUI)

    while outcome == nil do
        task.wait(0.1)
    end

    local success = outcome == "ok"
    if outcome == "closed" then
        sweepOut()
    else
        setSpeed(success and 9 or 5, 2.5, 1.0)
        flash(success and 0.8 or 0.92)
        fadeOut()
        exiting = true
        tween(ContentScale, 0.7, {Scale = BaseScale * (success and 1.12 or 0.92)}, Ease.Quad, Dir.In)
        tween(EdgeValue, 0.8, {Value = 0}, Ease.Sine)
        task.wait(0.4)
        tween(Dim, 0.7, {BackgroundTransparency = 1}, Ease.Sine)
        tween(Blur, 0.7, {Size = 0}, Ease.Sine)
        task.wait(0.9)
    end

    running = false
    pcall(function()
        ContextActionService:UnbindAction(SINK_ACTION)
    end)
    stepConn:Disconnect()
    SpeedValue:Destroy()
    EdgeValue:Destroy()
    Blur:Destroy()
    Gui:Destroy()

    return success, authResult
end)()

    if Authenticated and type(options.Callback) == "function" then
        task.spawn(options.Callback, authKey)
    end
    return Authenticated, AuthResult
end

return Library
