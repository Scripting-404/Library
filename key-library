	local lastVpX, lastVpY = 0, 0
	local function applyLayout()
		local vp = viewport()
		if vp.X < 2 or vp.Y < 2 then
			return false
		end
		if vp.X == lastVpX and vp.Y == lastVpY then
			return true
		end
		lastVpX, lastVpY = vp.X, vp.Y
		minDim = math.min(vp.X, vp.Y)
		if not exiting then
			BASE_SCALE = math.clamp(math.min(vp.X * 0.94 / DESIGN_W, vp.Y * 0.76 / DESIGN_H), 0.2, 3)
			ContentScale.Scale = BASE_SCALE
		end
		tagScale.Scale = math.clamp(minDim / 700, 0.6, 1.4)
		edge.layout(vp.X, vp.Y)
		return true
	end
	applyLayout()
	Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyLayout)

