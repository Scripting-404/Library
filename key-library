    local function renderChangelog()
        for _, child in ipairs(clScroll:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end
        if clLoading then
            clRow(1, "Loading changelog...", Config.Secondary, 13, false)
            return
        end
        if clError then
            clRow(1, clError, Config.Error, 13, false)
            return
        end
        if not clLoaded then
            return
        end
        if #clItems == 0 then
            clRow(1, "No changelog entries yet.", Config.Secondary, 13, false)
            return
        end
        local order = 0
        for _, entry in ipairs(clItems) do
            order += 1
            local head = entry.Version
            if entry.Date ~= "" then
                head = head .. "   " .. entry.Date
            end
            clRow(order, head, Config.Accent, 15, true)
            for _, line in ipairs(entry.Changes) do
                order += 1
                clRow(order, "- " .. line, Config.Secondary, 13, false)
            end
            order += 1
            clRow(order, " ", Config.Secondary, 8, false)
        end
    end

    local function loadChangelog()
        if clLoading then
            return
        end
        clLoading = true
        clError = nil
        task.spawn(function()
            local decoded, err = nil, nil
            if clEntries then
                decoded = clEntries
            elseif clUrl ~= "" then
                local body = nil
                local req = requestFn()
                if req then
                    local ok, res = pcall(req, { Url = clUrl, Method = "GET" })
                    if not ok or type(res) ~= "table" then
                        err = "Couldn't reach the changelog."
                    elseif res.StatusCode ~= 200 then
                        err = "Changelog returned HTTP " .. tostring(res.StatusCode) .. "."
                    else
                        body = res.Body
                    end
                else
                    local ok, res = pcall(game.HttpGet, game, clUrl)
                    if ok then
                        body = res
                    else
                        err = "Couldn't reach the changelog."
                    end
                end
                if body then
                    local okDecode, parsed = pcall(HttpService.JSONDecode, HttpService, body)
                    if okDecode then
                        decoded = parsed
                    else
                        err = "The changelog link did not return valid JSON."
                    end
                end
            end
            clItems = normalizeChangelog(decoded)
            clError = err
            clLoaded = err == nil
            clLoading = false
            if clOpen then
                renderChangelog()
            end
        end)
    end

