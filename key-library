    -- Closed palette loop (last = first): red > pink > purple > blue > cyan > purple > red.
    -- Because it loops, the colors flow around the screen without a visible seam.
    local EdgeStops = {
        {0.00, Color3.fromRGB(255, 38, 52)},
        {0.14, Color3.fromRGB(255, 60, 120)},
        {0.28, Color3.fromRGB(236, 80, 206)},
        {0.42, Color3.fromRGB(150, 84, 240)},
        {0.56, Color3.fromRGB(64, 120, 255)},
        {0.68, Color3.fromRGB(48, 196, 255)},
        {0.80, Color3.fromRGB(86, 110, 255)},
        {0.90, Color3.fromRGB(190, 60, 210)},
        {1.00, Color3.fromRGB(255, 38, 52)},
    }

    local function edgeColor(p)
        p = p % 1
        for i = 2, #EdgeStops do
            local a = EdgeStops[i - 1]
            local b = EdgeStops[i]
            if p <= b[1] then
                local f = (p - a[1]) / (b[1] - a[1])
                return a[2]:Lerp(b[2], f)
            end
        end
        return EdgeStops[1][2]
    end

