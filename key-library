local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function tween(inst, time, props, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function tweenAfter(inst, delay, time, props, style)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, delay),
		props
	)
	t:Play()
	return t
end

local function rounded(parent, radius, strokeColor, strokeAlpha)
	new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
	if strokeColor then
		new("UIStroke", {
			Color = strokeColor,
			Thickness = 1,
			Transparency = strokeAlpha or 0.3,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, parent)
	end
end

local function trim(s)
	return (tostring(s or "")):match("^%s*(.-)%s*$")
end

local function shuffled(list)
	local copy = {}
	for i, v in ipairs(list) do
		copy[i] = v
	end
	for i = #copy, 2, -1 do
		local j = math.random(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function expandName(phrase)
	return (phrase:gsub("{name}", function()
		return LocalPlayer.DisplayName
	end))
end

local function httpRequestFn()
	return request or http_request or (syn and syn.request) or (http and http.request)
end

local function httpGet(url)
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(body) == "string" and body ~= "" then
		return body
	end
	return nil
end

local function loadLibrary(url)
	local src = httpGet(url)
	if not src then
		return nil, "couldn't download " .. url
	end
	if not loadstring then
		return nil, "loadstring is not available"
	end
	local fn, err = loadstring(src)
	if not fn then
		return nil, tostring(err)
	end
	local ok, lib = pcall(fn)
	if not ok then
		return nil, tostring(lib)
	end
	return lib
end

local function sendRequest(opts)
	local req = httpRequestFn()
	if not req then
		return nil, "your executor doesn't support HTTP requests."
	end
	local ok, res = pcall(req, opts)
	if not ok or type(res) ~= "table" then
		return nil, "network error, please try again."
	end
	return res
end

local function decodeJson(body)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "")
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function getHwid()
	if gethwid then
		local ok, h = pcall(gethwid)
		if ok and h ~= nil and tostring(h) ~= "" then
			return tostring(h)
		end
	end
	return tostring(LocalPlayer.UserId)
end

local function readFileSafe(path)
	if not (isfile and readfile) then
		return nil
	end
	local ok, res = pcall(function()
		if isfile(path) then
			return readfile(path)
		end
	end)
	if ok and type(res) == "string" then
		return res
	end
	return nil
end

local function writeFileSafe(folder, path, data)
	if not writefile then
		return
	end
	pcall(function()
		if folder and folder ~= "" and makefolder and isfolder and not isfolder(folder) then
			makefolder(folder)
		end
		writefile(path, data)
	end)
end

local function copyText(text)
	local fn = setclipboard or toclipboard
	if not fn then
		return false
	end
	return (pcall(fn, text))
end

local function resolveHost()
	if gethui then
		local ok, ui = pcall(gethui)
		if ok and ui then
			return ui
		end
	end
	if pcall(function()
		return CoreGui:GetChildren()
	end) then
		return CoreGui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

-- ============================================================
-- SHA-256 (dipakai Platoboost untuk identifier dan verifikasi nonce)
-- ============================================================

local K256 = {
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

local function sha256(msg)
	local band, bor, bxor, bnot = bit32.band, bit32.bor, bit32.bxor, bit32.bnot
	local rrotate, rshift, lshift = bit32.rrotate, bit32.rshift, bit32.lshift
	local h = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
	local len = #msg
	local bits = len * 8
	msg = msg .. "\128" .. string.rep("\0", (55 - len) % 64) .. "\0\0\0\0"
		.. string.char(band(rshift(bits, 24), 255), band(rshift(bits, 16), 255), band(rshift(bits, 8), 255), band(bits, 255))

	for chunk = 1, #msg, 64 do
		local w = {}
		for i = 0, 15 do
			local p = chunk + i * 4
			w[i] = bor(lshift(msg:byte(p), 24), lshift(msg:byte(p + 1), 16), lshift(msg:byte(p + 2), 8), msg:byte(p + 3))
		end
		for i = 16, 63 do
			local s0 = bxor(rrotate(w[i - 15], 7), rrotate(w[i - 15], 18), rshift(w[i - 15], 3))
			local s1 = bxor(rrotate(w[i - 2], 17), rrotate(w[i - 2], 19), rshift(w[i - 2], 10))
			w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
		end

		local a, b, c, d, e, f, g, hh = h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]
		for i = 0, 63 do
			local S1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
			local ch = bxor(band(e, f), band(bnot(e), g))
			local t1 = (hh + S1 + ch + K256[i + 1] + w[i]) % 4294967296
			local S0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
			local maj = bxor(band(a, b), band(a, c), band(b, c))
			local t2 = (S0 + maj) % 4294967296
			hh, g, f, e = g, f, e, (d + t1) % 4294967296
			d, c, b, a = c, b, a, (t1 + t2) % 4294967296
		end

		h[1] = (h[1] + a) % 4294967296
		h[2] = (h[2] + b) % 4294967296
		h[3] = (h[3] + c) % 4294967296
		h[4] = (h[4] + d) % 4294967296
		h[5] = (h[5] + e) % 4294967296
		h[6] = (h[6] + f) % 4294967296
		h[7] = (h[7] + g) % 4294967296
		h[8] = (h[8] + hh) % 4294967296
	end

	return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8])
end

