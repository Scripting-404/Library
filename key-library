		end
	end)

	loopTween(U.getKeyGradient, 3, { Rotation = 360 }, Enum.EasingStyle.Linear)

	local logoState = nil
	if cfg.Intro then
		task.spawn(function()
			task.wait(0.3)
			local i = 0
			while running do
				i += 1
				if logoState then
					dissolveLogo(logoState)
					logoState = nil
					task.wait(0.15)
				end
				local shape = order[((i - 1) % #order) + 1]
				logoState = buildLogo(LogoHolder, shape, ACCENT, SECONDARY, logoTextSize)
				local hour = tonumber(os.date("%H")) or 12
				local pool = {}
				for _, p in ipairs(PHRASES) do
					pool[#pool + 1] = p
				end
				pool[#pool + 1] = hour < 12 and "Good morning, {name}" or (hour < 18 and "Good afternoon, {name}" or "Good evening, {name}")
				task.spawn(scrambleText, U.greet, expandName(pool[math.random(1, #pool)]), 0.6)
				task.wait(FORM_TIME)
				scanLine(LogoHolder, ACCENT)
				flash(Gui, ACCENT, 0.86)
				if i == 1 then
					task.spawn(revealProfile)
					task.delay(INTRO_TOTAL - 0.3, revealKey)
				end
				task.wait(phase == "intro" and HOLD_TIME or 2.6)
			end
		end)
	else
		task.delay(0.4, function()
			revealProfile()
			revealKey()
		end)
	end

	destroy = function()
		if destroyed then
			return
		end
		destroyed = true
		running = false
		pcall(function()
			ContextActionService:UnbindAction(SINK)
		end)
		if stepConn then
			stepConn:Disconnect()
		end
		edgeVal:Destroy()
		speedVal:Destroy()
		if Blur.Parent then
			Blur:Destroy()
		end
		if Gui.Parent then
			Gui:Destroy()
		end
		api.Closed = true
	end

	function api:Destroy()
		destroy()
	end

	return api
end

function KeySystem.Authenticate(options)
	local opts = {}
	for k, v in pairs(options or {}) do
		opts[k] = v
	end
	local ui = KeySystem.new(opts)
	while ui.Key == nil and not ui.Closed do
		task.wait(0.1)
	end
	return ui.Key
end

return KeySystem
