    local segments = {}
    -- Transparency falloff from the screen edge inwards. The solid core hides anything drawn behind it.
    local EdgeGlow = {
        {0, 0.0}, {0.22, 0.05}, {0.45, 0.32}, {0.7, 0.72}, {1, 1},
    }

    local function addSegment(kind, index, count)
        local frac = (index - 0.5) / count
        local u
        local anchor
        if kind == "top" then
            u = frac * 0.25
            anchor = Vector2.new(0, 0)
        elseif kind == "right" then
            u = 0.25 + frac * 0.25
            anchor = Vector2.new(1, 0)
        elseif kind == "bottom" then
            u = 0.5 + (1 - frac) * 0.25
            anchor = Vector2.new(0, 1)
        else
            u = 0.75 + (1 - frac) * 0.25
            anchor = Vector2.new(0, 0)
        end
        local horizontal = (kind == "top" or kind == "bottom")
        local fadeIn = (kind == "top" or kind == "left")
        local frame = new("Frame", {
            AnchorPoint = anchor,
            BackgroundColor3 = Color3.fromRGB(226, 30, 34),
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(0, 0),
            ZIndex = 3,
        }, Edge)
        local keys = {}
        if fadeIn then
            for _, g in ipairs(EdgeGlow) do
                keys[#keys + 1] = NumberSequenceKeypoint.new(g[1], g[2])
            end
        else
            for i2 = #EdgeGlow, 1, -1 do
                keys[#keys + 1] = NumberSequenceKeypoint.new(1 - EdgeGlow[i2][1], EdgeGlow[i2][2])
            end
        end
        new("UIGradient", {Rotation = horizontal and 90 or 0, Transparency = NumberSequence.new(keys)}, frame)
        segments[#segments + 1] = {
            frame = frame,
            u = u,
            kind = kind,
            index = index,
            count = count,
            horizontal = horizontal,
            len = 0,
        }
    end

    for i = 1, 80 do
        addSegment("top", i, 80)
        addSegment("bottom", i, 80)
    end
    for j = 1, 44 do
        addSegment("right", j, 44)
        addSegment("left", j, 44)
    end

    -- Segments are placed on exact whole pixels, edge to edge, so there are no overlaps or gaps (no stripes)
    local function layoutSegments(w, h)
        for _, s in ipairs(segments) do
            local length = s.horizontal and w or h
            local p0 = math.floor((s.index - 1) * length / s.count + 0.5)
            local p1 = math.floor(s.index * length / s.count + 0.5)
            s.len = p1 - p0
            if s.kind == "top" then
                s.frame.Position = UDim2.fromOffset(p0, 0)
            elseif s.kind == "bottom" then
                s.frame.Position = UDim2.new(0, p0, 1, 0)
            elseif s.kind == "left" then
                s.frame.Position = UDim2.fromOffset(0, p0)
            else
                s.frame.Position = UDim2.new(1, 0, 0, p0)
            end
        end
    end

