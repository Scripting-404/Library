local function sha256(msg)
	local band, bor, bxor, bnot = bit32.band, bit32.bor, bit32.bxor, bit32.bnot
	local rrotate, rshift, lshift = bit32.rrotate, bit32.rshift, bit32.lshift
	local h = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
	local len = #msg
	local bits = len * 8
	msg = msg .. "\128" .. string.rep("\0", (55 - len) % 64) .. "\0\0\0\0"
		.. string.char(band(rshift(bits, 24), 255), band(rshift(bits, 16), 255), band(rshift(bits, 8), 255), band(bits, 255))

	for chunk = 1, #msg, 64 do
		local w = {}
		for i = 0, 15 do
			local p = chunk + i * 4
			w[i] = bor(lshift(msg:byte(p), 24), lshift(msg:byte(p + 1), 16), lshift(msg:byte(p + 2), 8), msg:byte(p + 3))
		end
		for i = 16, 63 do
			local s0 = bxor(rrotate(w[i - 15], 7), rrotate(w[i - 15], 18), rshift(w[i - 15], 3))
			local s1 = bxor(rrotate(w[i - 2], 17), rrotate(w[i - 2], 19), rshift(w[i - 2], 10))
			w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
		end

		local a, b, c, d, e, f, g, hh = h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]
		for i = 0, 63 do
			local S1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
			local ch = bxor(band(e, f), band(bnot(e), g))
			local t1 = (hh + S1 + ch + K256[i + 1] + w[i]) % 4294967296
			local S0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
			local maj = bxor(band(a, b), band(a, c), band(b, c))
			local t2 = (S0 + maj) % 4294967296
			hh, g, f, e = g, f, e, (d + t1) % 4294967296
			d, c, b, a = c, b, a, (t1 + t2) % 4294967296
		end

		h[1] = (h[1] + a) % 4294967296
		h[2] = (h[2] + b) % 4294967296
		h[3] = (h[3] + c) % 4294967296
		h[4] = (h[4] + d) % 4294967296
		h[5] = (h[5] + e) % 4294967296
		h[6] = (h[6] + f) % 4294967296
		h[7] = (h[7] + g) % 4294967296
		h[8] = (h[8] + hh) % 4294967296
	end

	return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8])
end

local function platoboostService(cfg)
	local service = tonumber(cfg.ServiceId or cfg.Service) or cfg.ServiceId or cfg.Service
	local secret = cfg.Secret
	local useNonce = cfg.UseNonce ~= false
	local HOSTS = { "https://api.platoboost.app", "https://api.platoboost.com", "https://api.platoboost.net" }
	local host = nil
	local hostChosen = false
	if cfg.Host then
		host = (trim(cfg.Host):gsub("/+$", ""))
		hostChosen = true
	end
	local identifier = sha256(getHwid())
	local cachedLink, cachedAt = nil, 0

	local function chooseHost()
		if hostChosen then
			return
		end
		hostChosen = true
		for _, h in ipairs(HOSTS) do
			local res = sendRequest({ Url = h .. "/public/connectivity", Method = "GET" })
			if res and (res.StatusCode == 200 or res.StatusCode == 429) then
				host = h
				return
			end
		end
		host = HOSTS[1]
	end

	local function makeNonce()
		local t = {}
		for i = 1, 16 do
			t[i] = string.char(math.random(97, 122))
		end
		return table.concat(t)
	end

	local function integrityOk(data, n)
		if not useNonce then
			return true
		end
		return data.hash == sha256("true-" .. n .. "-" .. tostring(secret))
	end

	return {
		CheckKey = function(key)
			key = trim(key)
			if key == "" then
				return false, "key is empty."
			end
			if service == nil or service == "" then
				return false, "Platoboost ServiceId is missing."
			end
			if useNonce and (type(secret) ~= "string" or secret == "") then
				return false, "Platoboost Secret is missing."
			end
			chooseHost()

			local n = makeNonce()
			local url = host .. "/public/whitelist/" .. tostring(service)
				.. "?identifier=" .. identifier .. "&key=" .. HttpService:UrlEncode(key)
			if useNonce then
				url = url .. "&nonce=" .. n
			end
			local res, err = sendRequest({ Url = url, Method = "GET" })
			if not res then
				return false, err
			end
			if res.StatusCode == 429 then
				return false, "rate limited, please wait 20 seconds."
			end
			local data = decodeJson(res.Body)
			if not data then
				return false, "invalid response from server."
			end
			if data.success == true and type(data.data) == "table" and data.data.valid == true then
				if integrityOk(data.data, n) then
					return true
				end
				return false, "failed to verify integrity."
			end

			if key:sub(1, 4) == "KEY_" then
				local n2 = makeNonce()
				local body = { identifier = identifier, key = key }
				if useNonce then
					body.nonce = n2
				end
				local r2, e2 = sendRequest({
					Url = host .. "/public/redeem/" .. tostring(service),
					Method = "POST",
					Body = HttpService:JSONEncode(body),
					Headers = JSON_HEADERS,
				})
				if not r2 then
					return false, e2
				end
				local d2 = decodeJson(r2.Body)
				if not d2 or d2.success ~= true then
					return false, tostring((d2 and d2.message) or "request failed.")
				end
				local inner = type(d2.data) == "table" and d2.data or {}
				if inner.valid ~= true then
					return false, "key is invalid."
				end
				if not integrityOk(inner, n2) then
					return false, "failed to verify integrity."
				end
				return true
			end

			return false, tostring(data.message or "key is invalid.")
		end,

		GetKeyLink = function()
			if cachedLink and os.time() - cachedAt < 600 then
				return cachedLink
			end
			if service == nil or service == "" then
				return nil, "Platoboost ServiceId is missing."
			end
			chooseHost()
			local res, err = sendRequest({
				Url = host .. "/public/start",
				Method = "POST",
				Body = HttpService:JSONEncode({ service = service, identifier = identifier }),
				Headers = JSON_HEADERS,
			})
			if not res then
				return nil, err
			end
			local data = decodeJson(res.Body)
			if res.StatusCode == 200 and data and data.success == true and type(data.data) == "table" and data.data.url then
				cachedLink = data.data.url
				cachedAt = os.time()
				return cachedLink
			end
			if res.StatusCode == 429 then
				return nil, "slow down, wait 20 seconds."
			end
			return nil, tostring((data and data.message) or "Failed to get link.")
		end,
	}
end

local function pandaService(cfg)
	local serviceId = tostring(cfg.ServiceId or cfg.Service or "")
	local lib, loadErr

	local function load()
		if lib then
			return lib
		end
		if loadErr then
			return nil, loadErr
		end
		if serviceId == "" then
			loadErr = "Panda ServiceId is missing."
			return nil, loadErr
		end
		local l, e = loadLibrary("https://secure.pandauth.com/pv4/lib")
		if l and type(l.configure) == "function" then
			local ok, err = pcall(l.configure, { serviceId = serviceId, debug = cfg.Debug == true, kickOnDetect = false })
			if ok then
				lib = l
				return lib
			end
			e = tostring(err)
		end
		loadErr = e or "Panda library failed to initialize."
		return nil, loadErr
	end

	return {
		CheckKey = function(key)
			local l, err = load()
			if not l then
				return false, err
			end
			if type(l.validateEx) == "function" then
				local ok, valid, reason = pcall(l.validateEx, key)
				if not ok then
					return false, tostring(valid)
				end
				if valid == true then
					return true
				end
				return false, tostring(reason or "key is invalid.")
			end
			local ok, res = pcall(l.validate, key)
			if not ok then
				return false, tostring(res)
			end
			if type(res) == "table" and res.success == true then
				return true
			end
			return false, tostring((type(res) == "table" and (res.reason or res.error)) or "key is invalid.")
		end,

		GetKeyLink = function()
			local l, err = load()
			if not l then
				return nil, err
			end
			if type(l.getKeyUrl) ~= "function" then
				return nil, "Panda library has no getKeyUrl."
			end
			local ok, url = pcall(l.getKeyUrl)
			if ok and type(url) == "string" and url ~= "" then
				return url
			end
			return nil, "Failed to get link."
		end,
	}
end

local function jnkieService(cfg)
	local lib
	local function client()
		if lib then
			return lib
		end
		local l, e = loadLibrary("https://jnkie.com/sdk/library.lua")
		if not l then
			return nil, e
		end
		l.service = cfg.Service or cfg.service
		l.identifier = cfg.Identifier or cfg.identifier
		l.provider = cfg.Provider or cfg.provider or "Mixed"
		lib = l
		return lib
	end

	return {
		CheckKey = function(key)
			local l, err = client()
			if not l then
				return false, err
			end
			local ok, res = pcall(l.check_key, key)
			if not ok or type(res) ~= "table" then
				return false, "couldn't check key."
			end
			local valid = res.valid == true or res.success == true or res.message == "KEY_VALID" or res.message == "KEYLESS"
			if valid then
				return true
			end
			return false, tostring(res.error or res.message or "key is invalid.")
		end,

		GetKeyLink = function()
			local l, err = client()
			if not l then
				return nil, err
			end
			local ok, link, e2 = pcall(l.get_key_link)
			if ok and link then
				return link
			end
			return nil, tostring(e2 or link or "Failed to get link.")
		end,
	}
end

local function customService(cfg)
	if type(cfg.CheckKey) ~= "function" then
		error("custom service needs a CheckKey function")
	end
	local function ctx()
		local c = { Request = httpRequestFn() }
		for k, v in pairs(cfg) do
			c[k] = v
		end
		return c
	end
	return {
		CheckKey = function(key)
			return cfg.CheckKey(key, ctx())
		end,
		GetKeyLink = type(cfg.GetKeyLink) == "function" and function()
			return cfg.GetKeyLink(ctx())
		end or nil,
	}
end

local SERVICE_BUILDERS = {
	platoboost = platoboostService,
	panda = pandaService,
	pandaauth = pandaService,
	jnkie = jnkieService,
	custom = customService,
}

local function buildServices(api)
	local out = {}
	if type(api) ~= "table" then
		return out
	end
	local list = api
	if api.Type ~= nil or api.type ~= nil then
		list = { api }
	end
	for i, entry in ipairs(list) do
		local kind = string.lower(tostring(entry.Type or entry.type or ""))
		local builder = SERVICE_BUILDERS[kind]
		if not builder then
			warn("[KeySystem] API[" .. i .. "] Type tidak dikenal: '" .. kind .. "'")
		else
			local ok, svc = pcall(builder, entry)
			if ok and svc then
				out[#out + 1] = svc
			else
				warn("[KeySystem] API[" .. i .. "] gagal dimuat: " .. tostring(svc))
			end
		end
	end
	return out
end

local function setMotors(strength)
	for _, inputType in ipairs({ Enum.UserInputType.Touch, Enum.UserInputType.Gamepad1 }) do
		local ok, supported = pcall(function()
			return HapticService:IsVibrationSupported(inputType)
		end)
		if ok and supported then
			for _, motor in ipairs({ Enum.VibrationMotor.Large, Enum.VibrationMotor.Small }) do
				pcall(function()
					if HapticService:IsMotorSupported(inputType, motor) then
						HapticService:SetMotor(inputType, motor, strength)
					end
				end)
			end
		end
	end
end

