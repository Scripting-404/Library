	local keyPath = cfg.Folder .. "/" .. tagName .. "_key.txt"
	local statsPath = cfg.Folder .. "/" .. tagName .. "_stats.json"
	local stats = { valid = 0, expired = 0, last = 0 }
	do
		local raw = readFileSafe(statsPath)
		local data = raw and decodeJson(raw)
		if data then
			stats.valid = tonumber(data.valid) or 0
			stats.expired = tonumber(data.expired) or 0
			stats.last = tonumber(data.last) or 0
		end
	end
	local function saveStats()
		local ok, enc = pcall(HttpService.JSONEncode, HttpService, stats)
		if ok then
			writeFileSafe(cfg.Folder, statsPath, enc)
		end
	end
