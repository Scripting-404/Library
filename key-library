		destroy()
	end

	return api
end

function KeySystem.Authenticate(options)
	local opts = {}
	for k, v in pairs(options or {}) do
		opts[k] = v
	end
	local ui = KeySystem.new(opts)
	while ui.Key == nil and not ui.Closed do
		task.wait(0.1)
	end
	return ui.Key
end

return KeySystem
