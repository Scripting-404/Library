		local function showUpdate(e, token, showHeader, depth)
			local ver = pick(e, "Version", "version")
			if showHeader and ver ~= nil then
				bodyHeader(vlabel(ver), pick(e, "Date", "date"), pick(e, "Title", "title", "Name", "name"))
			end
			local inline = pick(e, table.unpack(UPDATE_KEYS))
			if inline ~= nil then
				bodyCard(toLines(inline))
				return
			end
			local url = pick(e, "Url", "url")
			if url and depth < 1 then
				local txt = bodyCard("Loading...", SECONDARY)
				fetchInto(tostring(url), token, function(body)
					if not body then
						txt.Text = "Couldn't load update."
						txt.TextColor3 = ERROR
						return
					end
					local data = decodeJson(body)
					if data and #data == 0 then
						txt.Parent:Destroy()
						showUpdate(data, token, showHeader and ver == nil, depth + 1)
					else
						txt.Text = clean(body)
						txt.TextColor3 = ACCENT
					end
				end)
			else
				bodyText("No details.", 13, SECONDARY)
			end
		end

		local function renderEntries(entries)
			return function(token)
				if #entries == 0 then
					bodyText("No updates yet.", 13, SECONDARY)
					return
				end
				for i, e in ipairs(entries) do
					local ver = pick(e, "Version", "version")
					local date = pick(e, "Date", "date")
					local title = pick(e, "Title", "title", "Name", "name")
					local sub = {}
					if date ~= nil then
						sub[#sub + 1] = tostring(date)
					end
					if title ~= nil then
						sub[#sub + 1] = tostring(title)
					end
					local head = ver ~= nil and vlabel(ver) or ("Update " .. i)
					bodyEntry(head, #sub > 0 and table.concat(sub, "  •  ") or "Tap to view", (i == 1 and #entries > 1) and "LATEST" or nil, function()
						tabPush(head, function(tk)
							showUpdate(e, tk, true, 0)
						end)
					end)
				end
			end
		end

		local function renderRemote(url)
			return function(token)
				local loading = bodyText("Loading changelog...", 13, SECONDARY)
				fetchInto(url, token, function(body)
					loading:Destroy()
					if not body then
						bodyText("Couldn't load changelog.", 13, ERROR)
						return
					end
					local data = decodeJson(body)
					if not data then
						showUpdate({ Text = body }, token, false, 1)
						return
					end
					local list = nil
					if #data > 0 and type(data[1]) == "table" then
						list = data
					else
						local nested = pick(data, "Entries", "entries", "Updates", "updates")
						if type(nested) == "table" and type(nested[1]) == "table" then
							list = nested
						end
					end
					if list then
						renderEntries(list)(token)
					else
						showUpdate(data, token, true, 0)
					end
				end)
			end
		end

		openChangelog = function()
