local function readFileSafe(path)
	if not (isfile and readfile) then
		return nil
	end
	local ok, res = pcall(function()
		if isfile(path) then
			return readfile(path)
		end
	end)
	if ok and type(res) == "string" then
		return res
	end
	return nil
end

local function writeFileSafe(folder, path, data)
	if not writefile then
		return
	end
	pcall(function()
		if folder and folder ~= "" and makefolder and isfolder and not isfolder(folder) then
			makefolder(folder)
		end
		writefile(path, data)
	end)
end

