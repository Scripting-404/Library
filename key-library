	-- Nama executor dan statistik layar
	local execName = "Unknown"
	pcall(function()
		if identifyexecutor then
			execName = tostring((identifyexecutor()))
		end
	end)

	local dtSmooth = 1 / 60
	local frameCount = 0
	local startClock = os.clock()
	stepConn = RunService.RenderStepped:Connect(function(dt)
		dtSmooth = dtSmooth * 0.92 + dt * 0.08
		fx.update(dt, speedVal.Value)
		frameCount += 1
		if frameCount % 2 == 0 then
			edge.update(os.clock() - startClock, edgeVal.Value, minDim)
		end
		if spinning then
			verifyBtn.Rotation = 0
		end
		if statusKind == "loading" then
			statusIcon.Rotation = (statusIcon.Rotation + dt * 360) % 360
		else
			statusIcon.Rotation = 0
		end
	end)

	task.spawn(function()
		while running do
			local ping = 0
			pcall(function()
				ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			local fps = math.floor(1 / math.max(dtSmooth, 0.001))
