    local registry = {}

    local function collect(root)
        local list = {}
        local function add(inst)
            local props = {}
            if inst:IsA("GuiObject") then
                props.BackgroundTransparency = inst.BackgroundTransparency
            end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                props.TextTransparency = inst.TextTransparency
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                props.ImageTransparency = inst.ImageTransparency
            end
            if inst:IsA("UIStroke") then
                props.Transparency = inst.Transparency
            end
            if next(props) then
                list[#list + 1] = {inst = inst, props = props}
            end
        end
        add(root)
        for _, d in ipairs(root:GetDescendants()) do
            add(d)
        end
        return list
    end

    local function hideGroup(root, offset)
        local list = collect(root)
        for _, item in ipairs(list) do
            for key in pairs(item.props) do
                item.inst[key] = 1
            end
        end
        local finalPos = root.Position
        if offset then
            root.Position = finalPos + offset
        end
        root.Visible = false
        registry[root] = {list = list, finalPos = finalPos}
    end

    local function showGroup(root, time)
        local entry = registry[root]
        if not entry then
            return
        end
        root.Visible = true
        for _, item in ipairs(entry.list) do
            tween(item.inst, time, item.props, Ease.Sine)
        end
        tween(root, time + 0.2, {Position = entry.finalPos}, Ease.Quint)
    end

