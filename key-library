	function attempt(rawKey, isSaved)
		if not ready or busy or finished then
			return
		end
		local key = trim(rawKey)
		if key == "" then
			setStatus("Enter your key first", "error")
			return
		end
		if #key > 128 then
			setStatus("That key looks too long", "error")
			return
		end
		busy = true
		checking = true
		verifyProgress = true
		setStatus("Verifying key...", "loading")
		verify.label.Text = "Checking"
		tween(U.fill, 3.2, { Size = UDim2.fromScale(0.88, 1) }, Enum.EasingStyle.Quad)
		task.spawn(function()
			local n = 0
			while checking do
				n = n % 3 + 1
				verify.label.Text = "Checking" .. string.rep(".", n)
				task.wait(0.3)
			end
		end)
		task.spawn(function()
			local started = os.clock()
			local ok, valid, reason = pcall(validateKey, key)
			local remain = (isSaved and 0.15 or 1) - (os.clock() - started)
			if remain > 0 then
				task.wait(remain)
			end
			if ok and valid == true then
				checking = false
				verifyProgress = false
				onSuccess(key)
			else
				checking = false
				verifyProgress = false
				if ok and reason and tostring(reason):lower():find("expir") then
					stats.expired += 1
					saveStats()
				end
				local msg
				if not ok then
					msg = "Something went wrong, try again."
				else
					msg = reason and tostring(reason):sub(1, 80) or "Invalid or expired key"
				end
				onFail(msg)
			end
		end)
	end

	function onFail(msg)
		busy = false
		verify.label.Text = "Verify"
		verify.icon.Rotation = 0
		U.percent.Text = ""
		tween(U.fill, 0.4, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad)
		setStatus(msg, "error")
		if U.inputStroke then
			tween(U.inputStroke, 0.2, { Color = ERROR, Transparency = 0 }, Enum.EasingStyle.Sine)
			task.delay(1.4, function()
				if U.inputStroke.Parent then
					tween(U.inputStroke, 0.4, { Color = SECONDARY, Transparency = 0.4 }, Enum.EasingStyle.Sine)
				end
			end)
		end
	end

	function onSuccess(key)
		finished = true
		api.Key = key
		stats.valid += 1
		stats.last = os.time()
		saveStats()
		if cfg.SaveKey then
			writeFileSafe(cfg.Folder, keyPath, key)
		end
		verify.label.Text = "Verified"
		tween(verify.button, 0.3, { BackgroundColor3 = SUCCESS }, Enum.EasingStyle.Sine)
