end

-- Menunggu sampai key valid, lalu mengembalikan key tersebut.
-- Berguna kalau script utama mau berhenti di sini sampai key benar.
function KeySystem.Authenticate(options)
	local opts = {}
	for k, v in pairs(options or {}) do
		opts[k] = v
	end
	local ui = KeySystem.new(opts)
	while ui.Key == nil and not ui.Closed do
		task.wait(0.1)
	end
	return ui.Key
end

return KeySystem
