	end
	state.alive = false
	for _, cell in ipairs(state.cells) do
		local pos = cell.label.Position
		tweenAfter(cell.label, math.random() * 0.2, 0.5, {
			Position = UDim2.fromScale(pos.X.Scale + math.random(150, 300) / 100, pos.Y.Scale + math.random(-20, 20) / 100),
