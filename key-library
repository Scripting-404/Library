		tween(Blur, 0.85, { Size = 0 }, Enum.EasingStyle.Linear)
		task.wait(0.85)
		tween(Sweep, 0.25, { Position = UDim2.fromOffset(W + glowW, 0) }, Enum.EasingStyle.Linear)
		task.wait(0.3)
	end

