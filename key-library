local function snapshot(root)
	local list = {}
	local function add(inst)
		local props = {}
		if inst:IsA("GuiObject") then
			props.BackgroundTransparency = inst.BackgroundTransparency
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			props.TextTransparency = inst.TextTransparency
		end
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			props.ImageTransparency = inst.ImageTransparency
		end
		if inst:IsA("UIStroke") then
			props.Transparency = inst.Transparency
		end
		if next(props) then
			list[#list + 1] = { inst = inst, props = props }
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do
		add(d)
	end
	return list
end

local function apply(list, visible, time, style)
	for _, it in ipairs(list) do
		local goal = {}
		for prop, orig in pairs(it.props) do
			goal[prop] = 1 - (1 - orig) * visible
		end
		if time and time > 0 then
			tween(it.inst, time, goal, style or Enum.EasingStyle.Sine)
		else
			for prop, v in pairs(goal) do
				it.inst[prop] = v
			end
		end
	end
end

local function httpRequestFn()
	return request or http_request or (syn and syn.request) or (http and http.request)
end

local function httpGet(url)
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(body) == "string" and body ~= "" then
		return body
	end
	return nil
end

local function loadLibrary(url)
	local src = httpGet(url)
	if not src then
		return nil, "couldn't download " .. url
	end
	if not loadstring then
		return nil, "loadstring is not available"
	end
	local fn, err = loadstring(src)
	if not fn then
		return nil, tostring(err)
	end
	local ok, lib = pcall(fn)
	if not ok then
		return nil, tostring(lib)
	end
	return lib
end

local function sendRequest(opts)
	local req = httpRequestFn()
	if not req then
		return nil, "your executor doesn't support HTTP requests."
	end
	local ok, res = pcall(req, opts)
	if not ok or type(res) ~= "table" then
		return nil, "network error, please try again."
	end
	return res
end

local function decodeJson(body)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, body or "")
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

