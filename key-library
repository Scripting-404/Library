    local function normalizeChangelog(list)
        local out = {}
        if type(list) ~= "table" then
            return out
        end
        if list[1] == nil then
            list = list.changelog or list.Changelog or list.entries or list.Entries or {}
        end
        for _, item in ipairs(list) do
            if type(item) == "table" then
                local changes = item.changes or item.Changes or item.notes or item.Notes or {}
                if type(changes) == "string" then
                    changes = { changes }
                end
                local lines = {}
                if type(changes) == "table" then
                    for _, line in ipairs(changes) do
                        lines[#lines + 1] = tostring(line)
                    end
                end
                out[#out + 1] = {
                    Version = tostring(item.version or item.Version or item.title or item.Title or "-"),
                    Date = tostring(item.date or item.Date or ""),
                    Changes = lines,
                }
            elseif type(item) == "string" then
                out[#out + 1] = { Version = item, Date = "", Changes = {} }
            end
        end
        return out
    end

