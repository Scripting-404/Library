	{ 0.90, Color3.fromRGB(190, 60, 210) },
	{ 1.00, Color3.fromRGB(255, 38, 52) },
}

local function edgeColor(p)
	p = p % 1
	for i = 2, #EDGE_STOPS do
		local a, b = EDGE_STOPS[i - 1], EDGE_STOPS[i]
		if p <= b[1] then
			return a[2]:Lerp(b[2], (p - a[1]) / (b[1] - a[1]))
		end
	end
	return EDGE_STOPS[1][2]
end

local function buildEdge(parent)
	local Edge = new("Frame", {
		Name = "Edge",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, parent)
	local segments = {}
	local GLOW = { { 0, 0 }, { 0.22, 0.05 }, { 0.45, 0.32 }, { 0.7, 0.72 }, { 1, 1 } }

	local function add(kind, index, count)
		local frac = (index - 0.5) / count
		local u, anchor
		if kind == "top" then
			u, anchor = frac * 0.25, Vector2.new(0, 0)
		elseif kind == "right" then
			u, anchor = 0.25 + frac * 0.25, Vector2.new(1, 0)
		elseif kind == "bottom" then
			u, anchor = 0.5 + (1 - frac) * 0.25, Vector2.new(0, 1)
		else
			u, anchor = 0.75 + (1 - frac) * 0.25, Vector2.new(0, 0)
		end
		local horizontal = kind == "top" or kind == "bottom"
		local fadeIn = kind == "top" or kind == "left"
		local frame = new("Frame", {
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.fromRGB(226, 30, 34),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, 0),
			ZIndex = 3,
		}, Edge)
		local keys = {}
		if fadeIn then
			for _, g in ipairs(GLOW) do
				keys[#keys + 1] = NumberSequenceKeypoint.new(g[1], g[2])
			end
		else
			for i = #GLOW, 1, -1 do
				keys[#keys + 1] = NumberSequenceKeypoint.new(1 - GLOW[i][1], GLOW[i][2])
			end
		end
		new("UIGradient", {
			Rotation = horizontal and 90 or 0,
			Transparency = NumberSequence.new(keys),
		}, frame)
		segments[#segments + 1] = {
			frame = frame,
			u = u,
			kind = kind,
			index = index,
			count = count,
			horizontal = horizontal,
			len = 0,
		}
	end

	for i = 1, 80 do
		add("top", i, 80)
		add("bottom", i, 80)
	end
	for j = 1, 44 do
		add("right", j, 44)
		add("left", j, 44)
	end

	local function layout(w, h)
		for _, s in ipairs(segments) do
			local length = s.horizontal and w or h
			local p0 = math.floor((s.index - 1) * length / s.count + 0.5)
			local p1 = math.floor(s.index * length / s.count + 0.5)
			s.len = p1 - p0
			if s.kind == "top" then
				s.frame.Position = UDim2.fromOffset(p0, 0)
			elseif s.kind == "bottom" then
				s.frame.Position = UDim2.new(0, p0, 1, 0)
			elseif s.kind == "left" then
				s.frame.Position = UDim2.fromOffset(0, p0)
			else
				s.frame.Position = UDim2.new(1, 0, 0, p0)
			end
		end
	end

	local function update(t, strength, minDim)
		local base = minDim * 0.11 * strength * (0.9 + 0.1 * math.sin(t * 0.8))
		local ws, cs, cycles = 1.0, 0.10, 2
		for _, s in ipairs(segments) do
			local phase = s.u * math.pi * 2
			local wave = 0.5 + 0.5 * math.sin(phase * 2 - t * 1.2 * ws)
			local wave2 = 0.5 + 0.5 * math.sin(phase * 3 + t * 1.9 * ws)
			local th = base * (0.4 + 1.0 * wave + 0.5 * wave2)
			if s.horizontal then
				s.frame.Size = UDim2.fromOffset(s.len, th)
			else
				s.frame.Size = UDim2.fromOffset(th, s.len)
			end
			local hue = s.u * cycles - t * cs
			s.frame.BackgroundColor3 = edgeColor(hue):Lerp(edgeColor(hue + 0.16), wave)
		end
	end

	return { layout = layout, update = update }
end

