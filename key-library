    -- Same shape as PandAuth's validate: { success, isPremium, message }
    local function checkKeyWith(key)
        if KS_TYPE == "panda" then
            return PUSL.validate(key)
        end
        local ok, valid, reason = pcall(Remote.CheckKey, Remote, key)
        if not ok then
            return { success = false, message = tostring(valid) }
        end
        if valid == true then
            return { success = true, isPremium = false }
        end
        return { success = false, message = type(reason) == "string" and reason or nil }
    end

    local function hasGetKey()
        if Config.GetKeyEnabled == false then
            return false
        end
        if KS_TYPE == "panda" or KS_TYPE == "jnkie" then
            return true
        end
        if KeyCfg.URL ~= "" then
            return true
        end
        return KS_TYPE == "custom" and type(KeyCfg.Custom.GetKeyLink) == "function"
    end

    -- Returns link, or nil + reason
    local function fetchKeyLink()
        if KS_TYPE == "panda" then
            if not waitForLibrary() then
                return nil, "Key service unavailable"
            end
            local okUrl, url = pcall(function()
                return PUSL.getKeyUrl()
            end)
            if okUrl and type(url) == "string" and url ~= "" then
                return url
            end
            return nil, "Key link unavailable"
        end
        local link, why
        if Remote and Remote.GetKeyLink then
            local ok, a, b = pcall(Remote.GetKeyLink, Remote)
            if ok then
                link, why = a, b
            else
                why = tostring(a)
            end
        end
        if type(link) == "string" and link ~= "" then
            return link
        end
        if type(KeyCfg.URL) == "string" and KeyCfg.URL ~= "" then
            return KeyCfg.URL
        end
        return nil, tostring(why or "Key link unavailable")
    end

