local function applyIcon(label, name)
	local ok, icon = pcall(IconLib.GetIcon, name)
	if not ok or not icon then
		return
	end
	if type(icon) == "table" then
		label.Image = icon.Image or icon[1] or label.Image
		local size = icon.ImageRectSize or icon[2]
		if size then
			label.ImageRectSize = size
		end
		local pos = icon.ImageRectPosition or icon[3]
		if pos then
			label.ImageRectPosition = pos
		end
	else
		label.Image = icon
	end
end

local function ensureIcons()
	if IconLib or iconLoading then
		return
	end
	iconLoading = true
	task.spawn(function()
		local src = httpGet(ICONS_URL)
		local fn = src and loadstring and loadstring(src)
		local ok, lib = false, nil
		if fn then
			ok, lib = pcall(fn)
		end
		if ok and type(lib) == "table" then
			IconLib = lib
			pcall(function()
				lib.SetIconsType("lucide")
			end)
			for label, name in pairs(pendingIcons) do
				if label.Parent then
					applyIcon(label, name)
				end
			end
			pendingIcons = {}
		end
	end)
end

local function iconSet(label, name)
	if not name then
		return
	end
	if IconLib then
		applyIcon(label, name)
	else
		pendingIcons[label] = name
	end
	ensureIcons()
end

local EDGE_STOPS = {
	{ 0.00, Color3.fromRGB(255, 38, 52) },
	{ 0.14, Color3.fromRGB(255, 60, 120) },
	{ 0.28, Color3.fromRGB(236, 80, 206) },
	{ 0.42, Color3.fromRGB(150, 84, 240) },
	{ 0.56, Color3.fromRGB(64, 120, 255) },
	{ 0.68, Color3.fromRGB(48, 196, 255) },
	{ 0.80, Color3.fromRGB(86, 110, 255) },
	{ 0.90, Color3.fromRGB(190, 60, 210) },
	{ 1.00, Color3.fromRGB(255, 38, 52) },
}

local function edgeColor(p)
	p = p % 1
	for i = 2, #EDGE_STOPS do
		local a, b = EDGE_STOPS[i - 1], EDGE_STOPS[i]
		if p <= b[1] then
			return a[2]:Lerp(b[2], (p - a[1]) / (b[1] - a[1]))
		end
	end
	return EDGE_STOPS[1][2]
end

local function buildEdge(parent)
	local Edge = new("Frame", {
		Name = "Edge",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, parent)
	local segments = {}
	local GLOW = { { 0, 0 }, { 0.22, 0.05 }, { 0.45, 0.32 }, { 0.7, 0.72 }, { 1, 1 } }

	local function add(kind, index, count)
		local frac = (index - 0.5) / count
		local u, anchor
		if kind == "top" then
			u, anchor = frac * 0.25, Vector2.new(0, 0)
		elseif kind == "right" then
			u, anchor = 0.25 + frac * 0.25, Vector2.new(1, 0)
		elseif kind == "bottom" then
			u, anchor = 0.5 + (1 - frac) * 0.25, Vector2.new(0, 1)
		else
			u, anchor = 0.75 + (1 - frac) * 0.25, Vector2.new(0, 0)
		end
		local horizontal = kind == "top" or kind == "bottom"
		local fadeIn = kind == "top" or kind == "left"
		local frame = new("Frame", {
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.fromRGB(226, 30, 34),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, 0),
			ZIndex = 3,
		}, Edge)
		local keys = {}
		if fadeIn then
			for _, g in ipairs(GLOW) do
				keys[#keys + 1] = NumberSequenceKeypoint.new(g[1], g[2])
			end
		else
			for i = #GLOW, 1, -1 do
				keys[#keys + 1] = NumberSequenceKeypoint.new(1 - GLOW[i][1], GLOW[i][2])
			end
		end
		new("UIGradient", {
			Rotation = horizontal and 90 or 0,
			Transparency = NumberSequence.new(keys),
		}, frame)
		segments[#segments + 1] = {
			frame = frame,
			u = u,
			kind = kind,
			index = index,
			count = count,
			horizontal = horizontal,
			len = 0,
		}
	end

	for i = 1, 80 do
		add("top", i, 80)
		add("bottom", i, 80)
	end
	for j = 1, 44 do
		add("right", j, 44)
		add("left", j, 44)
	end

	local function layout(w, h)
		for _, s in ipairs(segments) do
			local length = s.horizontal and w or h
			local p0 = math.floor((s.index - 1) * length / s.count + 0.5)
			local p1 = math.floor(s.index * length / s.count + 0.5)
			s.len = p1 - p0
			if s.kind == "top" then
				s.frame.Position = UDim2.fromOffset(p0, 0)
			elseif s.kind == "bottom" then
				s.frame.Position = UDim2.new(0, p0, 1, 0)
			elseif s.kind == "left" then
				s.frame.Position = UDim2.fromOffset(0, p0)
			else
				s.frame.Position = UDim2.new(1, 0, 0, p0)
			end
		end
	end

	local function update(t, strength, minDim)
		local base = minDim * 0.11 * strength * (0.9 + 0.1 * math.sin(t * 0.8))
		local ws, cs, cycles = 1.0, 0.10, 2
		for _, s in ipairs(segments) do
			local phase = s.u * math.pi * 2
			local wave = 0.5 + 0.5 * math.sin(phase * 2 - t * 1.2 * ws)
			local wave2 = 0.5 + 0.5 * math.sin(phase * 3 + t * 1.9 * ws)
			local th = base * (0.4 + 1.0 * wave + 0.5 * wave2)
			if s.horizontal then
				s.frame.Size = UDim2.fromOffset(s.len, th)
			else
				s.frame.Size = UDim2.fromOffset(th, s.len)
			end
			local hue = s.u * cycles - t * cs
			s.frame.BackgroundColor3 = edgeColor(hue):Lerp(edgeColor(hue + 0.16), wave)
		end
	end

	return { layout = layout, update = update }
end

local function buildFx(parent, accent, secondary)
	local Fx = new("Frame", {
		Name = "Fx",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 2,
	}, parent)

	local lines = {}
	for i = 1, 30 do
		local len = math.random(14, 42) / 100
		local thick = math.random(1, 2)
		local frame = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(len, 0, 0, thick),
			BackgroundColor3 = (i % 3 == 0) and accent or secondary,
			BackgroundTransparency = math.random(25, 65) / 100,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, Fx)
		new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}, frame)
		lines[i] = {
			frame = frame,
			len = len,
			thick = thick,
			x = math.random() * 1.4 - 0.2,
			y = math.random(),
			speed = math.random(60, 160) / 100,
		}
	end

	local rain = {}
	for i = 1, 14 do
		local buf = {}
		for j = 1, 26 do
			buf[j] = CHARS[math.random(1, #CHARS)]
		end
		local label = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(14, 312),
			BackgroundTransparency = 1,
			Text = table.concat(buf, "\n"),
			Font = Enum.Font.Code,
			TextSize = 12,
			TextColor3 = secondary,
			TextTransparency = 0.8,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 2,
		}, Fx)
		rain[i] = {
			label = label,
			x = (i - 0.5) / 14 + (math.random() - 0.5) * 0.03,
			y = -math.random() * 1.2,
			speed = math.random(15, 40) / 100,
		}
	end

	local function update(dt, boost)
		for _, l in ipairs(lines) do
			l.x = l.x + l.speed * boost * dt
			local width = l.len * (0.55 + boost * 0.12)
			if l.x > 1 then
				l.x = -width
				l.y = math.random()
			end
			l.frame.Size = UDim2.new(width, 0, 0, l.thick)
			l.frame.Position = UDim2.fromScale(l.x, l.y)
		end
		for _, r in ipairs(rain) do
			r.y = r.y + r.speed * dt * (0.6 + boost * 0.25)
			if r.y > 1 then
				r.y = -1.2
			end
			r.label.Position = UDim2.fromScale(r.x, r.y)
		end
	end

	return { update = update }
end

local Remote = { started = false, done = false, messages = nil, logo = nil }

local LOGO_CONTEXT = {
	new = new,
	tween = tween,
	tweenAfter = tweenAfter,
	loopTween = loopTween,
	GRID = GRID,
	CENTER = CENTER,
	GRID_R = GRID_R,
	STROKE = STROKE,
	CHARS = CHARS,
}

local function firstOf(tbl, names)
	for _, name in ipairs(names) do
		if tbl[name] ~= nil then
			return tbl[name]
		end
	end
	return nil
end

local function extractMessages(data)
	local list = {}
	if type(data) ~= "table" then
		return list
	end
	local source = data
	if data[1] == nil then
		source = firstOf(data, { "Messages", "messages", "Phrases", "phrases", "Greetings", "greetings", "Texts", "texts" }) or data
	end
	local function add(v)
		if type(v) == "table" then
			v = firstOf(v, { "Text", "text", "Message", "message", "Phrase", "phrase" })
		end
		if type(v) == "string" and trim(v) ~= "" then
			list[#list + 1] = v
		end
	end
	if type(source) == "table" then
		if source[1] ~= nil then
			for _, v in ipairs(source) do
				add(v)
			end
		else
			for _, v in pairs(source) do
				add(v)
			end
		end
	end
	return list
end

local function fetchMessages()
	local body = httpGet(MESSAGE_URL)
	local list = extractMessages(body and decodeJson(body))
	if #list == 0 then
		return nil
	end
	return list
end

local function fetchLogo()
	local lib = loadLibrary(LOGO_URL)
	if type(lib) == "function" then
		local ok, res = pcall(lib, LOGO_CONTEXT)
		lib = ok and res or nil
	end
	if type(lib) == "function" then
		lib = { Build = lib }
	end
	if type(lib) ~= "table" then
		return nil
	end
	local build = firstOf(lib, { "Build", "build", "BuildLogo", "buildLogo", "Create", "create", "Play", "play" })
	if type(build) ~= "function" then
		return nil
	end
	local names = {}
	local listed = firstOf(lib, { "Names", "names", "ShapeNames", "SHAPE_NAMES", "Order", "order" })
	if type(listed) == "table" then
		for _, n in ipairs(listed) do
			if type(n) == "string" then
				names[#names + 1] = n
			end
		end
	end
	if #names == 0 then
		local shapes = firstOf(lib, { "Shapes", "shapes" })
		if type(shapes) == "table" then
			for key, value in pairs(shapes) do
				if type(key) == "string" then
					names[#names + 1] = key
				elseif type(value) == "string" then
					names[#names + 1] = value
				end
			end
			table.sort(names)
		end
	end
	return {
		build = build,
		dissolve = firstOf(lib, { "Dissolve", "dissolve", "DissolveLogo", "dissolveLogo", "Destroy", "destroy", "Remove", "remove" }),
		names = names,
	}
end

local function prefetchRemote()
	if Remote.started and (not Remote.done or (Remote.messages and Remote.logo)) then
		return
	end
	Remote.started = true
	Remote.done = false
	local pending = 2
	local function settle()
		pending -= 1
		if pending <= 0 then
			Remote.done = true
		end
	end
	task.spawn(function()
		local ok, res = pcall(fetchMessages)
		Remote.messages = ok and res or nil
		settle()
	end)
	task.spawn(function()
		local ok, res = pcall(fetchLogo)
		Remote.logo = ok and res or nil
		settle()
	end)
end

local function awaitRemote(timeout)
	local started = os.clock()
	while not Remote.done and os.clock() - started < timeout do
		task.wait(0.05)
	end
end

local function buildLogo(holder, shapeName, accent, secondary, textSize)
	local logo = Remote.logo
	if not logo then
		return nil
	end
	local ok, state = pcall(logo.build, holder, shapeName, accent, secondary, textSize)
	if not ok then
		warn("[KeySystem] Logo build failed: " .. tostring(state))
		return nil
	end
	return state
end

local function dissolveLogo(state)
	local logo = Remote.logo
	if not state or not logo or not logo.dissolve then
		return
	end
	pcall(logo.dissolve, state)
end

