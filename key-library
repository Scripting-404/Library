			U.analysis.Text = tint("EXEC " .. escapeRich(execName:upper():sub(1, 14)), Color3.fromRGB(120, 190, 255))
				.. sep .. tint("FPS " .. fps, scaleFps(fps))
				.. sep .. tint("PING " .. ping .. "ms", scalePing(ping))
			task.wait(0.5)
		end
	end)

	local frameCount = 0
	local startClock = os.clock()
	local lastPct = -1
	local stepConn = RunService.RenderStepped:Connect(function(dt)
		dtSmooth = dtSmooth * 0.92 + dt * 0.08
		fx.update(dt, speedVal.Value)
		frameCount += 1
		if frameCount % 10 == 0 then
			applyLayout()
		end
		if frameCount % 2 == 0 then
			edge.update(os.clock() - startClock, edgeVal.Value, minDim)
		end
		if checking then
			verify.icon.Rotation = (verify.icon.Rotation + dt * 420) % 360
		else
			verify.icon.Rotation = 0
		end
		if statusKind == "loading" then
			U.statusIcon.Rotation = (U.statusIcon.Rotation + dt * 360) % 360
		else
			U.statusIcon.Rotation = 0
		end
		if introActive then
			local ip = math.clamp(math.floor(introBar.fill.Size.X.Scale * 100 + 0.5), 0, 100)
			if ip ~= lastIntroPct then
				lastIntroPct = ip
				introBar.percent.Text = ip .. "%"
				local step = INTRO_STEPS[1][2]
				for _, st in ipairs(INTRO_STEPS) do
					if ip >= st[1] then
						step = st[2]
					end
				end
				if step ~= lastIntroStep then
					lastIntroStep = step
					task.spawn(scrambleText, introBar.label, step, 0.3)
				end
			end
		end
		local pct = math.clamp(math.floor(U.fill.Size.X.Scale * 100 + 0.5), 0, 100)
		if pct ~= lastPct then
			lastPct = pct
			if verifyProgress then
				U.percent.Text = pct .. "%"
			end
		end
	end)

