local IconLib = nil
local pendingIcons = {}
local iconLoading = false

local function applyIcon(label, name)
	local ok, icon = pcall(IconLib.GetIcon, name)
	if not ok or not icon then
		return
	end
	if type(icon) == "table" then
		label.Image = icon.Image or icon[1] or label.Image
		local size = icon.ImageRectSize or icon[2]
		if size then
			label.ImageRectSize = size
		end
		local pos = icon.ImageRectPosition or icon[3]
		if pos then
			label.ImageRectPosition = pos
		end
	else
		label.Image = icon
	end
end

local function ensureIcons()
	if IconLib or iconLoading then
		return
	end
	iconLoading = true
	task.spawn(function()
		local src = httpGet(ICONS_URL)
		local fn = src and loadstring and loadstring(src)
		local ok, lib = false, nil
		if fn then
			ok, lib = pcall(fn)
		end
		if ok and type(lib) == "table" then
			IconLib = lib
			pcall(function()
				lib.SetIconsType("lucide")
			end)
			for label, name in pairs(pendingIcons) do
				if label.Parent then
					applyIcon(label, name)
				end
			end
			pendingIcons = {}
		end
	end)
end

local function iconSet(label, name)
	if not name then
		return
	end
	if IconLib then
		applyIcon(label, name)
	else
		pendingIcons[label] = name
	end
	ensureIcons()
end

-- ============================================================
-- Geometri logo kode (grid kecil berisi karakter)
-- ============================================================

local function hyp(a, b)
	return math.sqrt(a * a + b * b)
end

local function segDist(u, v, x1, y1, x2, y2)
	local dx, dy = x2 - x1, y2 - y1
	local t = math.clamp(((u - x1) * dx + (v - y1) * dy) / (dx * dx + dy * dy), 0, 1)
	return hyp(u - (x1 + t * dx), v - (y1 + t * dy))
end

local function polyDist(u, v, pts)
	local m = math.huge
	for i = 1, #pts do
		local a, b = pts[i], pts[i % #pts + 1]
		local d = segDist(u, v, a[1], a[2], b[1], b[2])
		if d < m then
			m = d
		end
	end
	return m
end

local function isIn(u, v, pts)
	local result = false
	local j = #pts
	for i = 1, #pts do
		local xi, yi, xj, yj = pts[i][1], pts[i][2], pts[j][1], pts[j][2]
		if (yi > v) ~= (yj > v) and u < (xj - xi) * (v - yi) / (yj - yi) + xi then
			result = not result
		end
		j = i
	end
	return result
end

local function rbox(u, v, cx, cy, hx, hy, r)
	local qx = math.abs(u - cx) - (hx - r)
	local qy = math.abs(v - cy) - (hy - r)
	return hyp(math.max(qx, 0), math.max(qy, 0)) + math.min(math.max(qx, qy), 0) - r
end

local function ell(u, v, ang, a, b)
	local ca, sa = math.cos(ang), math.sin(ang)
	local x = u * ca + v * sa
	local y = -u * sa + v * ca
	return (x / a) ^ 2 + (y / b) ^ 2
end

local HEX = { { 0, -0.86 }, { 0.745, -0.43 }, { 0.745, 0.43 }, { 0, 0.86 }, { -0.745, 0.43 }, { -0.745, -0.43 } }
local BOLT = { { 0.18, -0.92 }, { -0.52, 0.08 }, { -0.06, 0.08 }, { -0.2, 0.92 }, { 0.52, -0.16 }, { 0.06, -0.16 } }
local SHIELD = { { 0, -0.88 }, { 0.74, -0.62 }, { 0.74, 0.06 }, { 0.46, 0.52 }, { 0, 0.9 }, { -0.46, 0.52 }, { -0.74, 0.06 }, { -0.74, -0.62 } }

-- Setiap bentuk mengembalikan 0 (kosong), 1 (penuh), atau 2 (setengah kepadatan)
local Shapes = {
	cyber = function(u, v)
		if polyDist(u, v, HEX) <= STROKE then
			return 1
		end
		local d = math.abs(u) + math.abs(v)
		if d <= 0.36 or math.abs(d - 0.52) <= 0.04 then
			return 1
		end
		return 0
	end,
	code = function(u, v)
		local w = 0.07
		if segDist(u, v, -0.30, -0.56, -0.84, 0) <= w or segDist(u, v, -0.84, 0, -0.30, 0.56) <= w then
			return 1
		end
		if segDist(u, v, 0.30, -0.56, 0.84, 0) <= w or segDist(u, v, 0.84, 0, 0.30, 0.56) <= w then
			return 1
		end
		if segDist(u, v, 0.16, -0.66, -0.16, 0.66) <= w then
			return 1
		end
		return 0
	end,
	shield = function(u, v)
		if polyDist(u, v, SHIELD) <= STROKE then
			return 1
		end
		if segDist(u, v, -0.30, 0, -0.08, 0.24) <= 0.07 or segDist(u, v, -0.08, 0.24, 0.32, -0.22) <= 0.07 then
			return 1
		end
		return 0
	end,
	lock = function(u, v)
		local sd = rbox(u, v, 0, 0.3, 0.56, 0.46, 0.1)
		if sd <= 0 then
			if hyp(u, v - 0.24) <= 0.1 or (math.abs(u) <= 0.04 and v >= 0.24 and v <= 0.5) then
				return 0
			end
			return (sd < -STROKE) and 2 or 1
		end
		if v <= -0.1 and math.abs(hyp(u, v + 0.1) - 0.34) <= 0.065 then
			return 1
		end
		return 0
	end,
	bolt = function(u, v)
		return isIn(u, v, BOLT) and 1 or 0
	end,
	gear = function(u, v)
		local r = hyp(u, v)
		if math.abs(r - 0.52) <= 0.09 or math.abs(r - 0.2) <= 0.07 then
			return 1
		end
		if r >= 0.58 and r <= 0.86 and math.cos(8 * math.atan2(v, u)) > 0.25 then
			return 1
		end
		return 0
	end,
	key = function(u, v)
		if math.abs(hyp(u + 0.42, v + 0.36) - 0.3) <= 0.07 then
			return 1
		end
		if segDist(u, v, -0.2, -0.14, 0.74, 0.8) <= 0.065 then
			return 1
		end
		if segDist(u, v, 0.5, 0.56, 0.66, 0.4) <= 0.06 or segDist(u, v, 0.34, 0.4, 0.5, 0.24) <= 0.06 then
			return 1
		end
		return 0
	end,
	atom = function(u, v)
		if hyp(u, v) <= 0.13 then
			return 1
		end
		for _, ang in ipairs({ 0, math.pi / 3, 2 * math.pi / 3 }) do
			if math.abs(ell(u, v, ang, 0.88, 0.32) - 1) <= 0.2 then
				return 1
			end
		end
		return 0
	end,
	core = function(u, v)
		if math.abs(rbox(u, v, 0, 0, 0.52, 0.52, 0.08)) <= STROKE then
			return 1
		end
		if math.max(math.abs(u), math.abs(v)) <= 0.26 then
			return 1
		end
		for _, k in ipairs({ -0.3, 0, 0.3 }) do
			if math.abs(u - k) <= 0.04 and math.abs(v) > 0.5 and math.abs(v) <= 0.86 then
				return 1
			end
			if math.abs(v - k) <= 0.04 and math.abs(u) > 0.5 and math.abs(u) <= 0.86 then
				return 1
			end
		end
		return 0
	end,
}

-- Palet tepi layar (loop tertutup, merah > pink > ungu > biru > cyan > merah)
local EDGE_STOPS = {
	{ 0.00, Color3.fromRGB(255, 38, 52) },
	{ 0.14, Color3.fromRGB(255, 60, 120) },
	{ 0.28, Color3.fromRGB(236, 80, 206) },
	{ 0.42, Color3.fromRGB(150, 84, 240) },
	{ 0.56, Color3.fromRGB(64, 120, 255) },
	{ 0.68, Color3.fromRGB(48, 196, 255) },
	{ 0.80, Color3.fromRGB(86, 110, 255) },
	{ 0.90, Color3.fromRGB(190, 60, 210) },
	{ 1.00, Color3.fromRGB(255, 38, 52) },
}

local function edgeColor(p)
	p = p % 1
	for i = 2, #EDGE_STOPS do
		local a, b = EDGE_STOPS[i - 1], EDGE_STOPS[i]
		if p <= b[1] then
			return a[2]:Lerp(b[2], (p - a[1]) / (b[1] - a[1]))
		end
	end
	return EDGE_STOPS[1][2]
end

local function buildEdge(parent)
	local Edge = new("Frame", {
		Name = "Edge",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, parent)
	local segments = {}
	local GLOW = { { 0, 0 }, { 0.22, 0.05 }, { 0.45, 0.32 }, { 0.7, 0.72 }, { 1, 1 } }

	local function add(kind, index, count)
		local frac = (index - 0.5) / count
		local u, anchor
		if kind == "top" then
			u, anchor = frac * 0.25, Vector2.new(0, 0)
		elseif kind == "right" then
			u, anchor = 0.25 + frac * 0.25, Vector2.new(1, 0)
		elseif kind == "bottom" then
			u, anchor = 0.5 + (1 - frac) * 0.25, Vector2.new(0, 1)
		else
			u, anchor = 0.75 + (1 - frac) * 0.25, Vector2.new(0, 0)
		end
		local horizontal = kind == "top" or kind == "bottom"
		local fadeIn = kind == "top" or kind == "left"
		local frame = new("Frame", {
			AnchorPoint = anchor,
			BackgroundColor3 = Color3.fromRGB(226, 30, 34),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, 0),
			ZIndex = 3,
		}, Edge)
		local keys = {}
		if fadeIn then
			for _, g in ipairs(GLOW) do
				keys[#keys + 1] = NumberSequenceKeypoint.new(g[1], g[2])
			end
		else
			for i = #GLOW, 1, -1 do
				keys[#keys + 1] = NumberSequenceKeypoint.new(1 - GLOW[i][1], GLOW[i][2])
			end
		end
		new("UIGradient", {
			Rotation = horizontal and 90 or 0,
			Transparency = NumberSequence.new(keys),
		}, frame)
		segments[#segments + 1] = {
			frame = frame,
			u = u,
			kind = kind,
			index = index,
			count = count,
			horizontal = horizontal,
			len = 0,
		}
	end

	for i = 1, 80 do
		add("top", i, 80)
		add("bottom", i, 80)
	end
	for j = 1, 44 do
		add("right", j, 44)
		add("left", j, 44)
	end

	local function layout(w, h)
		for _, s in ipairs(segments) do
			local length = s.horizontal and w or h
			local p0 = math.floor((s.index - 1) * length / s.count + 0.5)
			local p1 = math.floor(s.index * length / s.count + 0.5)
			s.len = p1 - p0
			if s.kind == "top" then
				s.frame.Position = UDim2.fromOffset(p0, 0)
			elseif s.kind == "bottom" then
				s.frame.Position = UDim2.new(0, p0, 1, 0)
			elseif s.kind == "left" then
				s.frame.Position = UDim2.fromOffset(0, p0)
			else
				s.frame.Position = UDim2.new(1, 0, 0, p0)
			end
		end
	end

	local function update(t, strength, minDim)
		local base = minDim * 0.11 * strength
		for _, s in ipairs(segments) do
			local phase = s.u * math.pi * 2
			local wave = 0.5 + 0.5 * math.sin(phase * 2 - t * 1.2)
			local wave2 = 0.5 + 0.5 * math.sin(phase * 3 + t * 1.9)
			local th = base * (0.4 + wave + 0.5 * wave2) * (0.9 + 0.1 * math.sin(t * 0.8))
			if s.horizontal then
				s.frame.Size = UDim2.fromOffset(s.len, th)
			else
				s.frame.Size = UDim2.fromOffset(th, s.len)
			end
			local hue = s.u * 2 - t * 0.1
			s.frame.BackgroundColor3 = edgeColor(hue):Lerp(edgeColor(hue + 0.16), wave)
		end
	end

	return { layout = layout, update = update }
end

local function buildFx(parent, accent, secondary)
	local Fx = new("Frame", {
		Name = "Fx",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 2,
	}, parent)

	local lines = {}
	for i = 1, 30 do
		local len = math.random(14, 42) / 100
		local thick = math.random(1, 2)
		local frame = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(len, 0, 0, thick),
			BackgroundColor3 = (i % 3 == 0) and accent or secondary,
			BackgroundTransparency = math.random(25, 65) / 100,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, Fx)
		new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}, frame)
		lines[i] = {
			frame = frame,
			len = len,
			thick = thick,
			x = math.random() * 1.4 - 0.2,
			y = math.random(),
			speed = math.random(60, 160) / 100,
		}
	end

	local rain = {}
	for i = 1, 14 do
		local buf = {}
		for j = 1, 26 do
			buf[j] = CHARS[math.random(1, #CHARS)]
		end
		local label = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(14, 312),
			BackgroundTransparency = 1,
			Text = table.concat(buf, "\n"),
			Font = Enum.Font.Code,
			TextSize = 12,
			TextColor3 = secondary,
			TextTransparency = 0.8,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 2,
		}, Fx)
		rain[i] = {
			label = label,
			x = (i - 0.5) / 14 + (math.random() - 0.5) * 0.03,
			y = -math.random() * 1.2,
			speed = math.random(15, 40) / 100,
		}
	end

	local function update(dt, boost)
		for _, l in ipairs(lines) do
			l.x = l.x + l.speed * boost * dt
			local width = l.len * (0.55 + boost * 0.12)
			if l.x > 1 then
				l.x = -width
				l.y = math.random()
			end
			l.frame.Size = UDim2.new(width, 0, 0, l.thick)
			l.frame.Position = UDim2.fromScale(l.x, l.y)
		end
		for _, r in ipairs(rain) do
			r.y = r.y + r.speed * dt * (0.6 + boost * 0.25)
			if r.y > 1 then
				r.y = -1.2
			end
			r.label.Position = UDim2.fromScale(r.x, r.y)
		end
	end

	return { update = update }
end

local function buildLogo(holder, shapeName, accent, secondary, textSize)
	local fn = Shapes[shapeName]
	local state = { alive = true, cells = {} }
	for y = 1, GRID do
		for x = 1, GRID do
			local cx, cy = x - CENTER, y - CENTER
			local fill = fn(cx / GRID_R, cy / GRID_R)
			if fill == 2 and (x + y) % 2 ~= 0 then
				fill = 0
			end
			if fill ~= 0 then
				local color = (math.random() < 0.6) and accent or secondary
				local label = new("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromScale(1 / GRID, 1 / GRID),
					Position = UDim2.fromScale(math.random(-250, -40) / 100, math.random(-40, 140) / 100),
					BackgroundTransparency = 1,
					Text = CHARS[math.random(1, #CHARS)],
					TextSize = textSize,
					Font = Enum.Font.Code,
					TextColor3 = color,
					TextTransparency = 1,
					ZIndex = 9,
				}, holder)
				state.cells[#state.cells + 1] = { label = label, color = color }
				local delay = ((x + y) / (GRID * 2)) * 0.5 + math.random() * 0.2
				tweenAfter(label, delay, 0.5, {
					Position = UDim2.fromScale((x - 0.5) / GRID, (y - 0.5) / GRID),
					TextTransparency = 0,
				}, Enum.EasingStyle.Quint)
			end
		end
	end

	-- Efek kilap acak pada karakter
	task.spawn(function()
		while state.alive and #state.cells > 0 do
			for _ = 1, 8 do
				local c = state.cells[math.random(1, #state.cells)]
				if c.label.Parent then
					c.label.Text = CHARS[math.random(1, #CHARS)]
					c.label.TextColor3 = Color3.new(1, 1, 1)
					tween(c.label, 0.35, { TextColor3 = c.color }, Enum.EasingStyle.Sine)
				end
			end
			task.wait(0.07)
		end
	end)

	return state
end

local function dissolveLogo(state)
	if not state then
		return
	end
	state.alive = false
	for _, cell in ipairs(state.cells) do
		local pos = cell.label.Position
		tweenAfter(cell.label, math.random() * 0.2, 0.5, {
			Position = UDim2.fromScale(pos.X.Scale + math.random(150, 300) / 100, pos.Y.Scale),
			TextTransparency = 1,
		}, Enum.EasingStyle.Quad)
	end
	task.delay(1, function()
		for _, cell in ipairs(state.cells) do
			if cell.label.Parent then
				cell.label:Destroy()
			end
		end
	end)
end

