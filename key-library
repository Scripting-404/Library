    local startClock = os.clock()
    local frameCount = 0
    local dtSmooth = 1 / 60
    local lastPercent = -1
    local statusIndex = 0

    local stepConn = RunService.RenderStepped:Connect(function(dt)
        dtSmooth = dtSmooth * 0.92 + dt * 0.08
        local boost = SpeedValue.Value
        for _, l in ipairs(lines) do
            l.x = l.x + l.speed * boost * dt
            local width = l.len * (0.55 + boost * 0.12)
            if l.x > 1 then
                l.x = -width
                l.y = math.random()
            end
            l.frame.Size = UDim2.new(width, 0, 0, l.px or l.thick)
            l.frame.Position = UDim2.fromScale(l.x, l.y)
        end
        for _, r in ipairs(rain) do
            r.y = r.y + r.speed * dt * (0.6 + boost * 0.25)
            if r.y > 1 then
                r.y = -1.2
            end
            r.label.Position = UDim2.fromScale(r.x, r.y)
        end

        RingGradient.Rotation = (RingGradient.Rotation + dt * 220) % 360

        if verifySpin then
            Verify.icon.Rotation = (Verify.icon.Rotation + dt * 420) % 360
        end
        if statusKind == "loading" then
            StatusIcon.Rotation = (StatusIcon.Rotation + dt * 360) % 360
        end

        local p = math.clamp(math.floor(Fill.Size.X.Scale * 100 + 0.5), 0, 100)
        if p ~= lastPercent then
            lastPercent = p
            if phase == "intro" then
                PercentLabel.Text = tostring(p) .. "%"
                local idx = math.clamp(math.floor(p / 20) + 1, 1, #StatusMessages)
                if idx ~= statusIndex then
                    statusIndex = idx
                    StatusLabel.Text = StatusMessages[idx]
                    setIcon(StatusIcon, StatusIcons[idx])
                end
            elseif verifyProgress then
                PercentLabel.Text = tostring(p) .. "%"
            end
        end

        frameCount = frameCount + 1
        if frameCount % 20 == 0 then
            applyLayout()
        end
        if frameCount % 2 == 0 then
            local t = os.clock() - startClock
            local strength = EdgeValue.Value
            local base = ViewMin * Config.EdgeThickness * strength
            local ws = Config.EdgeWaveSpeed
            local cs = Config.EdgeColorSpeed
            local cycles = Config.EdgeCycles
            local breathe = 0.9 + 0.1 * math.sin(t * 0.8)
            for _, s in ipairs(segments) do
                local phase = s.u * math.pi * 2
                local wave = 0.5 + 0.5 * math.sin(phase * 2 - t * 1.2 * ws)
                local wave2 = 0.5 + 0.5 * math.sin(phase * 3 + t * 1.9 * ws)
                local th = base * (0.4 + 1.0 * wave + 0.5 * wave2) * breathe
                if s.horizontal then
                    s.frame.Size = UDim2.fromOffset(s.len, th)
                else
                    s.frame.Size = UDim2.fromOffset(th, s.len)
                end
                local hue = s.u * cycles - t * cs
                s.frame.BackgroundColor3 = edgeColor(hue):Lerp(edgeColor(hue + 0.16), wave)
            end
        end
    end)

