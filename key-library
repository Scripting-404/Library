local function scrambleText(lbl, text, duration)
	local chars = {}
	for _, code in utf8.codes(text) do
		chars[#chars + 1] = utf8.char(code)
	end
	local n = #chars
	local steps = math.max(n * 2, 16)
	for i = 1, steps do
		local shown = math.floor(n * i / steps)
		local buf = {}
		for j = 1, n do
			if j <= shown or chars[j] == " " then
				buf[j] = chars[j]
			else
				buf[j] = SCRAMBLE_CHARS[math.random(1, #SCRAMBLE_CHARS)]
			end
		end
		lbl.Text = table.concat(buf)
		task.wait(duration / steps)
	end
	lbl.Text = text
end

local function scaleColor(value, stops)
	if value <= stops[1][1] then
		return stops[1][2]
	end
	for i = 2, #stops do
		local a, b = stops[i - 1], stops[i]
		if value <= b[1] then
			return a[2]:Lerp(b[2], (value - a[1]) / (b[1] - a[1]))
		end
	end
	return stops[#stops][2]
end

local function tint(text, color)
	return string.format(
		'<font color="#%02X%02X%02X">%s</font>',
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5),
		text
	)
end

local function escapeRich(text)
	return (text:gsub("[&<>\"']", {
		["&"] = "&amp;",
		["<"] = "&lt;",
		[">"] = "&gt;",
		['"'] = "&quot;",
		["'"] = "&apos;",
	}))
end

function KeySystem.new(userOptions)
	local cfg = {}
	for k, v in pairs(DEFAULTS) do
		cfg[k] = v
	end
	for k, v in pairs(userOptions or {}) do
		cfg[k] = v
	end

	local ACCENT = cfg.Accent
	local SECONDARY = cfg.Secondary
	local SUCCESS = cfg.Success
	local ERROR = cfg.Error
	local INPUT_BG = Color3.fromRGB(20, 21, 28)
	local BTN_BG = Color3.fromRGB(30, 32, 40)
	local BTN_HOVER = Color3.fromRGB(46, 49, 60)
	local SUBMIT_TEXT = Color3.fromRGB(14, 15, 20)
	local PLACEHOLDER = Color3.fromRGB(110, 115, 128)
	local TRACK_BG = Color3.fromRGB(44, 46, 54)
	local STATUS_COLORS = { info = SECONDARY, loading = ACCENT, success = SUCCESS, error = ERROR }
	local STATUS_ICONS = { info = "info", loading = "loader", success = "circle-check", error = "circle-x" }

	local ks = cfg.KeySystem or {}
	local keyList = ks.Key
	local services = buildServices(ks.API)
	if keyList == nil and #services == 0 then
		warn("[KeySystem] KeySystem.Key or KeySystem.API is not set")
	end

	local tagName = (tostring(cfg.Title):gsub("[^%w_]", "_"))
	local keyPath = cfg.Folder .. "/" .. tagName .. "_key.txt"
	local statsPath = cfg.Folder .. "/" .. tagName .. "_stats.json"
	local stats = { valid = 0, expired = 0, last = 0 }
	do
		local raw = readFileSafe(statsPath)
		local data = raw and decodeJson(raw)
		if data then
			stats.valid = tonumber(data.valid) or 0
			stats.expired = tonumber(data.expired) or 0
			stats.last = tonumber(data.last) or 0
		end
	end
	local function saveStats()
		local ok, enc = pcall(HttpService.JSONEncode, HttpService, stats)
		if ok then
			writeFileSafe(cfg.Folder, statsPath, enc)
		end
	end
	local savedKey = cfg.SaveKey and readFileSafe(keyPath)
	if savedKey then
		savedKey = trim(savedKey)
		if savedKey == "" then
			savedKey = nil
		end
	end
	local rejectedReason = nil

	local function validateKey(key)
		local reason = nil
		if keyList ~= nil then
			if type(keyList) == "function" then
				local ok, valid, why = pcall(keyList, key)
				if ok and valid == true then
					return true
				end
				if ok then
					reason = why
				end
			elseif type(keyList) == "table" then
				for _, k in ipairs(keyList) do
					if tostring(k) == key then
						return true
					end
				end
			elseif tostring(keyList) == key then
				return true
			end
		end
		for _, svc in ipairs(services) do
			local ok, valid, why = pcall(svc.CheckKey, key)
			if ok and valid == true then
				return true
			end
			if ok then
				reason = why
			else
				reason = tostring(valid)
			end
		end
		return false, reason
	end

	local function normalizeUrl(u)
		u = trim(u)
		if u:match("^https?://") then
			return u
		end
		return "https://" .. u
	end

	local lastLinkErr = nil
	local function getLinkAsync()
		if ks.URL and trim(ks.URL) ~= "" then
			return trim(ks.URL)
		end
		for _, svc in ipairs(services) do
			if svc.GetKeyLink then
				local ok, link, err = pcall(svc.GetKeyLink)
				if ok and link then
					return tostring(link)
				end
				lastLinkErr = ok and tostring(err or "") or tostring(link)
			end
		end
		if cfg.Website and trim(cfg.Website) ~= "" then
			return normalizeUrl(cfg.Website)
		end
		return nil, lastLinkErr
	end

	if savedKey then
		local ok, valid, reason = pcall(validateKey, savedKey)
		if ok and valid == true then
			stats.valid += 1
			stats.last = os.time()
			saveStats()
			local key = savedKey
			local silent = { Gui = nil, Closed = true, Key = key, Silent = true }
			function silent:Destroy() end
			local cb = cfg.Callback
			if type(cb) == "function" then
				task.spawn(function()
					local cbOk, err = pcall(cb, key)
					if not cbOk then
						warn("[KeySystem] Callback error: " .. tostring(err))
					end
				end)
			end
			return silent
		end
		if ok and reason then
			rejectedReason = trim(reason)
		end
		savedKey = nil
	end

	if cfg.Intro then
		prefetchRemote()
	end

	local host = resolveHost()
	for _, child in ipairs(host:GetChildren()) do
		if child.Name == "KeySystemGui" then
			child:Destroy()
		end
	end

	local Gui = new("ScreenGui", {
		Name = "KeySystemGui",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 999999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, nil)
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(Gui)
		end
	end)
	pcall(function()
		Gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	Gui.Parent = host

	local function viewport()
		return Gui.AbsoluteSize
	end

	local Blur = new("BlurEffect", { Name = "KeySystemBlur", Size = 0 }, Lighting)
	tween(Blur, 0.9, { Size = cfg.BlurSize }, Enum.EasingStyle.Sine)

	local Dim = new("Frame", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = cfg.Backdrop,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, Gui)
	tween(Dim, 0.8, { BackgroundTransparency = cfg.BackdropTransparency }, Enum.EasingStyle.Sine)

	local Blocker = new("TextButton", {
		Name = "Blocker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		ZIndex = 1,
	}, Gui)
	pcall(function()
		Blocker.Modal = true
	end)
	local SINK = "KeySystemInputSink"
	pcall(function()
		ContextActionService:BindActionAtPriority(SINK, function()
			return Enum.ContextActionResult.Sink
		end, false, 3000,
			Enum.UserInputType.Touch,
			Enum.UserInputType.MouseButton1,
			Enum.UserInputType.MouseButton2,
			Enum.UserInputType.MouseButton3,
			Enum.UserInputType.MouseWheel)
	end)

	local edge = buildEdge(Gui)
	local fx = buildFx(Gui, ACCENT, SECONDARY)
	local edgeVal = Instance.new("NumberValue")
	edgeVal.Value = 0
	tween(edgeVal, 1.6, { Value = 1 }, Enum.EasingStyle.Sine)
	local speedVal = Instance.new("NumberValue")
	speedVal.Value = 8
	local speedTween = tween(speedVal, 1.6, { Value = 1.6 }, Enum.EasingStyle.Quad)
	local function setSpeed(to, time)
		if speedTween then
			speedTween:Cancel()
		end
		speedTween = tween(speedVal, time, { Value = to }, Enum.EasingStyle.Quad)
	end

	local BASE_SCALE = 1
	local minDim = 720
	local exiting = false
	local Content = new("Frame", {
		Name = "Content",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		BackgroundTransparency = 1,
		ZIndex = 5,
	}, Gui)
	local ContentScale = new("UIScale", { Scale = 1 }, Content)

	local tagScale
	do
		local HUB_SHAPES = {
			circle = "circle", lingkaran = "circle",
			square = "square", persegi = "square", kotak = "square",
			rounded = "rounded", round = "rounded",
