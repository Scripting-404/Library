		local a = math.rad(-14)
		local ru = u * math.cos(a) - v * math.sin(a)
		local rv = u * math.sin(a) + v * math.cos(a)
		local m = math.max(math.abs(ru), math.abs(rv))
		return (m <= 0.78 and m > 0.36) and 2 or 0
	end,
