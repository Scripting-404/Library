                local valid, reason = custom.CheckKey(key, customCtx())
                return valid == true, reason
            end,
            GetKeyLink = function()
                if type(custom.GetKeyLink) == "function" then
                    return custom.GetKeyLink(customCtx())
                end
                return nil
            end,
        }
    elseif KS_TYPE == "keys" then
        local list = KeyCfg.Keys or {}
        Remote = {
            CheckKey = function(_, key)
                for _, k in ipairs(list) do
                    if tostring(k) == key then
                        return true
                    end
                end
                return false, "key is invalid."
            end,
            GetKeyLink = function()
