    -- Adapts the whole UI to the screen size / DPI. Runs whenever the size changes (rotation, resize, etc).
    local function applyLayout()
        local size = viewport()
        if size.X == lastW and size.Y == lastH then
            return
        end
        lastW, lastH = size.X, size.Y
        ViewMin = math.min(size.X, size.Y)
        BaseScale = math.clamp(
            math.min(size.X * 0.94 / Config.DesignWidth, size.Y * 0.86 / Config.DesignHeight),
            Config.MinScale,
            Config.MaxScale
        )
        if not exiting then
            ContentScale.Scale = BaseScale
        end
        local k = math.clamp(ViewMin / 450, 0.75, 2.6)
        TagScale.Scale = k
        applyFxScale(k)
        layoutSegments(size.X, size.Y)
    end
