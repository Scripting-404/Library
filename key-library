	local logoState = nil
	if cfg.Intro then
		task.spawn(function()
			task.wait(0.3)
			awaitRemote(8)
			order = shuffled(Remote.logo and Remote.logo.names or {})
			local i = 0
			while running do
				i += 1
				if logoState then
					dissolveLogo(logoState)
					logoState = nil
					task.wait(0.15)
				end
				local shape = #order > 0 and order[((i - 1) % #order) + 1] or nil
				logoState = buildLogo(LogoHolder, shape, ACCENT, SECONDARY, logoTextSize)
				local hour = tonumber(os.date("%H")) or 12
				local pool = {}
				for _, p in ipairs(Remote.messages or FALLBACK_MESSAGES) do
					pool[#pool + 1] = p
				end
				pool[#pool + 1] = hour < 12 and "Good morning, {name}" or (hour < 18 and "Good afternoon, {name}" or "Good evening, {name}")
				task.spawn(scrambleText, U.greet, expandName(pool[math.random(1, #pool)]), 0.6)
				task.wait(FORM_TIME)
				scanLine(LogoHolder, ACCENT)
				flash(Gui, ACCENT, 0.86)
				if i == 1 then
					task.spawn(revealProfile)
					startIntroBar()
					task.delay(INTRO_TOTAL - 0.3, revealKey)
				end
				task.wait(phase == "intro" and HOLD_TIME or 2.6)
			end
		end)
	else
