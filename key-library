	function shutdown(success, afterFn)
		if destroyed then
			return
		end
		exiting = true
		running = false
		setSpeed(success and 9 or 5, 1.0)
		flash(Gui, ACCENT, success and 0.8 or 0.92)
		apply(profileItems, 0, 0.5)
		apply(keyItems, 0, 0.5)
		tween(ContentScale, 0.7, { Scale = BASE_SCALE * (success and 1.12 or 0.92) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(edgeVal, 0.8, { Value = 0 }, Enum.EasingStyle.Sine)
		task.wait(0.4)
		tween(Dim, 0.7, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
		tween(Blur, 0.7, { Size = 0 }, Enum.EasingStyle.Sine)
		task.wait(0.9)
		destroy()
		if afterFn then
			afterFn()
		end
	end

