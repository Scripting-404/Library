			if type(cl) == "string" then
				cl = { Url = cl }
			end
			if type(cl) ~= "table" then
				return
			end
			local list = nil
			if #cl > 0 then
				list = cl
			else
				local nested = pick(cl, "Entries", "entries", "Updates", "updates")
				if type(nested) == "table" and type(nested[1]) == "table" then
					list = nested
				end
			end
			local url = pick(cl, "Url", "url")
			if list then
				tabPush("Changelog", renderEntries(list))
			elseif url and pick(cl, table.unpack(UPDATE_KEYS)) == nil then
				tabPush("Changelog", renderRemote(tostring(url)))
			else
				tabPush("Changelog", function(token)
					showUpdate(cl, token, true, 0)
				end)
			end
		end
