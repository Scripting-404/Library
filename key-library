    local function attempt(rawKey)
        if phase ~= "key" or busy or outcome ~= nil then
            return
        end
        local key = cleanKey(rawKey)
        if key == "" then
            setStatus("Enter your key first", "error")
            return
        end
        if #key > 128 then
            setStatus("That key looks too long", "error")
            return
        end
        busy = true
        checking = true
        verifySpin = true
        verifyProgress = true
        setStatus("Verifying key...", "loading")
        setIcon(Verify.icon, "loader")
        Fill.Size = UDim2.fromScale(0, 1)
        tween(Fill, 3.2, {Size = UDim2.fromScale(0.88, 1)}, Ease.Quad, Dir.Out)
        task.spawn(function()
            local n = 0
            while checking do
                n = n % 3 + 1
                Verify.label.Text = "Checking" .. string.rep(".", n)
                task.wait(0.3)
            end
        end)
        task.spawn(function()
            local ready = waitForService()
            local ok, res = false, nil
            if ready then
                ok, res = pcall(checkKeyWith, key)
            end
            if ready and ok and type(res) == "table" and res.success then
                authResult = res
                authKey = key
                saveKey(key)
                print("[Panda] Authenticated. Premium:", res.isPremium)
                checking = false
                verifySpin = false
                Verify.icon.Rotation = 0
                setIcon(Verify.icon, "check-check")
                Verify.label.Text = "Verified"
                tween(Verify.button, 0.3, {BackgroundColor3 = Config.Success}, Ease.Sine)
                tween(Fill, 0.35, {Size = UDim2.fromScale(1, 1)}, Ease.Quad, Dir.Out)
                tween(InputStroke, 0.3, {Color = Config.Success, Transparency = 0}, Ease.Sine)
                setStatus("Access granted  |  " .. (res.isPremium and "Premium" or "Standard"), "success")
                flash(0.78)
                setSpeed(7, 1.6, 1.2)
                tween(EdgeValue, 0.5, {Value = 2.2}, Ease.Quad, Dir.Out)
                task.wait(1.1)
                outcome = "ok"
                return
            end
            local reason = "Invalid or expired key"
            if not ready then
                reason = "Key service unavailable"
            elseif ok and type(res) == "table" then
                local msg = res.message or res.error or res.reason
                if type(msg) == "string" and msg ~= "" then
                    reason = msg:sub(1, 60)
                end
            end
            if ready then
                local link = fetchKeyLink()
                if link then
                    warn("[KeySystem] Get a key: " .. link)
                end
            end
            checking = false
            verifyProgress = false
            setStatus(reason, "error")
            setVerifyIdle()
            tween(Fill, 0.3, {Size = UDim2.fromScale(0, 1)}, Ease.Quad, Dir.Out)
            PercentLabel.Text = ""
            InputStroke.Color = Config.Error
            InputStroke.Transparency = 0
            task.delay(1.4, function()
                tween(InputStroke, 0.4, {Color = Config.Secondary, Transparency = 0.4}, Ease.Sine)
            end)
            busy = false
        end)
    end

